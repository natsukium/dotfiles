#!/bin/sh
# shellcheck disable=SC2016
# Print the value of one header for each message matching a notmuch query,
# one line per message. notmuch indexes only a fixed set of headers, so
# List-Id, X-Mailer, X-GitHub-Reason and the like have to be read from the
# files themselves.
#
#   header-values <Header-Name> <notmuch query...>
set -eu

if [ "$#" -lt 2 ]; then
  echo "usage: header-values <Header-Name> <notmuch query...>" >&2
  exit 2
fi

header=$1
shift

# --duplicate=1: a Gmail message is stored once per label folder, and every
# copy would otherwise be counted.
notmuch search --output=files --duplicate=1 --format=text0 -- "$@" |
  xargs -0 awk -v want="$header" '
    FNR == 1 { inhdr = 1; cur = ""; done = 0 }
    !inhdr || done { nextfile }
    /^\r?$/ { if (cur != "") print cur; inhdr = 0; nextfile }
    /^[ \t]/ { if (cur != "") { sub(/^[ \t]+/, " "); cur = cur $0 }; next }
    {
      if (cur != "") { print cur; done = 1; nextfile }
      n = index($0, ":")
      if (n && tolower(substr($0, 1, n - 1)) == tolower(want)) {
        cur = substr($0, n + 1); sub(/^[ \t]+/, "", cur); sub(/\r$/, "", cur)
      }
    }
  '
