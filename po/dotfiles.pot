"  {\n"
"    service = \"http://${toString HTTP_ADDR}:${toString HTTP_PORT}\";\n"
"  };"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2863
#, no-wrap
msgid "<<forgejo-ssh-port>>"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2865
#, no-wrap
