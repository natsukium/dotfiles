"roster = ''\n"
"  roster() {\n"
"    felis sessions list --format json \\\n"
"          .sessions[]\n"
"              .id,\n"
"              ((.short_id + \"         \")[:9]\n"
"               + (((.cwd // \"\" | sub(\"^file://[^/]*\"; \"\"))\n"
"                     else sub(\"^/(Users|home)/[^/]+\"; \"~\")\n"
"                     end)\n"
"                  + \"               \")[:15]\n"
"               + ((.foreground // \"-\") + \"                \")[:16]\n"
