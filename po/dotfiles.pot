#. type: heading ****
#: modules/configuration.org:4695
#, no-wrap
msgid "Seed disc"
msgstr ""

#. type: paragraph
#: modules/configuration.org:4697
msgid ""
"Generates a root-only ISO containing the registration token on activation, "
"keeping credentials out of the Nix store and guest command history."
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:4700
#, no-wrap
msgid "forgejo-windows-seed"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:4702
#, no-wrap
msgid ""
"systemd.services.windows-ci-seed = {\n"
"  description = \"Hand the Forgejo registration token to the Windows CI "
"guest\";\n"
"  wantedBy = [ \"multi-user.target\" ];\n"
"  before = [\n"
"    \"libvirtd.service\"\n"
"    \"nixvirt.service\"\n"
"  ];\n"
"  after = [ \"windows-ci-images.service\" ];\n"
"  serviceConfig = {\n"
"    Type = \"oneshot\";\n"
"    RemainAfterExit = true;\n"
"  };\n"
"  path = [ pkgs.xorriso ];\n"
"  script = ''\n"
"    dir=$(mktemp -d)\n"
"    trap 'rm -rf \"$dir\"' EXIT"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:4719
#, no-wrap
msgid "sed -n 's/^TOKEN=//p' ${runner.tokenFile} > \"$dir/token.txt\""
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:4721
#, no-wrap
msgid ""
"    xorriso -as mkisofs -J -r -V WINCISEED -o ${seedIso}.new \"$dir\"\n"
"    chmod 0400 ${seedIso}.new\n"
"    mv ${seedIso}.new ${seedIso}\n"
"  '';\n"
"};"
msgstr ""

#. type: heading ****
#: modules/configuration.org:4728
#, no-wrap
msgid "Reset"
msgstr ""

#. type: paragraph
#: modules/configuration.org:4730
msgid ""
"A libvirt QEMU hook recreates the system overlay before the VM starts, "
"ensuring each run begins from a clean state. Guest-initiated reboots retain "
"the overlay; a domain stop and start via libvirt is required to reset it."
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:4734
#, no-wrap
msgid "forgejo-windows-reset"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:4736
#, no-wrap
msgid ""
"virtualisation.libvirtd.hooks.qemu.windows-ci =\n"
"  pkgs.writeShellScript \"windows-ci-reset-system-disk\" ''\n"
"    if [ \"$1\" != windows-ci ] || [ \"$2\" != prepare ] || [ \"$3\" != "
"begin ]; then\n"
"      exit 0\n"
"    fi"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:4742
#, no-wrap
msgid ""
"  rm -f ${systemImage}\n"
"  ${pkgs.qemu-utils}/bin/qemu-img create -f qcow2 -F qcow2 -b ${baseImage} "
"${systemImage}\n"
"'';"
msgstr ""

#. type: heading ****
#: modules/configuration.org:4747
#, no-wrap
msgid "Registering the runner"
msgstr ""

#. type: paragraph
#: modules/configuration.org:4749
msgid ""
"Initializes a new state disk by running =provision.ps1= to install "
"toolchains, followed by =register.ps1= to register the runner using the "
"token from the [[*Seed disc][seed disc]]."
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:4754
#, no-wrap
msgid ""
"$payload = (Get-Volume -FileSystemLabel WINVM).DriveLetter + \":\"\n"
"powershell -ExecutionPolicy Bypass -File \"$payload\\provision.ps1\""
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:4757
#, no-wrap
msgid ""
"$runner = (Get-Volume -FileSystemLabel WINRUN).DriveLetter + \":\"\n"
"powershell -ExecutionPolicy Bypass -File \"$runner\\register.ps1\""
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:4763
#, no-wrap
msgid ""
"<#\n"
"    Makes this guest the Forgejo Actions runner."
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:4766
#, no-wrap
msgid ""
"Run once from the runner disc:\n"
"  powershell -ExecutionPolicy Bypass -File X:\\register.ps1"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:4769
#, no-wrap
msgid ""
"    Everything it writes goes to D:, which outlives the reset of C: on "
"every\n"
"    start.\n"
"[CmdletBinding()]\n"
"param(\n"
"    [string]$RunnerToken,\n"
"    [string]$InstanceUrl = \"@instanceUrl@\",\n"
"    [string]$RunnerName = \"@runnerName@\",\n"
"    [string]$Labels = \"@labels@\"\n"
")"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:4800
#, no-wrap
msgid "$runner = (Get-Volume -FileSystemLabel WINRUN).DriveLetter + \":\""
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:4802
#, no-wrap
msgid ""
"if (-not (Test-Path \"D:\\\")) {\n"
"    throw \"D: is missing, so the runner would land on C: and die with the "
"next reset\"\n"
"}"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:4806
#, no-wrap
msgid ""
"Step \"Installing the startup script\"\n"
"New-Item -ItemType Directory -Force -Path \"D:\\runner\" | Out-Null\n"
"Copy-Item \"$runner\\bootstrap.ps1\" \"D:\\bootstrap.ps1\" -Force"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:4810
#, no-wrap
msgid ""
"if (-not $RunnerToken) {\n"
"    $seed = Get-Volume -FileSystemLabel WINCISEED -ErrorAction "
"SilentlyContinue\n"
"    if ($seed) {\n"
"        $RunnerToken = (Get-Content \"$($seed.DriveLetter):\\token.txt\" "
"-Raw).Trim()\n"
"    }\n"
"}"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:4817
#, no-wrap
msgid ""
"if (Test-Path \"D:\\runner\\.runner\") {\n"
"    Step \"The runner is already registered\"\n"
"}\n"
"elseif ($RunnerToken) {\n"
"    Step \"Registering the runner\"\n"
"    Copy-Item \"$runner\\forgejo-runner.exe\" "
"\"D:\\runner\\forgejo-runner.exe\" -Force\n"
"    Push-Location \"D:\\runner\"\n"
"    try {\n"
"        Invoke-Native \"D:\\runner\\forgejo-runner.exe\" @(\"register\", "
"\"--no-interactive\",\n"
"            \"--instance\", $InstanceUrl, \"--token\", $RunnerToken, "
"\"--name\", $RunnerName,\n"
"            \"--labels\", $Labels)\n"
"    }\n"
"    finally {\n"
"        Pop-Location\n"
"    }\n"
"}\n"
"else {\n"
"    throw \"no token given and no seed disc found, so there is nothing to "
"register with\"\n"
"}"
msgstr ""

#. type: paragraph
#: modules/configuration.org:4844
msgid ""
"Leaves =D:\\bootstrap.ps1=, which the logon task executes on each boot to "
"run the runner daemon."
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:4848
#, no-wrap
msgid ""
"<#\n"
"    Runs at every logon, from the copy register.ps1 left at "
"D:\\bootstrap.ps1.\n"
"$ErrorActionPreference = \"Stop\""
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:4853
#, no-wrap
msgid ""
"$runner = (Get-Volume -FileSystemLabel WINRUN).DriveLetter + \":\"\n"
"Copy-Item \"$runner\\forgejo-runner.exe\" \"D:\\runner\\forgejo-runner.exe\" "
"-Force"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:4856
#, no-wrap
msgid ""
"Set-Location \"D:\\runner\"\n"
"& \"D:\\runner\\forgejo-runner.exe\" daemon"
msgstr ""

#. type: heading *
#: modules/configuration.org:4860
#, no-wrap
msgid "Devices"
msgstr ""

#. type: paragraph
#: modules/configuration.org:4862
msgid ""
"Peripherals that move between machines belong here, not in "
"=hardware-configuration=, which describes a host's fixed internals. Each "
"device is a switch under =my.devices.*=, exposed through the "
"=flake.modules.nixos.devices= registry; a host enables only the ones it has "
"plugged in."
msgstr ""

#. type: heading **
#: modules/configuration.org:4868
#, no-wrap
msgid "Audio"
msgstr ""

#. type: heading ***
#: modules/configuration.org:4870
#, no-wrap
msgid "AT2040 microphone"
msgstr ""

#. type: paragraph
#: modules/configuration.org:4872
msgid ""
"The AT2040 is a USB microphone that also exposes a headphone "
"output. WirePlumber gives that output a higher default priority (1109) than "
"the HDMI sink (1000), so plugging the mic in silently hijacks the default "
"output. I demote the AT2040 sink to the lowest priority so the host's "
"existing output stays selected; the =media.class= guard holds back the sink "
"alone, leaving the mic input at its own high priority to still become the "
"default source."
msgstr ""

#. type: paragraph
#: modules/configuration.org:4879
msgid ""
"The rule matches on =alsa.card_name= rather than the serial-bearing "
"=node.name=, so it survives re-plugging and would apply to a replacement "
"unit."
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:4888
#, no-wrap
msgid ""
"{ ... }:\n"
"{\n"
"  flake.modules.nixos.devices =\n"
"    {\n"
"      config,\n"
"      lib,\n"
"      ...\n"
"    }:\n"
"    let\n"
"      cfg = config.my.devices;\n"
"    in\n"
"    {\n"
"      options.my.devices.audio.at2040.enable =\n"
"        lib.mkEnableOption \"AT2040 USB mic sink demotion so it does not "
"steal the default output\";"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:4904
#, no-wrap
msgid ""
"      config = lib.mkIf cfg.audio.at2040.enable {\n"
"        services.pipewire.wireplumber.extraConfig.\"51-at2040-demote-sink\" "
"= {\n"
"          \"monitor.alsa.rules\" = [\n"
"            {\n"
"              matches = [\n"
"                {\n"
"                  \"media.class\" = \"Audio/Sink\";\n"
"                  \"alsa.card_name\" = \"AT2040USB\";\n"
"                }\n"
"              ];\n"
"              actions.update-props = {\n"
"                \"priority.driver\" = 0;\n"
"                \"priority.session\" = 0;\n"
"              };\n"
"            }\n"
"          ];\n"
"        };\n"
"      };\n"
"    };\n"
"}"
msgstr ""

#. type: heading *
#: modules/configuration.org:4926
#, no-wrap
msgid "Authentication"
msgstr ""

#. type: heading **
#: modules/configuration.org:4928
#, no-wrap
msgid "Ente Auth"
msgstr ""

#. type: paragraph
#: modules/configuration.org:4930
msgid ""
"[[https://ente.io/auth/][Ente Auth]] holds my TOTP secrets and syncs them "
"with end-to-end encryption between Android and every machine here, so a lost "
"phone is an inconvenience rather than a lockout. Client and server are both "
"open source, so I can read what happens to the secrets and self-host the "
"backend later without re-enrolling anything."
msgstr ""

#. type: paragraph
#: modules/configuration.org:4936
msgid ""
"Before this I used Google Authenticator and then Microsoft Authenticator, "
"out of inertia more than choice. Neither could hand its secrets to a new "
"device at the time, so replacing a phone meant re-enrolling every account by "
"hand."
msgstr ""

#. type: paragraph
#: modules/configuration.org:4940
msgid ""
"A password manager would solve the sync problem too (Bitwarden sells TOTP on "
"a paid plan, and a self-hosted Vaultwarden gives it away), but I keep the "
"two apart deliberately. Storing the codes in the vault means anyone who gets "
"into the vault has already cleared the second factor, which leaves me with "
"one factor wearing two hats."
msgstr ""

#. type: paragraph
#: modules/configuration.org:4946
msgid ""
"nixpkgs builds =ente-auth= for Linux only. The app is written in Flutter, "
"and the Flutter tooling in nixpkgs can only produce Linux desktop bundles; a "
"macOS bundle requires Xcode, which a sandboxed Nix build cannot use. So "
"darwin installs the upstream cask through brew-nix instead."
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:4957
#, no-wrap
msgid ""
"{ ... }:\n"
"{\n"
"  flake.modules.homeManager.ente-auth =\n"
"    {\n"
"      config,\n"
"      lib,\n"
"      pkgs,\n"
"      ...\n"
"    }:\n"
"    let\n"
"      cfg = config.my.programs.ente-auth;\n"
"    in\n"
"    {\n"
"      options.my.programs.ente-auth = {\n"
"        enable = lib.mkEnableOption \"Ente Auth\";\n"
"        package = lib.mkOption {\n"
"          type = lib.types.package;\n"
"          default = if pkgs.stdenv.hostPlatform.isDarwin then "
"pkgs.brewCasks.ente-auth else pkgs.ente-auth;\n"
"          defaultText = lib.literalExpression \"pkgs.ente-auth\";\n"
"          description = \"The Ente Auth package to install.\";\n"
"        };\n"
"      };"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:4982
