"color = {\n"
"  status = \"auto\";\n"
"  diff = \"auto\";\n"
"  branch = \"auto\";\n"
"  interactive = \"auto\";\n"
"  grep = \"auto\";\n"
"};"
msgstr ""

#. type: heading ****
#: modules/configuration.org:1738
#, no-wrap
msgid "Default Branch"
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:1740
#, no-wrap
msgid "git-default-branch"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:1742
#, no-wrap
msgid "init.defaultBranch = \"main\";"
msgstr ""

#. type: heading ****
#: modules/configuration.org:1745
#, no-wrap
msgid "Force Push Safety"
msgstr ""

#. type: paragraph
#: modules/configuration.org:1747
msgid ""
"=push.useForceIfIncludes= enables a safety check for force pushes: git "
"verifies that the local branch includes the remote's current tip before "
"allowing a force push. This prevents accidentally overwriting commits pushed "
"by others since the last fetch, which =--force-with-lease= alone cannot "
"catch if the remote ref was updated in the background (e.g., by lazygit's "
"periodic fetch or a background =git fetch=)."
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:1753
#, no-wrap
msgid "git-push-safety"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:1755
#, no-wrap
msgid "push.useForceIfIncludes = true;"
msgstr ""

#. type: heading ***
#: modules/configuration.org:1758
#, no-wrap
msgid "Commit Signing"
msgstr ""

#. type: paragraph
#: modules/configuration.org:1760
msgid ""
"SSH-based commit signing. SSH keys were chosen over GPG because SSH keys are "
"already required for push authentication, eliminating the need to manage a "
"separate GPG keychain.  Git's SSH signing support (added in Git 2.34) "
"provides the same integrity guarantees as GPG signing with simpler key "
"management — one key pair for both authentication and signing."
msgstr ""

#. type: paragraph
#: modules/configuration.org:1765
msgid ""
"GitHub has "
"[[https://github.blog/changelog/2022-08-23-ssh-commit-verification-now-supported/][supported "
"SSH commit verification since August 2022]], and since "
"[[https://github.blog/changelog/2024-11-12-persistent-commit-signature-verification-now-in-public-preview/][November "
"2024]] verification results are persisted server-side. This persistent "
"verification eliminates the primary concern with SSH signing — that key "
"rotation could invalidate historical signatures — which was GPG's main "
"advantage for long-term identity assurance."
msgstr ""

#. type: paragraph
#: modules/configuration.org:1770
msgid ""
"In the future, migrating to a keyless solution like "
"[[https://github.com/sigstore/gitsign][gitsign]] (Sigstore-based signing)  "
"would further simplify the workflow by removing key management "
"entirely. This is pending GitHub's native support for Sigstore verification."
msgstr ""

#. type: paragraph
#: modules/configuration.org:1774
msgid ""
"=signByDefault = true= ensures all commits are signed without requiring =git "
"commit -S=, preventing unsigned commits from slipping through."
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:1777
#, no-wrap
msgid "git-signing"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:1779
#, no-wrap
msgid ""
"signing = {\n"
"  format = \"ssh\";\n"
"  key = \"~/.ssh/id_ed25519.pub\";\n"
"  signByDefault = true;\n"
"};"
msgstr ""

#. type: heading ***
#: modules/configuration.org:1786
#, no-wrap
msgid "Global Ignores"
msgstr ""

#. type: paragraph
#: modules/configuration.org:1788
msgid ""
"Patterns that should never be committed across all repositories. These are "
"global ignores rather than per-repo =.gitignore= entries because they "
"reflect personal tooling choices that should not be imposed on "
"collaborators."
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:1792
#, no-wrap
msgid "git-ignores"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:1794
#, no-wrap
msgid ""
"ignores = [\n"
"  <<git-ignores-os>>\n"
"  <<git-ignores-dev>>\n"
"  <<git-ignores-workflow>>\n"
"  <<git-ignores-private>>\n"
"];"
msgstr ""

