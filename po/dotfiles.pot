#. type: heading ***
#: modules/configuration.org:3980
#, no-wrap
msgid "Session and hint helpers"
msgstr ""

#. type: paragraph
#: modules/configuration.org:3982
msgid ""
"The keymap points at six shell programs, none touching the module system; "
"their =writeShellApplication= bodies would bury the configuration if they "
"sat in =default.nix=, so they live in a sibling =utilities.nix= handed the "
"felis client, spoor, and Neovim. Besides =felis-switch= and the two hints "
"above, it holds =felis-kill=, the multi-select cousin that tears sessions "
"down; =felis-grep=, a cross-session scrollback search the built-in "
"per-session facet can't do; and =felis-scrollback=, which opens the "
"scrollback =pipe= region read-only in Neovim so editor motions replace the "
"pager."
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3997
#, no-wrap
msgid ""
"{\n"
"  lib,\n"
"  pkgs,\n"
"  package,\n"
"  neovim,\n"
"  spoor,\n"
"}:\n"
"let\n"
"  opener = if pkgs.stdenv.hostPlatform.isDarwin then \"open\" else "
"\"xdg-open\";"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:4012
#, no-wrap
msgid ""
"felis-switch = pkgs.writeShellApplication {\n"
"  name = \"felis-switch\";\n"
"  runtimeInputs = [\n"
"    package\n"
"    pkgs.fzf\n"
"    pkgs.gawk\n"
"  ];\n"
"  text = ''\n"
"    list=$(felis sessions list)\n"
"    if [ -z \"$list\" ] || [ \"$list\" = \"no sessions\" ]; then\n"
"      echo \"no sessions\" >&2\n"
"      exit 0\n"
"    fi"
msgstr ""

#. type: cell column 0
#: modules/configuration.org:4030
#, no-wrap
msgid "awk -v self=\"''${FELIS_SESSION_ID:-}\" '$1 != self' \\"
msgstr ""

#. type: cell column 0
#: modules/configuration.org:4031 modules/configuration.org:4061
#, no-wrap
msgid "fzf --ansi \\"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:4028
#, no-wrap
msgid ""
"selection=$(\n"
"  printf '%s\\n' \"$list\" \\\n"
"          --with-nth=2.. \\\n"
"          --prompt='felis session> ' \\\n"
"          --preview='felis sessions capture {1} --ansi 2>/dev/null || echo "
"\"(attached — preview unavailable)\"'\n"
") || exit 0"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:4037
#, no-wrap
msgid ""
"    id=''${selection%% *}\n"
"    [ -n \"$id\" ] && felis sessions switch \"$id\"\n"
"  '';\n"
"};"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:4045
#, no-wrap
msgid ""
"felis-kill = pkgs.writeShellApplication {\n"
"  name = \"felis-kill\";\n"
"  runtimeInputs = [\n"
"    package\n"
"    pkgs.fzf\n"
"    pkgs.gawk\n"
"  ];\n"
"  text = ''\n"
"    list=$(felis sessions list)\n"
"    if [ -z \"$list\" ] || [ \"$list\" = \"no sessions\" ]; then\n"
"      echo \"no sessions\" >&2\n"
"      exit 0\n"
"    fi"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:4059
#, no-wrap
msgid ""
"selection=$(\n"
"  printf '%s\\n' \"$list\" \\\n"
"          --multi \\\n"
"          --with-nth=2.. \\\n"
"          --prompt='kill session(s)> ' \\\n"
"          --preview='felis sessions capture {1} --ansi 2>/dev/null || echo "
"\"(attached — preview unavailable)\"'\n"
") || exit 0"
msgstr ""

#. type: cell column 0
#: modules/configuration.org:4069 modules/configuration.org:4090
#, no-wrap
msgid "awk 'NF {print $1}' \\"
msgstr ""

#. type: cell column 0
#: modules/configuration.org:4070 modules/configuration.org:4091
#, no-wrap
msgid "while read -r id; do"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:4068
#, no-wrap
msgid ""
"    printf '%s\\n' \"$selection\" \\\n"
"          felis sessions kill \"$id\"\n"
"        done\n"
"  '';\n"
"};"
msgstr ""

#. type: cell column 0
#: modules/configuration.org:4093
#, no-wrap
msgid "awk -v id=\"$id\" 'NF {print id\"\\t\"$0}'"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:4080
#, no-wrap
msgid ""
"felis-grep = pkgs.writeShellApplication {\n"
"  name = \"felis-grep\";\n"
"  runtimeInputs = [\n"
"    package\n"
"    pkgs.fzf\n"
"    pkgs.gawk\n"
"  ];\n"
"  text = ''\n"
"    matches=$(\n"
"      felis sessions list \\\n"
"            felis sessions capture \"$id\" --scrollback 2>/dev/null \\\n"
"          done\n"
"    )\n"
"    if [ -z \"$matches\" ]; then\n"
"      echo \"no scrollback\" >&2\n"
"      exit 0\n"
"    fi"
msgstr ""

#. type: cell column 0
#: modules/configuration.org:4103
#, no-wrap
msgid "fzf --delimiter='\\t' --with-nth=2.. --prompt='grep scrollback> '"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:4101
#, no-wrap
msgid ""
"selection=$(\n"
"  printf '%s\\n' \"$matches\" \\\n"
") || exit 0"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:4106
#, no-wrap
msgid ""
"    id=$(printf '%s' \"$selection\" | awk -F'\\t' '{print $1; exit}')\n"
"    [ -n \"$id\" ] && felis sessions switch \"$id\"\n"
"  '';\n"
"};"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:4116
#, no-wrap
msgid ""
"felis-scrollback = pkgs.writeShellApplication {\n"
"  name = \"felis-scrollback\";\n"
"  runtimeInputs = [ neovim ];\n"
"  text = ''\n"
"    exec nvim -R \\\n"
"      -c 'setlocal noswapfile' \\\n"
"      -c 'normal! G' \\\n"
"      \"''${1:?no region file}\"\n"
"  '';\n"
"};"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:4142
#, no-wrap
msgid ""
"felis-hints = pkgs.writeShellApplication {\n"
"  name = \"felis-hints\";\n"
"  runtimeInputs = [\n"
"    spoor\n"
"  ]\n"
"  ++ lib.optional pkgs.stdenv.hostPlatform.isLinux pkgs.xdg-utils;\n"
"  text = ''\n"
"    picked=$(spoor \\\n"
"      --preset url \\\n"
"      --regex '[\\w.~/@+-]+\\.(?i:html?|pdf)\\b' \\\n"
"      \"''${1:?no region file}\") || exit 0\n"
"    [ -n \"$picked\" ] || exit 0\n"
"    case $picked in\n"
"      \"~/\"*) picked=$HOME/''${picked#\"~/\"} ;;\n"
"    esac\n"
"    exec ${opener} \"$picked\"\n"
"  '';\n"
"};"
msgstr ""

#. type: cell column 0
#: modules/configuration.org:4181
#, no-wrap
msgid "sed 's/^nix log //' \\"
msgstr ""

#. type: cell column 0
#: modules/configuration.org:4182
#, no-wrap
msgid "awk '!seen[$0]++'"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:4169
#, no-wrap
msgid ""
"  felis-nix-log = pkgs.writeShellApplication {\n"
"    name = \"felis-nix-log\";\n"
"    runtimeInputs = [\n"
"      pkgs.nix\n"
"      pkgs.fzf\n"
"      pkgs.gnused\n"
"      pkgs.gawk\n"
"      pkgs.less\n"
"    ];\n"
"    text = ''\n"
"      mapfile -t drvs < <(\n"
"        grep -oE 'nix log /nix/store/[a-z0-9]{32}-[^ ]+\\.drv' \"''${1:?no "
"region file}\" \\\n"
"      )\n"
"      case ''${#drvs[@]} in\n"
"        0) echo \"no 'nix log <drv>' on screen\" >&2; exit 0 ;;\n"
"        1) drv=''${drvs[0]} ;;\n"
"        *) drv=$(printf '%s\\n' \"''${drvs[@]}\" | fzf --prompt='nix log> ') "
"|| exit 0 ;;\n"
"      esac\n"
"      [ -n \"$drv\" ] && nix log \"$drv\" | less -R\n"
"    '';\n"
"  };\n"
"in\n"
"{\n"
"  inherit\n"
"    felis-switch\n"
"    felis-kill\n"
"    felis-grep\n"
"    felis-scrollback\n"
"    felis-hints\n"
"    felis-nix-log\n"
"    ;\n"
"}"
msgstr ""

#. type: heading **
#: modules/configuration.org:4207
#, no-wrap
msgid "Spotlight"
msgstr ""

#. type: paragraph
#: modules/configuration.org:4209
msgid ""
"I don't use Spotlight search, yet its indexer (=mdworker=) keeps consuming "
"CPU, disk I/O, and disk space in the background, so I turn indexing off by "
"default. Hosts that want it back can set =enableIndex = true=. nix-darwin "
"has no option for this, so the module drives =mdutil= from an activation "
"script."
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:4220
#, no-wrap
msgid ""
"{ ... }:\n"
"{\n"
"  flake.modules.darwin.spotlight =\n"
"    { config, lib, ... }:\n"
"    let\n"
"      cfg = config.my.services.spotlight;\n"
"    in\n"
"    {\n"
"      <<spotlight-options>>"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:4230
#, no-wrap
msgid ""
"      <<spotlight-config>>\n"
"    };\n"
"}"
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:4237
#, no-wrap
msgid "spotlight-options"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:4239
#, no-wrap
msgid ""
"options.my.services.spotlight = {\n"
"  enableIndex = lib.mkOption {\n"
"    type = lib.types.bool;\n"
"    default = false;\n"
"    description = \"Whether Spotlight indexes the volumes on this "
"machine.\";\n"
"  };\n"
"};"
msgstr ""

#. type: paragraph
#: modules/configuration.org:4250
msgid ""
"=mdutil= targets all volumes with =-a= rather than just =/=: modern macOS "
"splits the boot disk into a read-only System volume (=/=) and a writable "
"Data volume, so =mdutil -i off /= silently leaves the Data volume "
"indexing. When disabling, =mdutil -E= also erases the orphaned index stores "
"to reclaim disk space."
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:4255
#, no-wrap
msgid "spotlight-config"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:4257
#, no-wrap
msgid ""
"config = {\n"
"  system.activationScripts.extraActivation.text =\n"
"    if cfg.enableIndex then\n"
"      ''\n"
"        echo \"enabling spotlight indexing...\"\n"
"        mdutil -i on -a &> /dev/null\n"
"      ''\n"
"    else\n"
"      ''\n"
"        echo \"disabling spotlight indexing...\"\n"
"        mdutil -i off -d -a &> /dev/null\n"
"        mdutil -E -a &> /dev/null\n"
"      '';\n"
"};"
msgstr ""
