#. type: heading **
#: modules/configuration.org:505
#, no-wrap
msgid "Hydra"
msgstr ""

#. type: paragraph
#: modules/configuration.org:507
msgid ""
"Hydra's Rust queue runner requires a builder agent on each build machine.  "
"The feature wraps Hydra's upstream NixOS and nix-darwin modules. Host "
"configurations only assign runner and builder roles; the feature owns the "
"service wiring."
msgstr ""

#. type: paragraph
#: modules/configuration.org:511
msgid ""
"The upstream REST and gRPC ports, 8080 and 50051, are common "
"development-server choices. I use 24050 and 24051 instead; neither is used "
"elsewhere in this repository, and both sit outside the default ephemeral "
"ranges on Linux and macOS."
msgstr ""

#. type: paragraph
#: modules/configuration.org:515
msgid ""
"Each builder agent runs its builds through the local Nix daemon. On a host "
"that also sets =nix.buildMachines=, that daemon hands the step straight back "
"out over ssh. Hydra then credits the build to the machine that only relayed "
"it, and both agents go on counting the slot as free. The legacy queue runner "
"avoided this by passing =nix-store --serve --builders ''= for localhost "
"builds ([[https://github.com/NixOS/hydra/pull/749][NixOS/hydra#749]]). The "
"Rust rewrite dropped that guard, so I patch it back in.  Nix lets any client "
"clear =builders=, even an untrusted one, so the agent only has to send the "
"setting."
msgstr ""

#. type: paragraph
#: modules/configuration.org:524
msgid ""
"The patch goes on the workspace derivation, not on the source tree. Patching "
"the tree first would mean reading the workspace expression out of a built "
"copy, and that import from derivation fails under =nix flake check "
"--no-build=, which refuses to realise anything. Upstream's per-crate wrapper "
"copies its binary out of the unpatched workspace, so the feature lifts "
"=hydra-builder= out of the patched one itself."
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:537
#, no-wrap
msgid ""
"{ inputs, ... }:\n"
"let\n"
"  builderPackage =\n"
"    pkgs:\n"
"    let\n"
"      version = pkgs.lib.strings.trim (builtins.readFile "
"\"${inputs.hydra}/version.txt\");\n"
"      workspace = pkgs.callPackage "
"\"${inputs.hydra}/packaging/rust-workspace.nix\" {\n"
"        craneLib = inputs.hydra.inputs.crane.mkLib pkgs;\n"
"        inherit version;\n"
"      };\n"
"      patched = workspace.workspace.overrideAttrs (old: {\n"
"        patches = (old.patches or [ ]) ++ [ ./no-redistribute.patch ];\n"
"      });\n"
"    in\n"
"    pkgs.runCommand \"hydra-builder-${version}\" { meta.mainProgram = "
"\"hydra-builder\"; } ''\n"
"      mkdir -p \"$out/bin\"\n"
"      cp \"${patched}/bin/hydra-builder\" \"$out/bin/hydra-builder\"\n"
"    '';"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:558
#, no-wrap
msgid ""
"mkBuilderModule =\n"
"  upstreamModule:\n"
"  {\n"
"    config,\n"
"    lib,\n"
"    pkgs,\n"
"    ...\n"
"  }:\n"
"  let\n"
"    cfg = config.my.services.hydra;\n"
"  in\n"
"  {\n"
"    imports = [ upstreamModule ];"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:572
#, no-wrap
msgid ""
"options.my.services.hydra = {\n"
"  queueRunner = {\n"
"    enable = lib.mkEnableOption \"the Hydra queue runner service\";"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:576
#, no-wrap
msgid ""
"hostname = lib.mkOption {\n"
"  type = lib.types.str;\n"
"  default = \"kilimanjaro\";\n"
"  description = \"Hostname builder agents use to reach the Hydra queue "
"runner.\";\n"
"};"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:582
#, no-wrap
msgid ""
"restPort = lib.mkOption {\n"
"  type = lib.types.port;\n"
"  default = 24050;\n"
"  description = \"Port for the queue runner REST API.\";\n"
"};"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:588
#, no-wrap
msgid ""
"  grpcPort = lib.mkOption {\n"
"    type = lib.types.port;\n"
"    default = 24051;\n"
"    description = \"Port for queue runner connections from builder "
"agents.\";\n"
"  };\n"
"};"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:595
#, no-wrap
msgid ""
"builder = {\n"
"  enable = lib.mkEnableOption \"the Hydra builder agent\";"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:598
#, no-wrap
msgid ""
"queueRunnerAddress = lib.mkOption {\n"
"  type = lib.types.str;\n"
"  default = \"http://${\n"
"    if cfg.queueRunner.enable then \"localhost\" else "
"cfg.queueRunner.hostname\n"
"  }:${toString cfg.queueRunner.grpcPort}\";\n"
"  defaultText = lib.literalExpression ''\n"
"    \"http://''${\n"
"      if config.my.services.hydra.queueRunner.enable then\n"
"        \"localhost\"\n"
"      else\n"
"        config.my.services.hydra.queueRunner.hostname\n"
"    }:''${toString config.my.services.hydra.queueRunner.grpcPort}\"\n"
"  '';\n"
"  description = \"gRPC address of the Hydra queue runner.\";\n"
"};"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:614
#, no-wrap
msgid ""
"maxJobs = lib.mkOption {\n"
"  type = lib.types.ints.positive;\n"
"  default = if builtins.isInt config.nix.settings.max-jobs then "
"config.nix.settings.max-jobs else 4;\n"
"  defaultText = lib.literalExpression ''\n"
"    if builtins.isInt config.nix.settings.max-jobs then "
"config.nix.settings.max-jobs else 4\n"
"  '';\n"
"  description = \"Maximum concurrent jobs accepted by this builder.\";\n"
"};"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:623
#, no-wrap
msgid ""
"speedFactor = lib.mkOption {\n"
"  type = lib.types.oneOf [\n"
"    lib.types.ints.positive\n"
"    lib.types.float\n"
"  ];\n"
"  default = 1;\n"
"  description = \"Relative scheduling speed of this builder.\";\n"
"};"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:632
#, no-wrap
msgid ""
"systems = lib.mkOption {\n"
"  type = lib.types.nullOr (lib.types.listOf lib.types.str);\n"
"  default = null;\n"
"  description = \"Systems advertised by this builder, or null to read them "
"from Nix.\";\n"
"};"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:638
#, no-wrap
msgid ""
"supportedFeatures = lib.mkOption {\n"
"  type = lib.types.nullOr (lib.types.listOf lib.types.str);\n"
"  default = null;\n"
"  description = \"Features advertised by this builder, or null to read them "
"from Nix.\";\n"
"};"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:644
#, no-wrap
msgid ""
"    mandatoryFeatures = lib.mkOption {\n"
"      type = lib.types.listOf lib.types.str;\n"
"      default = [ ];\n"
"      description = \"Features required by every build assigned to this "
"builder.\";\n"
"    };\n"
"  };\n"
"};"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:652
#, no-wrap
msgid ""
"  config = lib.mkIf cfg.builder.enable {\n"
"    services.hydra-queue-builder-dev = {\n"
"      enable = true;\n"
"      package = builderPackage pkgs;\n"
"      queueRunnerAddr = cfg.builder.queueRunnerAddress;\n"
"      settings = {\n"
"        inherit (cfg.builder)\n"
"          mandatoryFeatures\n"
"          maxJobs\n"
"          speedFactor\n"
"          supportedFeatures\n"
"          systems\n"
"          ;\n"
"      };\n"
"    };\n"
"  };\n"
"};"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:670
#, no-wrap
msgid ""
"queueRunnerModule =\n"
"  { config, lib, ... }:\n"
"  let\n"
"    cfg = config.my.services.hydra.queueRunner;\n"
"  in\n"
"  {\n"
"    config = lib.mkIf cfg.enable {\n"
"      services.hydra-queue-runner-dev = {\n"
"        enable = true;\n"
"        grpc = {\n"
"          address = \"[::]\";\n"
"          port = cfg.grpcPort;\n"
"        };\n"
"        rest.port = cfg.restPort;\n"
"        settings = {\n"
"          machineFreeFn = \"DynamicWithMaxJobLimit\";\n"
"          useSubstitutes = true;\n"
"        };\n"
"      };"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:692
#, no-wrap
msgid ""
"        services.hydra-dev.extraConfig = ''\n"
"          queue_runner_endpoint = http://localhost:${toString "
"cfg.restPort}\n"
"        '';\n"
"      };\n"
"    };\n"
"in\n"
"{\n"
"  flake.modules.nixos.hydra.imports = [\n"
"    (mkBuilderModule inputs.hydra.nixosModules.hydra)\n"
"    queueRunnerModule\n"
"  ];\n"
"  flake.modules.darwin.hydra = mkBuilderModule "
"inputs.hydra.darwinModules.builder;\n"
"}"
msgstr ""

