msgstr ""

#. type: paragraph
#: modules/configuration.org:1320
msgid ""
"[[https://github.com/PatrickF1/fzf.fish][fzf-fish]] integrates fzf with "
"fish's tab completion, history search, and file/directory navigation. It "
"replaces fish's built-in history search (=Ctrl+R=) with fzf's fuzzy finder, "
"which handles large histories more effectively."
msgstr ""

#. type: heading ***
#: modules/configuration.org:1324
#, no-wrap
msgid "Launchctl Completion"
msgstr ""

#. type: paragraph
#: modules/configuration.org:1326
msgid ""
"Fish completes =launchctl= subcommands but not service targets like "
"=gui/<uid>/...=. This replaces the built-in completions with dynamic "
"candidates parsed from =launchctl print= and =launchctl help=, showing each "
"service's running state alongside its target."
msgstr ""

#. type: paragraph
#: modules/configuration.org:1331
msgid ""
"Targets are fully qualified so fish's substring matching can complete a "
"service without knowing its domain upfront. Subcommands and flags are parsed "
"on demand from =launchctl help= to match the installed macOS version."
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:1335
#, no-wrap
msgid "fish-launchctl-completion"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:1337
#, no-wrap
msgid ""
"completions = lib.mkIf pkgs.stdenv.hostPlatform.isDarwin {\n"
"  launchctl.body = builtins.readFile ./completions/launchctl.fish;\n"
"};"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:1348
#, no-wrap
msgid ""
"function __fish_launchctl_subcommands\n"
"    launchctl help 2>&1 | awk '\n"
"        /^Subcommands:$/ { inside = 1; next }\n"
"        inside && /^\\t/ { name = $1; $1 = \"\"; sub(/^[ \\t]+/, \"\"); "
"print name \"\\t\" $0 }\n"
"    '\n"
"end"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:1355
#, no-wrap
msgid ""
"function __fish_launchctl_options\n"
"    string match -q -- '-*' (commandline --current-token); or return\n"
"    set -l tokens (commandline --current-process --tokens-expanded "
"--cut-at-cursor)\n"
"    set -q tokens[2]; or return\n"
"    launchctl help $tokens[2] 2>&1 | tr -d '\\0' | awk '\n"
"        match($0, /^ +/) && RLENGTH == 8 && $1 ~ /^--?[A-Za-z0-9]/ {\n"
"            flag = $1; $1 = \"\"; sub(/^[ \\t]+/, \"\")\n"
"            if ($0 == \"\") { pending = flag; next }\n"
"            print flag \"\\t\" $0; pending = \"\"; next\n"
"        }\n"
"        pending != \"\" { sub(/^ +/, \"\"); print pending \"\\t\" $0; "
"pending = \"\" }\n"
"    '\n"
"end"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:1371
#, no-wrap
msgid ""
"function __fish_launchctl_domains\n"
"    set -l uid (id -u)\n"
"    printf '%s\\n' system gui/$uid user/$uid\n"
"end"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:1376
#, no-wrap
msgid ""
"function __fish_launchctl_domain_services -a domain\n"
"    launchctl print $domain 2>/dev/null | awk '\n"
"        /^\\tservices = \\{$/ { inside = 1; next }\n"
"        inside && /^\\t\\}$/ { exit }\n"
"        inside { print $NF \"\\t\" ($1 == 0 ? \"not running\" : \"pid \" $1) "
"}\n"
"    '\n"
"end"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:1384
#, no-wrap
msgid ""
"function __fish_launchctl_service_targets\n"
"    set -l token (commandline --current-token)\n"
"    set -l domains (__fish_launchctl_domains)\n"
"    if set -l matched (string match -r "
"'^(system|(?:gui|user|pid|login|session)/[0-9]+)/' -- $token)\n"
"        set domains $matched[2]\n"
"    end\n"
"    for domain in $domains\n"
"        printf \"$domain/%s\\n\" (__fish_launchctl_domain_services "
"$domain)\n"
"    end\n"
"end"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:1395
#, no-wrap
msgid ""
"function __fish_launchctl_labels\n"
"    launchctl list | awk 'NR > 1 { print $3 \"\\t\" ($1 == \"-\" ? \"not "
"running\" : \"pid \" $1) }'\n"
"end"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:1399
#, no-wrap
msgid ""
"set -l service_target_commands attach blame bootout debug disable enable "
"kickstart print runstats uncache\n"
"set -l label_commands list remove start stop"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:1402
#, no-wrap
msgid ""
"complete -c launchctl -n __fish_use_subcommand -xa "
"'(__fish_launchctl_subcommands)'\n"
"complete -c launchctl -n 'not __fish_use_subcommand' -a "
"'(__fish_launchctl_options)'\n"
"complete -c launchctl -n \"__fish_seen_subcommand_from "
"$service_target_commands\" -xa '(__fish_launchctl_service_targets)'\n"
"complete -c launchctl -n \"__fish_seen_subcommand_from $label_commands\" -xa "
"'(__fish_launchctl_labels)'\n"
"complete -c launchctl -n '__fish_seen_subcommand_from print-disabled' -xa "
"'(__fish_launchctl_domains)'\n"
"complete -c launchctl -n '__fish_seen_subcommand_from bootstrap; and "
"__fish_is_token_n 2' -xa '(__fish_launchctl_domains)'\n"
"complete -c launchctl -n '__fish_seen_subcommand_from kill; and "
"__fish_is_token_n 2' -xa '(kill -l)'\n"
"complete -c launchctl -n '__fish_seen_subcommand_from kill; and "
"__fish_is_token_n 3' -xa '(__fish_launchctl_service_targets)'"
msgstr ""

#. type: heading **
