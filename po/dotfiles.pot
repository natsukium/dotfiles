"      config,\n"
"      lib,\n"
"      pkgs,\n"
"      ...\n"
"    }:\n"
"    let\n"
"      nixvirt = inputs.nixvirt.lib;\n"
"      runner = config.my.services.forgejo-runner;\n"
"      cfg = runner.windows;\n"
"      windows = config.my.services.windows-vm;"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:4396
#, no-wrap
