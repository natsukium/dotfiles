#. type: paragraph in src
#: modules/configuration.org:4554
#, no-wrap
msgid ""
"domain = template // {\n"
"  os = template.os // {\n"
"    boot = [ ];\n"
"  };"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:4580
#, no-wrap
msgid ""
"    disk = [\n"
"      (\n"
"        builtins.elemAt template.devices.disk 0\n"
"        // {\n"
"          boot.order = 1;\n"
"        }\n"
"      )\n"
"      (builtins.elemAt template.devices.disk 1)\n"
"      {\n"
"        type = \"file\";\n"
"        device = \"cdrom\";\n"
"        driver = {\n"
"          name = \"qemu\";\n"
"          type = \"raw\";\n"
"        };\n"
"        source.file = \"${windows.payloadIso}\";\n"
"        target = {\n"
"          dev = \"hde\";\n"
"          bus = \"sata\";\n"
"        };\n"
"        readonly = true;\n"
"      }\n"
"      {\n"
"        type = \"file\";\n"
"        device = \"cdrom\";\n"
"        driver = {\n"
"          name = \"qemu\";\n"
"          type = \"raw\";\n"
"        };\n"
"        source.file = \"${runnerIso}\";\n"
"        target = {\n"
"          dev = \"hdf\";\n"
"          bus = \"sata\";\n"
"        };\n"
"        readonly = true;\n"
"      }\n"
"      {\n"
"        type = \"file\";\n"
"        device = \"cdrom\";\n"
"        driver = {\n"
"          name = \"qemu\";\n"
"          type = \"raw\";\n"
"        };\n"
"        source = {\n"
"          file = seedIso;\n"
"          startupPolicy = \"optional\";\n"
"        };\n"
"        target = {\n"
"          dev = \"hdg\";\n"
"          bus = \"sata\";\n"
"        };\n"
"        readonly = true;\n"
"      }\n"
"      {\n"
"        type = \"file\";\n"
"        device = \"disk\";\n"
"        driver = {\n"
"          name = \"qemu\";\n"
"          type = \"qcow2\";\n"
"          cache = \"none\";\n"
"          discard = \"unmap\";\n"
"        };\n"
"        source.file = stateImage;\n"
"        target = {\n"
"          dev = \"vdb\";\n"
"          bus = \"virtio\";\n"
"        };\n"
"      }\n"
"    ];\n"
"  };\n"
"};"
