"  '';\n"
"};"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:4034
#, no-wrap
msgid ""
"hostPackages = lib.mkOption {\n"
"  type = lib.types.listOf lib.types.package;\n"
"  default = with pkgs; [\n"
"    bash\n"
"    coreutils\n"
"    curl\n"
"    gawk\n"
"    gitMinimal\n"
"    gnused\n"
