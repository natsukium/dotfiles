"programs.git.settings.url.\"forgejo@git.natsukium.com:\".pushInsteadOf = "
"\"https://git.natsukium.com/\";"
msgstr ""

#. type: heading *
#: modules/configuration.org:2991
#, no-wrap
msgid "Virtual Machines"
msgstr ""

#. type: paragraph
#: modules/configuration.org:2993
msgid ""
"Declares virtual machines managed through libvirt using "
"[[https://github.com/AshleyYakeley/NixVirt][NixVirt]], allowing domain "
"definitions to be expressed declaratively alongside the rest of the system "
"configuration."
msgstr ""

#. type: heading **
#: modules/configuration.org:2997
#, no-wrap
msgid "Host"
msgstr ""

#. type: paragraph
#: modules/configuration.org:2999
msgid ""
"Configures libvirt, a software TPM emulator, a default NAT network, and VM "
"viewers. Guests contribute their own static DHCP leases via =dhcpHosts=."
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3008
#, no-wrap
msgid ""
"{ inputs, ... }:\n"
"{\n"
"  flake.modules.nixos.libvirt =\n"
"    {\n"
"      config,\n"
"      lib,\n"
"      pkgs,\n"
"      ...\n"
"    }:\n"
"    let\n"
"      nixvirt = inputs.nixvirt.lib;\n"
"      cfg = config.my.virtualisation.libvirt;\n"
"    in\n"
"    {\n"
"      imports = [ inputs.nixvirt.nixosModules.default ];"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3024
#, no-wrap
msgid ""
"options.my.virtualisation.libvirt = {\n"
"  enable = lib.mkEnableOption \"libvirt with a NAT network for local "
"guests\";"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3027
#, no-wrap
msgid ""
"dhcpHosts = lib.mkOption {\n"
"  type = lib.types.listOf (\n"
"    lib.types.submodule {\n"
"      options = {\n"
"        mac = lib.mkOption {\n"
"          type = lib.types.str;\n"
"          description = \"MAC address the guest's interface is given.\";\n"
"        };"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3036
#, no-wrap
msgid ""
"name = lib.mkOption {\n"
"  type = lib.types.str;\n"
"  description = \"Name the lease is registered under.\";\n"
"};"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3041
#, no-wrap
msgid ""
"          ip = lib.mkOption {\n"
"            type = lib.types.str;\n"
"            description = \"Address to hand out for that MAC.\";\n"
"          };\n"
"        };\n"
"      }\n"
"    );\n"
"    default = [ ];\n"
"    description = ''\n"
"      Fixed leases on the guest network, contributed by the guests\n"
"      themselves.\n"
"    '';\n"
"  };\n"
"};"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3056
#, no-wrap
msgid ""
"config = lib.mkIf cfg.enable {\n"
"  virtualisation.libvirt = {\n"
"    enable = true;\n"
"    swtpm.enable = true;"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3063
#, no-wrap
msgid ""
"  connections.\"qemu:///system\".networks = [\n"
"    {\n"
"      definition = nixvirt.network.writeXML (\n"
"        nixvirt.network.templates.bridge {\n"
"          uuid = \"4de77f71-1aba-49e0-a139-5454e752db84\";\n"
"          subnet_byte = 122;\n"
"          dhcp_hosts = cfg.dhcpHosts;\n"
"        }\n"
"      );\n"
"      active = true;\n"
"    }\n"
"  ];\n"
"};"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3081
#, no-wrap
msgid "virtualisation.libvirtd.onShutdown = \"shutdown\";"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3083
#, no-wrap
msgid ""
"environment.systemPackages = [\n"
"  pkgs.virt-manager\n"
"  pkgs.virt-viewer\n"
"];"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3088
#, no-wrap
msgid ""
"        users.users.${config.my.username}.extraGroups = [ \"libvirtd\" ];\n"
"      };\n"
"    };\n"
"}"
msgstr ""

#. type: heading **
#: modules/configuration.org:3094
#, no-wrap
msgid "Windows"
msgstr ""

#. type: paragraph
#: modules/configuration.org:3096
msgid ""
"Manages a Windows golden image and an interactive guest backed by a "
"persistent overlay. [[*Windows guest][The Forgejo runner]] shares this same "
"base image."
msgstr ""

#. type: paragraph
#: modules/configuration.org:3099
msgid ""
"A logon scheduled task executes =D:\\bootstrap.ps1= on the guest's state "
"disk if present, decoupling guest-specific startup logic from the shared "
"base image."
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3108
#, no-wrap
msgid ""
"{ inputs, ... }:\n"
"{\n"
"  flake.modules.nixos.windows-vm =\n"
"    {\n"
"      config,\n"
"      lib,\n"
"      pkgs,\n"
"      ...\n"
"    }:\n"
"    let\n"
"      nixvirt = inputs.nixvirt.lib;\n"
"      cfg = config.my.services.windows-vm;"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3121
#, no-wrap
msgid "<<windows-vm-disks>>"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3123
#, no-wrap
msgid "<<windows-vm-payload>>"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3125
#, no-wrap
msgid "<<windows-vm-answer-image>>"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3127
#, no-wrap
msgid ""
"  <<windows-vm-domain>>\n"
"in\n"
"{\n"
"  options.my.services.windows-vm = {\n"
"    <<windows-vm-options>>\n"
"  };"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3134
#, no-wrap
msgid ""
"config = lib.mkIf cfg.enable {\n"
"  assertions = [\n"
"    {\n"
"      assertion = !cfg.installer || cfg.installerIso != null;\n"
"      message = \"my.services.windows-vm.installerIso has to name an "
"installation ISO while installer is on.\";\n"
"    }\n"
"  ];"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3142
#, no-wrap
msgid ""
"my.virtualisation.libvirt = {\n"
"  enable = true;\n"
"  dhcpHosts = [\n"
"    {\n"
"      mac = guestMac;\n"
"      name = \"windows\";\n"
"      ip = \"192.168.122.10\";\n"
"    }\n"
"  ];\n"
"};"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3153
#, no-wrap
msgid "<<windows-vm-libvirt>>"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3155
#, no-wrap
msgid ""
"        <<windows-vm-images>>\n"
"      };\n"
"    };\n"
"}"
msgstr ""

#. type: paragraph
#: modules/configuration.org:3163
msgid ""
"Resource and disk configuration for the Windows guest. =baseImage= and "
"=payloadIso= are exposed as read-only options so secondary guests can "
"reference them without coupling to internal directory layout."
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:3167
#, no-wrap
msgid "windows-vm-options"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3169
#, no-wrap
msgid ""
"enable = lib.mkEnableOption \"a Windows guest and the golden image behind "
"it\";"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3171
#, no-wrap
msgid ""
"installer = lib.mkEnableOption ''\n"
"  the install shape, where the guest writes into the golden image itself\n"
"'';"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3175
#, no-wrap
msgid ""
"installerIso = lib.mkOption {\n"
"  type = lib.types.nullOr lib.types.str;\n"
"  default = null;\n"
"  description = ''\n"
"    Windows installation ISO on the host, read only while\n"
"    {option}`installer` is on.\n"
"  '';\n"
"};"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3184
#, no-wrap
msgid ""
"vcpu = lib.mkOption {\n"
"  type = lib.types.ints.positive;\n"
"  default = 4;\n"
"  description = \"Threads given to the guest.\";\n"
"};"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3190
#, no-wrap
msgid ""
"memory = lib.mkOption {\n"
"  type = lib.types.ints.positive;\n"
"  default = 8;\n"
"  description = \"Memory given to the guest, in GiB.\";\n"
"};"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3196
#, no-wrap
msgid ""
"stateDir = lib.mkOption {\n"
"  type = lib.types.str;\n"
"  default = \"/var/lib/libvirt/windows\";\n"
"  description = \"Directory holding the golden image and the guest's "
"disks.\";\n"
"};"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3202
#, no-wrap
msgid ""
"sharedDirectories = lib.mkOption {\n"
"  type = lib.types.listOf lib.types.str;\n"
"  default = [ ];\n"
"  example = [ \"/data\" ];\n"
"  description = ''\n"
"    Host directories the guest reaches over virtiofs, read and write, one "
"mount\n"
"    each, tagged with the directory's own name.\n"
"  '';\n"
"};"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3212
#, no-wrap
msgid ""
"baseImage = lib.mkOption {\n"
"  type = lib.types.str;\n"
"  readOnly = true;\n"
"  default = \"${cfg.stateDir}/base.qcow2\";\n"
"  description = \"The golden image, for guests that stack an overlay on "
"it.\";\n"
"};"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3219
#, no-wrap
msgid ""
"payloadIso = lib.mkOption {\n"
"  type = lib.types.package;\n"
"  readOnly = true;\n"
"  default = payloadIso;\n"
"  description = ''\n"
"    The disc carrying {file}`provision.ps1`, which every guest needs to set "
"its\n"
"    own D: up.\n"
"  '';\n"
"};"
msgstr ""

#. type: heading ****
#: modules/configuration.org:3230 modules/configuration.org:4472
#, no-wrap
msgid "Disks"
msgstr ""

#. type: paragraph
#: modules/configuration.org:3232
msgid ""
"Defines disk paths for the base image, the system overlay (C:), and the "
"persistent state disk (D:). Unlike ephemeral runner guests, this interactive "
"guest preserves its overlay across reboots."
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:3236
#, no-wrap
msgid "windows-vm-disks"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3238
#, no-wrap
msgid ""
"baseImage = cfg.baseImage;\n"
"systemImage = \"${cfg.stateDir}/system.qcow2\";\n"
"stateImage = \"${cfg.stateDir}/state.qcow2\";\n"
"installIsoCopy = \"${cfg.stateDir}/install.iso\";"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3245
#, no-wrap
msgid "guestMac = \"52:54:00:c9:a0:e4\";"
msgstr ""

#. type: heading ***
#: modules/configuration.org:3248
#, no-wrap
msgid "The payload disc"
msgstr ""

#. type: paragraph
#: modules/configuration.org:3250
msgid ""
"Builds an ISO carrying provisioning scripts and the SPICE guest agent. The "
"agent version is pinned in =spice-vdagent.nix= rather than inline so "
"Renovate updates are not overwritten by tangling."
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:3254
#, no-wrap
msgid "windows-vm-payload"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3256
#, no-wrap
msgid "spiceVdagent = pkgs.callPackage ./spice-vdagent.nix { };"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3258
#, no-wrap
msgid ""
"payloadIso = pkgs.runCommand \"windows-vm-payload.iso\" { nativeBuildInputs "
"= [ pkgs.xorriso ]; } ''\n"
"  mkdir payload\n"
"  cp ${./provision.ps1} payload/provision.ps1\n"
"  cp ${./bootstrap.ps1} payload/bootstrap.ps1\n"
"  cp ${./share.ps1} payload/share.ps1\n"
"  cp ${spiceVdagent} payload/spice-vdagent.msi\n"
"  xorriso -as mkisofs -J -r -V WINVM -o $out payload\n"
"'';"
msgstr ""

#. type: heading ***
#: modules/configuration.org:3268
#, no-wrap
msgid "The answer disk"
msgstr ""

#. type: paragraph
#: modules/configuration.org:3270
msgid ""
"Generates a partitioned FAT disk image containing =autounattend.xml= (for "
"WinPE)  and =unattend.xml= (for post-reboot passes). Windows Setup requires "
"a partitioned disk to read unattended answers and ignores ISO media. Target "
"disk selection is omitted to prevent unattended installation from "
"overwriting the wrong drive."
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:3275
#, no-wrap
msgid "windows-vm-answer-image"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3277
#, no-wrap
msgid ""
"answerImage =\n"
"  pkgs.runCommand \"windows-vm-answer.img\"\n"
"    {\n"
"      nativeBuildInputs = [\n"
"        pkgs.dosfstools\n"
"        pkgs.mtools\n"
"        pkgs.util-linux\n"
"      ];\n"
"    }\n"
"    ''\n"
"      truncate -s 16M image\n"
"      printf 'label: dos\\n2048,,c,*\\n' | sfdisk image\n"
"      mkfs.fat --offset 2048 -F 16 -n ANSWER image\n"
"      sed '/<settings pass=\"windowsPE\">/,/<\\/settings>/d' "
"${./autounattend.xml} > unattend.xml\n"
"      mcopy -i image@@1M ${./autounattend.xml} ::/autounattend.xml\n"
"      mcopy -i image@@1M unattend.xml ::/unattend.xml\n"
"      mv image $out\n"
"    '';"
msgstr ""

#. type: heading ****
#: modules/configuration.org:3297 modules/configuration.org:4526
#, no-wrap
msgid "The domain"
msgstr ""

#. type: paragraph
#: modules/configuration.org:3299
msgid ""
"Extends NixVirt's Windows template for both installer and normal modes.  "
"Reusing a single domain preserves NVRAM variables written during "
"installation, ensuring the Windows boot loader entry remains intact when "
"booting the overlay."
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:3303
#, no-wrap
msgid "windows-vm-domain"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3305
#, no-wrap
msgid ""
"template = nixvirt.domain.templates.windows {\n"
"  name = \"windows\";\n"
"  uuid = \"e68fc8b5-3214-4c79-8469-62c76aec521b\";\n"
"  vcpu = {\n"
"    count = cfg.vcpu;\n"
"  };\n"
"  memory = {\n"
"    count = cfg.memory;\n"
"    unit = \"GiB\";\n"
"  };\n"
"  storage_vol = if cfg.installer then baseImage else systemImage;\n"
"  backing_vol = if cfg.installer then null else baseImage;\n"
"  install_vol = if cfg.installer then installIsoCopy else null;\n"
"  nvram_path = \"${cfg.stateDir}/nvram.fd\";\n"
"  net_iface_mac = guestMac;\n"
"  virtio_net = true;\n"
"  virtio_drive = true;\n"
"  virtio_video = null;\n"
"  install_virtio = true;\n"
"};"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3330
#, no-wrap
msgid ""
"domain =\n"
"  template\n"
"  // lib.optionalAttrs (cfg.sharedDirectories != [ ]) {\n"
"    memoryBacking.access.mode = \"shared\";\n"
"  }\n"
"  // {\n"
"    os = template.os // {\n"
"      boot = [ ];\n"
"    };"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3345 modules/configuration.org:4562
#, no-wrap
msgid ""
"devices = template.devices // {\n"
"  memballoon = {\n"
"    model = \"virtio\";\n"
"    freePageReporting = true;\n"
"  };"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3353
#, no-wrap
msgid ""
"filesystem = map (dir: {\n"
"  type = \"mount\";\n"
"  accessmode = \"passthrough\";\n"
"  driver.type = \"virtiofs\";\n"
"  binary.path = \"${pkgs.virtiofsd}/bin/virtiofsd\";\n"
"  source.dir = dir;\n"
"  target.dir = builtins.baseNameOf dir;\n"
"}) cfg.sharedDirectories;"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3364 modules/configuration.org:4570
#, no-wrap
msgid ""
"channel = template.devices.channel ++ [\n"
"  {\n"
"    type = \"unix\";\n"
"    target = {\n"
"      type = \"virtio\";\n"
"      name = \"org.qemu.guest_agent.0\";\n"
"    };\n"
"  }\n"
"];"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3374
#, no-wrap
msgid ""
"    disk = [\n"
"      (\n"
"        builtins.elemAt template.devices.disk 0\n"
"        // {\n"
"          boot.order = if cfg.installer then 2 else 1;\n"
"        }\n"
"      )\n"
"      (builtins.elemAt template.devices.disk 1 // lib.optionalAttrs "
"cfg.installer { boot.order = 1; })\n"
"      (builtins.elemAt template.devices.disk 2)\n"
"      {\n"
"        type = \"file\";\n"
"        device = \"cdrom\";\n"
"        driver = {\n"
"          name = \"qemu\";\n"
"          type = \"raw\";\n"
"        };\n"
"        source.file = \"${payloadIso}\";\n"
"        target = {\n"
"          dev = \"hde\";\n"
"          bus = \"sata\";\n"
"        };\n"
"        readonly = true;\n"
"      }\n"
"      {\n"
"        type = \"file\";\n"
"        device = \"disk\";\n"
"        driver = {\n"
"          name = \"qemu\";\n"
"          type = \"qcow2\";\n"
"          cache = \"none\";\n"
"          discard = \"unmap\";\n"
"        };\n"
"        source.file = stateImage;\n"
"        target = {\n"
"          dev = \"vdb\";\n"
"          bus = \"virtio\";\n"
"        };\n"
"      }\n"
"    ]\n"
"    ++ lib.optional cfg.installer {\n"
"      type = \"file\";\n"
"      device = \"disk\";\n"
"      driver = {\n"
"        name = \"qemu\";\n"
"        type = \"raw\";\n"
"      };\n"
"      source.file = \"${answerImage}\";\n"
"      target = {\n"
"        dev = \"sda\";\n"
"        bus = \"usb\";\n"
"      };\n"
"      readonly = true;\n"
"    };\n"
"  };\n"
"};"
msgstr ""

#. type: paragraph
#: modules/configuration.org:3435
msgid ""
"The domain is defined but not started automatically on host activation, as "
"it is intended for on-demand interactive use."
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:3438
#, no-wrap
msgid "windows-vm-libvirt"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3440
#, no-wrap
msgid ""
"virtualisation.libvirt.connections.\"qemu:///system\".domains = [\n"
"  {\n"
"    definition = pkgs.runCommand \"windows.xml\" { } ''\n"
"      sed \"s|<target dev='sda' bus='usb'/>|<target dev='sda' bus='usb' "
"removable='on'/>|\" \\\n"
"        ${nixvirt.domain.writeXML domain} > $out\n"
"    '';\n"
"    active = null;\n"
"  }\n"
"];"
msgstr ""

#. type: heading ****
#: modules/configuration.org:3454 modules/configuration.org:4667
#, no-wrap
msgid "Images"
msgstr ""

#. type: paragraph
#: modules/configuration.org:3456
msgid ""
"Initializes empty qcow2 images for the base image, state disk, and system "
"overlay on first boot. When =installer= is enabled, synchronizes the "
"installer ISO into the state directory."
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:3460
#, no-wrap
msgid "windows-vm-images"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3462
#, no-wrap
msgid ""
"systemd.services.windows-vm-images = {\n"
"  description = \"Provision disk images for the Windows guest\";\n"
"  wantedBy = [ \"multi-user.target\" ];\n"
"  before = [\n"
"    \"libvirtd.service\"\n"
"    \"nixvirt.service\"\n"
"  ];\n"
"  serviceConfig = {\n"
"    Type = \"oneshot\";\n"
"    RemainAfterExit = true;\n"
"    TimeoutStartSec = \"30min\";\n"
"  };\n"
"  path = [\n"
"    pkgs.e2fsprogs\n"
"    pkgs.qemu-utils\n"
"  ];\n"
"  script = ''\n"
"    mkdir -p ${cfg.stateDir}\n"
"    chattr +C ${cfg.stateDir} || true\n"
"    test -e ${baseImage} || qemu-img create -f qcow2 ${baseImage} 80G\n"
"    test -e ${stateImage} || qemu-img create -f qcow2 ${stateImage} 32G\n"
"  ''\n"
"  + lib.optionalString (!cfg.installer) ''\n"
"    if [ -e ${baseImage} ] && [ ! -e ${systemImage} ]; then\n"
"      qemu-img create -f qcow2 -F qcow2 -b ${baseImage} ${systemImage}\n"
"    fi\n"
"  ''\n"
"  + lib.optionalString cfg.installer ''\n"
"    if [ \"$(stat -c %s ${cfg.installerIso})\" != \"$(stat -c %s "
"${installIsoCopy} 2>/dev/null)\" ]; then\n"
"      cp ${cfg.installerIso} ${installIsoCopy}\n"
"    fi\n"
"  '';\n"
"};"
msgstr ""

#. type: heading ***
#: modules/configuration.org:3502
#, no-wrap
msgid "Provisioning"
msgstr ""

#. type: paragraph
#: modules/configuration.org:3504
msgid ""
"=provision.ps1= configures the guest environment: virtio drivers, QEMU guest "
"agent, Git, Node.js, MSVC tools, and the nightly Rust toolchain. Software is "
"installed via direct downloads because winget is unavailable in unattended "
"sessions."
msgstr ""

#. type: paragraph
#: modules/configuration.org:3509
msgid ""
"Toolchain caches are directed to D: so they persist across overlay resets.  "
"Desktop animations and transparency are disabled to reduce CPU overhead "
"under the unaccelerated virtio-gpu driver. All steps are idempotent."
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3515
#, no-wrap
msgid ""
"<#\n"
"    Turns a bare Windows install into the golden image, and a guest's "
"blank\n"
"    second disk into D:."
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3519
#, no-wrap
msgid ""
"Run from the payload disc:\n"
"  powershell -ExecutionPolicy Bypass -File X:\\provision.ps1"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3522
#, no-wrap
msgid ""
"    Re-running is safe. Each step checks for its own result first, so this "
"is\n"
"    both how the image is changed after the fact and how a new guest gets "
"its own\n"
"    toolchain onto D:.\n"
"[CmdletBinding()]\n"
"param()"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3529 modules/configuration.org:3750
#: modules/configuration.org:3827 modules/configuration.org:4780
#, no-wrap
msgid "$ErrorActionPreference = \"Stop\""
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3531 modules/configuration.org:3829
#: modules/configuration.org:4782
#, no-wrap
msgid ""
"function Step($message) {\n"
"    Write-Host \"==> $message\" -ForegroundColor Cyan\n"
"}"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3538 modules/configuration.org:4789
#, no-wrap
msgid ""
"function Invoke-Native($exe, [string[]]$arguments) {\n"
"    $previous = $ErrorActionPreference\n"
"    $ErrorActionPreference = \"Continue\"\n"
"    try {\n"
"        & $exe @arguments 2>&1 | ForEach-Object { Write-Host $_ }\n"
"    }\n"
"    finally {\n"
"        $ErrorActionPreference = $previous\n"
"    }\n"
"}"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3549
#, no-wrap
msgid ""
"function Set-MachineVariable($name, $value) {\n"
"    if ([Environment]::GetEnvironmentVariable($name, \"Machine\") -ne "
"$value) {\n"
"        [Environment]::SetEnvironmentVariable($name, $value, \"Machine\")\n"
"    }\n"
"    Set-Item -Path \"Env:$name\" -Value $value\n"
"}"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3556
#, no-wrap
msgid "$payload = (Get-Volume -FileSystemLabel WINVM).DriveLetter + \":\""
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3558
#, no-wrap
msgid ""
"if (-not (Get-Service -Name \"QEMU-GA\" -ErrorAction SilentlyContinue)) {\n"
"    Step \"Installing the virtio guest tools\"\n"
"    $tools = Get-Volume |\n"
"        Where-Object DriveLetter |\n"
"        ForEach-Object { Get-Item "
"\"$($_.DriveLetter):\\virtio?win?gt?x64.msi\" -ErrorAction SilentlyContinue "
"} |\n"
"        Select-Object -First 1\n"
"    if (-not $tools) {\n"
"        throw \"the virtio-win disc is not attached, so there is no guest "
"agent to install\"\n"
"    }\n"
"    Start-Process msiexec.exe -Wait -ArgumentList @(\"/i\", $tools.FullName, "
"\"/qn\", \"/norestart\")"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3572
#, no-wrap
msgid ""
"    $agent = Get-Item (Join-Path $tools.PSDrive.Root "
"\"guest?agent\\qemu?ga?x86_64.msi\")\n"
"    Start-Process msiexec.exe -Wait -ArgumentList @(\"/i\", $agent.FullName, "
"\"/qn\", \"/norestart\")\n"
"}"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3578
#, no-wrap
msgid ""
"if (-not (Get-Service -Name \"spice-agent\", \"vdservice\" -ErrorAction "
"SilentlyContinue)) {\n"
"    Step \"Installing the SPICE agent so the console has a clipboard\"\n"
"    Start-Process msiexec.exe -Wait -ArgumentList \"/i "
"`\"$payload\\spice-vdagent.msi`\" /qn /norestart\"\n"
"}"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3583
#, no-wrap
msgid ""
"Step \"Installing the logon task\"\n"
"New-Item -ItemType Directory -Force -Path \"C:\\windows-vm\" | Out-Null\n"
"Copy-Item \"$payload\\bootstrap.ps1\" \"C:\\windows-vm\\bootstrap.ps1\" "
"-Force"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3591
#, no-wrap
msgid ""
"Register-ScheduledTask -TaskName \"windows-vm-bootstrap\" -Force `\n"
"    -Action (New-ScheduledTaskAction -Execute \"powershell.exe\" `\n"
"        -Argument \"-NoProfile -ExecutionPolicy Bypass -File "
"C:\\windows-vm\\bootstrap.ps1\") `\n"
"    -Trigger (New-ScheduledTaskTrigger -AtLogOn -User \"ci\") `\n"
"    -Principal (New-ScheduledTaskPrincipal -UserId \"ci\" -LogonType "
"Interactive -RunLevel Highest) `\n"
"    -Settings (New-ScheduledTaskSettingsSet -ExecutionTimeLimit 0 "
"-RestartCount 3 `\n"
"        -RestartInterval (New-TimeSpan -Minutes 1)) |\n"
"    Out-Null"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3600
#, no-wrap
msgid ""
"Step \"Preparing the state disk\"\n"
"& \"C:\\windows-vm\\bootstrap.ps1\" -StateOnly\n"
"$payload = (Get-Volume -FileSystemLabel WINVM).DriveLetter + \":\""
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3607
#, no-wrap
msgid ""
"Step \"Pointing the toolchain caches at D:\"\n"
"Set-MachineVariable \"RUSTUP_HOME\" \"D:\\rustup\"\n"
"Set-MachineVariable \"CARGO_HOME\" \"D:\\cargo\"\n"
"$machinePath = [Environment]::GetEnvironmentVariable(\"Path\", "
"\"Machine\")\n"
"if ($machinePath -notlike \"*D:\\cargo\\bin*\") {\n"
"    [Environment]::SetEnvironmentVariable(\"Path\", "
"\"$machinePath;D:\\cargo\\bin\", \"Machine\")\n"
"}\n"
"$env:Path = \"$env:Path;D:\\cargo\\bin\""
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3618
#, no-wrap
msgid ""
"[Net.ServicePointManager]::SecurityProtocol = "
"[Net.SecurityProtocolType]::Tls12"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3620
#, no-wrap
msgid ""
"function Get-Installer($url, $name) {\n"
"    $path = Join-Path $env:TEMP $name\n"
"    if (-not (Test-Path $path)) {\n"
"        Invoke-WebRequest -Uri $url -OutFile $path -UseBasicParsing\n"
"    }\n"
"    return $path\n"
"}"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3628
#, no-wrap
msgid ""
"if (-not (Test-Path \"C:\\Program Files\\Git\\cmd\\git.exe\")) {\n"
"    Step \"Installing Git for Windows\"\n"
"    $asset = (Invoke-RestMethod "
"\"https://api.github.com/repos/git-for-windows/git/releases/latest\").assets "
"|\n"
"        Where-Object name -like \"*-64-bit.exe\" |\n"
"        Select-Object -First 1\n"
"    $installer = Get-Installer $asset.browser_download_url $asset.name\n"
"    Invoke-Native $installer @(\"/VERYSILENT\", \"/NORESTART\", "
"\"/NOCANCEL\", \"/SP-\", \"/SUPPRESSMSGBOXES\")\n"
"}\n"
"$env:Path = \"$env:Path;C:\\Program Files\\Git\\cmd\""
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3641
#, no-wrap
msgid ""
"if (-not (Test-Path \"C:\\Program Files\\nodejs\\node.exe\")) {\n"
"    Step \"Installing Node.js\"\n"
"    $lts = (Invoke-RestMethod \"https://nodejs.org/dist/index.json\") |\n"
"        Where-Object lts |\n"
"        Select-Object -First 1\n"
"    $installer = Get-Installer "
"\"https://nodejs.org/dist/$($lts.version)/node-$($lts.version)-x64.msi\" "
"\"node-$($lts.version)-x64.msi\"\n"
"    Start-Process msiexec.exe -Wait -ArgumentList @(\"/i\", $installer, "
"\"/qn\", \"/norestart\")\n"
"}\n"
"$env:Path = \"$env:Path;C:\\Program Files\\nodejs\""
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3651
#, no-wrap
msgid ""
"if (-not (Test-Path \"D:\\cargo\\bin\\rustup.exe\")) {\n"
"    Step \"Installing rustup with the nightly toolchain\"\n"
"    $installer = Get-Installer "
"\"https://static.rust-lang.org/rustup/dist/x86_64-pc-windows-msvc/rustup-init.exe\" "
"\"rustup-init.exe\"\n"
"    Invoke-Native $installer @(\"-y\", \"--no-modify-path\", "
"\"--default-toolchain\", \"nightly\", \"--profile\", \"default\")\n"
"    if ($LASTEXITCODE -ne 0) {\n"
"        throw \"rustup-init failed (exit $LASTEXITCODE)\"\n"
"    }\n"
"}"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3662
#, no-wrap
msgid ""
"$vswhere = \"${env:ProgramFiles(x86)}\\Microsoft Visual "
"Studio\\Installer\\vswhere.exe\"\n"
"$hasVCTools = (Test-Path $vswhere) -and\n"
"    (& $vswhere -products * -requires "
"Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property "
"installationPath)\n"
"if (-not $hasVCTools) {\n"
"    Step \"Installing the MSVC build tools (this takes a while)\"\n"
"    $installer = Get-Installer "
"\"https://aka.ms/vs/17/release/vs_BuildTools.exe\" \"vs_BuildTools.exe\"\n"
"    Invoke-Native $installer @(\"--quiet\", \"--wait\", \"--norestart\", "
"\"--nocache\",\n"
"        \"--add\", \"Microsoft.VisualStudio.Workload.VCTools\", "
"\"--includeRecommended\")\n"
"    if ($LASTEXITCODE -ne 0 -and $LASTEXITCODE -ne 3010) {\n"
"        throw \"vs_BuildTools failed (exit $LASTEXITCODE)\"\n"
"    }\n"
"}"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3676
#, no-wrap
msgid ""
"Step \"Pinning nightly as the default toolchain\"\n"
"Invoke-Native \"D:\\cargo\\bin\\rustup.exe\" @(\"default\", \"nightly\")"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3679
#, no-wrap
msgid ""
"if (-not (Test-Path \"D:\\cargo\\bin\\cargo-nextest.exe\")) {\n"
"    Step \"Installing cargo-nextest\"\n"
"    $archive = Join-Path $env:TEMP \"cargo-nextest.zip\"\n"
"    Invoke-WebRequest -Uri \"https://get.nexte.st/latest/windows\" -OutFile "
"$archive\n"
"    Expand-Archive -Path $archive -DestinationPath \"D:\\cargo\\bin\" "
"-Force\n"
"    Remove-Item $archive\n"
"}"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3689
#, no-wrap
msgid ""
"Step \"Keeping the guest awake and out of Windows Update's way\"\n"
"$policy = "
"\"HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU\"\n"
"New-Item -Path $policy -Force | Out-Null\n"
"Set-ItemProperty -Path $policy -Name \"NoAutoUpdate\" -Value 1 -Type DWord"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3696
#, no-wrap
msgid ""
"Invoke-Native powercfg @(\"/change\", \"standby-timeout-ac\", \"0\")\n"
"Invoke-Native powercfg @(\"/change\", \"hibernate-timeout-ac\", \"0\")\n"
"Invoke-Native powercfg @(\"/change\", \"monitor-timeout-ac\", \"0\")"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3700
#, no-wrap
msgid ""
"Step \"Turning the desktop effects off\"\n"
"$sid = (Get-CimInstance Win32_UserAccount -Filter \"Name='ci' AND "
"LocalAccount=True\").SID\n"
"New-PSDrive -Name HKU -PSProvider Registry -Root HKEY_USERS -ErrorAction "
"SilentlyContinue | Out-Null\n"
"if (-not (Test-Path \"HKU:\\$sid\")) {\n"
"    throw \"ci is not logged on, so its hive is not loaded and there is "
"nothing to write to\"\n"
"}"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3709
#, no-wrap
msgid ""
"function Set-UserValue($path, $name, $value, $type) {\n"
"    $full = \"HKU:\\$sid\\$path\"\n"
"    if (-not (Test-Path $full)) {\n"
"        New-Item -Path $full -Force | Out-Null\n"
"    }\n"
"    Set-ItemProperty -Path $full -Name $name -Value $value -Type $type\n"
"}"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3717
#, no-wrap
msgid ""
"Set-UserValue "
"\"Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\VisualEffects\" "
"\"VisualFXSetting\" 2 DWord\n"
"Set-UserValue \"Control Panel\\Desktop\" \"UserPreferencesMask\" "
"([byte[]](0x90, 0x12, 0x03, 0x80, 0x10, 0x00, 0x00, 0x00)) Binary\n"
"Set-UserValue \"Control Panel\\Desktop\" \"DragFullWindows\" \"0\" String\n"
"Set-UserValue \"Control Panel\\Desktop\" \"MenuShowDelay\" \"0\" String\n"
"Set-UserValue \"Control Panel\\Desktop\\WindowMetrics\" \"MinAnimate\" \"0\" "
"String\n"
"Set-UserValue \"Control Panel\\Desktop\" \"FontSmoothing\" \"2\" String\n"
"foreach ($name in \"TaskbarAnimations\", \"ListviewAlphaSelect\", "
"\"ListviewShadow\") {\n"
"    Set-UserValue "
"\"Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced\" $name 0 "
"DWord\n"
"}\n"
"Set-UserValue \"Software\\Microsoft\\Windows\\DWM\" \"EnableAeroPeek\" 0 "
"DWord\n"
"Set-UserValue "
"\"Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize\" "
"\"EnableTransparency\" 0 DWord"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3730 modules/configuration.org:3868
#: modules/configuration.org:4841
#, no-wrap
msgid "Step \"Done\""
msgstr ""

#. type: paragraph
#: modules/configuration.org:3733
msgid ""
"=bootstrap.ps1= runs at user logon to partition and format the state disk as "
"=D:= on first boot and remount optical drives. It then invokes "
"=D:\\bootstrap.ps1= if present, allowing guests to run custom startup tasks."
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3738
#, no-wrap
msgid ""
"<#\n"
"    Runs at every logon, from the copy the golden image carries at\n"
"    C:\\windows-vm\\bootstrap.ps1."
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3742
#, no-wrap
msgid ""
"    -StateOnly stops after D: is ready, for callers that have their own idea "
"of\n"
"    what comes next.\n"
"[CmdletBinding()]\n"
"param(\n"
"    [switch]$StateOnly\n"
")"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3754
#, no-wrap
msgid ""
"$optical = @(Get-CimInstance Win32_Volume -Filter \"DriveType = 5\")\n"
"$optical | ForEach-Object { $_ | Set-CimInstance -Property @{ DriveLetter = "
"$null } }\n"
"$letter = 90\n"
"$optical | ForEach-Object {\n"
"    $_ | Set-CimInstance -Property @{ DriveLetter = ([char]$letter + \":\") "
"}\n"
"    $letter--\n"
"}"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3765
#, no-wrap
msgid ""
"$state = Get-Volume | Where-Object FileSystemLabel -eq \"state\" | "
"Select-Object -First 1\n"
"if (-not $state) {\n"
"    $systemDisk = (Get-Partition -DriveLetter C).DiskNumber\n"
"    $candidates = @(Get-Disk | Where-Object { $_.Number -ne $systemDisk -and "
"$_.BusType -ne \"USB\" })\n"
"    if ($candidates.Count -ne 1) {\n"
"        throw \"expected exactly one non-system disk, found "
"$($candidates.Count)\"\n"
"    }\n"
"    $disk = $candidates[0]"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3779
#, no-wrap
msgid ""
"    if ($disk.PartitionStyle -eq \"RAW\") {\n"
"        Initialize-Disk -Number $disk.Number -PartitionStyle GPT | "
"Out-Null\n"
"    }\n"
"    Get-Partition -DiskNumber $disk.Number -ErrorAction SilentlyContinue |\n"
"        Where-Object Type -ne \"Reserved\" |\n"
"        Remove-Partition -Confirm:$false\n"
"    New-Partition -DiskNumber $disk.Number -DriveLetter D -UseMaximumSize "
"|\n"
"        Format-Volume -FileSystem NTFS -NewFileSystemLabel state "
"-Confirm:$false |\n"
"        Out-Null\n"
"}\n"
"elseif ($state.DriveLetter -ne \"D\") {\n"
"    Set-Partition -DriveLetter $state.DriveLetter -NewDriveLetter D\n"
"}"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3796
#, no-wrap
msgid ""
"if (-not (Test-Path \"D:\\\")) {\n"
"    throw \"D: is missing, so anything written there would land on C: and "
"die with the next reset\"\n"
"}"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3800
#, no-wrap
msgid ""
"if (-not $StateOnly -and (Test-Path \"D:\\bootstrap.ps1\")) {\n"
"    & \"D:\\bootstrap.ps1\"\n"
"}"
msgstr ""

#. type: heading ***
#: modules/configuration.org:3805
#, no-wrap
msgid "Shared directories"
msgstr ""

#. type: paragraph
#: modules/configuration.org:3807
msgid ""
"=share.ps1= installs WinFsp and configures the =VirtioFsSvc= service to "
"mount host directories shared via virtiofs at a designated drive "
"letter. This runs once on the interactive guest rather than the shared "
"golden image."
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3813
#, no-wrap
msgid ""
"<#\n"
"    Mounts whatever the domain shares over virtiofs at S:."
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3816
#, no-wrap
msgid ""
"Run once from the payload disc:\n"
"  powershell -ExecutionPolicy Bypass -File X:\\share.ps1"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3819
#, no-wrap
msgid ""
"    Not part of provision.ps1, because the golden image is shared with a "
"guest\n"
"    that has no share to reach. This guest's C: is never reset, so once is "
"once.\n"
"[CmdletBinding()]\n"
"param(\n"
"    [string]$MountPoint = \"S:\"\n"
")"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3835
#, no-wrap
msgid ""
"if (-not (Test-Path \"${env:ProgramFiles(x86)}\\WinFsp\\bin\")) {\n"
"    Step \"Installing WinFsp\"\n"
"    [Net.ServicePointManager]::SecurityProtocol = "
"[Net.SecurityProtocolType]::Tls12\n"
"    $asset = (Invoke-RestMethod "
"\"https://api.github.com/repos/winfsp/winfsp/releases/latest\").assets |\n"
"        Where-Object name -like \"winfsp-*.msi\" |\n"
"        Select-Object -First 1\n"
"    $installer = Join-Path $env:TEMP $asset.name\n"
"    if (-not (Test-Path $installer)) {\n"
"        Invoke-WebRequest -Uri $asset.browser_download_url -OutFile "
"$installer -UseBasicParsing\n"
"    }\n"
"    Start-Process msiexec.exe -Wait -ArgumentList @(\"/i\", $installer, "
"\"/qn\", \"/norestart\")\n"
"}"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3848
#, no-wrap
msgid ""
"$service = Get-Service VirtioFsSvc -ErrorAction SilentlyContinue\n"
"if (-not $service) {\n"
"    throw \"the virtio-win guest tools have not installed VirtioFsSvc, so "
"there is nothing to mount with\"\n"
"}"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3853
#, no-wrap
msgid ""
"Step \"Pinning the share to $MountPoint\"\n"
"$key = \"HKLM:\\SYSTEM\\CurrentControlSet\\Services\\VirtioFsSvc\"\n"
"$exe = ([string](Get-ItemProperty $key).ImagePath) -replace ' -m .*$', ''\n"
"if ($service.Status -eq \"Running\") {\n"
"    Stop-Service -Name VirtioFsSvc\n"
"}\n"
"Set-ItemProperty -Path $key -Name ImagePath -Value \"$exe -m $MountPoint\" "
"-Type ExpandString"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3865
#, no-wrap
msgid ""
"Set-Service -Name VirtioFsSvc -StartupType Automatic\n"
"Start-Service -Name VirtioFsSvc"
msgstr ""

#. type: heading ***
#: modules/configuration.org:3871
#, no-wrap
msgid "Installing Windows"
msgstr ""

#. type: paragraph
#: modules/configuration.org:3873
msgid ""
"To install the golden image, set =installerIso= to an official Windows "
"installation ISO, enable =installer = true=, and boot the guest."
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3877
#, no-wrap
msgid ""
"sudo nixos-rebuild switch --flake .\n"
"virsh -c qemu:///system start windows\n"
"virt-viewer -c qemu:///system windows"
msgstr ""

#. type: paragraph
#: modules/configuration.org:3882
msgid ""
"Send a key press to satisfy the initial CD-ROM boot prompt. Setup will "
"automatically format the disk according to the answer file and execute "
"=provision.ps1= on first logon; only the target disk needs to be selected "
"manually."
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3888
#, no-wrap
msgid ""
"virsh -c qemu:///system send-key windows --holdtime 150 KEY_SPACE\n"
"virsh -c qemu:///system screenshot windows shot.ppm"
msgstr ""

#. type: paragraph
#: modules/configuration.org:3892
msgid ""
"Once installation finishes, disable =installer= and rebuild. The domain will "
"then boot from its overlay disk. Future updates to the golden image can be "
"made by enabling =installer= again and re-running =provision.ps1=."
msgstr ""

#. type: heading *
#: modules/configuration.org:3896
#, no-wrap
msgid "Continuous Integration"
msgstr ""

#. type: heading **
#: modules/configuration.org:3898
#, no-wrap
msgid "Forgejo Actions Runner"
msgstr ""

#. type: paragraph
#: modules/configuration.org:3900
msgid ""
"My Forgejo instance dispatches Actions jobs to registered runners. Linux "
"hosts use nixpkgs' =services.gitea-actions-runner=; macOS has no such "
"module, so I add =services.forgejo-runner= for Darwin, driven by launchd and "
"shaped like the NixOS option so a runner reads the same on either platform."
msgstr ""

#. type: paragraph
#: modules/configuration.org:3905
msgid ""
"I split this into three modules. The nix-darwin mechanism is neutral, so I "
"publish it as =flake.darwinModules.forgejo-runner= via "
"[[file:exports.nix][exports.nix]]. The =my.services.forgejo-runner= wrappers "
"bake my defaults (instance URL, labels, niks3 client) and live in the "
"internal =flake.modules.{darwin,nixos}= registry.  A host enables a wrapper "
"and supplies its own registration token. The [[*Windows guest][Windows "
"guest]] hangs off the same directory, and is imported by hand because a "
"directory with a =default.nix= is one module."
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3919
#, no-wrap
msgid ""
"{ ... }:\n"
"let\n"
"  <<forgejo-runner-wrapper-shared>>"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3923
#, no-wrap
msgid ""
"  <<forgejo-runner-wrappers>>\n"
"in\n"
"{\n"
"  imports = [ ./windows ];"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3928
#, no-wrap
msgid ""
"  flake.modules.darwin.forgejo-runner = darwinWrapper;\n"
"  flake.modules.nixos.forgejo-runner = nixosWrapper;\n"
"}"
msgstr ""

#. type: heading ***
#: modules/configuration.org:3933
#, no-wrap
msgid "nix-darwin module"
msgstr ""

#. type: paragraph
#: modules/configuration.org:3935
msgid ""
"This module carries nothing personal — just =services.forgejo-runner=, "
"mirroring the instance schema of nixpkgs' =services.gitea-actions-runner= "
"(=token=/=tokenFile=, =labels=, freeform =settings=). Each enabled instance "
"becomes a launchd job that registers, then execs the daemon. I record a hash "
"of =token= plus =labels= in =.registration-state= so registration re-runs "
"when either changes; the token is reusable, so re-registering is fine."
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3948
#, no-wrap
msgid ""
"{\n"
"  config,\n"
"  lib,\n"
"  pkgs,\n"
"  ...\n"
"}:\n"
"let\n"
"  cfg = config.services.forgejo-runner;\n"
"  settingsFormat = pkgs.formats.yaml { };"
msgstr ""

