#. type: paragraph
#: configuration.org:1152
msgid ""
"Scripts used in flake derivations, pre-commit hooks, and Makefile recipes.  "
"Extracted to separate files for proper syntax highlighting and independent "
"invocability."
msgstr ""

#. type: paragraph
#: configuration.org:1155
msgid ""
"=org-to-html.el= drives the documentation export. Four choices shape "
"it. First, htmlize emits =org-*= class names rather than inline colors, so "
"the palette lives in [[file:assets/org-html.css][=assets/org-html.css=]] and "
"the dark theme can restyle code; that stylesheet and the script beside it "
"([[file:assets/org-html.js][=assets/org-html.js=]], which adds a breadcrumb "
"bar, an on-this-page rail, and per-block copy buttons) are inlined into each "
"page, so an exported page makes no external request. Second, tree-sitter "
"fontifies Nix blocks, which is why =nix-ts-mode= and its grammar are loaded "
"before export."
msgstr ""

#. type: paragraph
#: configuration.org:1163
msgid ""
"Third, every code block that tangles is headed by a link to the file it "
"produces.  Literate configuration only pays off if a reader can get from the "
"prose to the real artifact, and nothing in an exported block says where it "
"lands. Recovering that is harder than it looks: =#+INCLUDE= splices the "
"child documents into this one and discards where each block came from, while "
"=:tangle= paths are written relative to the document that declares them, and "
"the candidate paths that remain are not always distinguishable by which one "
"exists. So the export reads each document on its own, where its directory is "
"still known, and keys the result on the block body."
msgstr ""

#. type: paragraph
#: configuration.org:1173
msgid ""
"Fourth, noweb references link to the block that defines them, and a "
"referenced block is headed by its own name. A tangled file is assembled from "
"expansions scattered across the whole document, so following one by reading "
"is otherwise a search. The reference is swapped for a placeholder before "
"fontification and restored afterwards, because =nix-ts-mode= reads a "
"reference as a search path and scatters it over syntax spans that no "
"rewriting of the fontified markup can reliably put back together."
msgstr ""

#. type: paragraph in src
#: configuration.org:1182
#, no-wrap
msgid ""
"(require 'cl-lib)\n"
"(require 'org)\n"
"(require 'ox-html)\n"
"(require 'htmlize)\n"
"(require 'nix-ts-mode)"
msgstr ""

#. type: paragraph in src
#: configuration.org:1188
#, no-wrap
msgid ""
"(add-to-list 'org-src-lang-modes '(\"nix\" . nix-ts))\n"
"(setq treesit-font-lock-level 4)"
msgstr ""

#. type: paragraph in src
#: configuration.org:1191
#, no-wrap
msgid ""
";; Emit `org-*' class names on syntax spans instead of inline color styles, "
"so\n"
";; assets/org-html.css owns the palette and can restyle code for dark "
"mode.\n"
";; Inline colors would freeze one theme into the markup.\n"
"(setq org-html-htmlize-output-type 'css)"
msgstr ""

#. type: paragraph in src
#: configuration.org:1196
#, no-wrap
msgid ""
";; Export five headline levels as real headings (default is 3). Deeper "
"sections\n"
";; would otherwise become plain lists with no anchor, and the sticky "
"breadcrumb\n"
";; only pins actual headings; five keeps every level within valid h2..h6 "
"tags.\n"
"(setq org-export-headline-levels 5)"
msgstr ""

#. type: paragraph in src
#: configuration.org:1201
#, no-wrap
msgid ""
";; The frame styling is my own; drop Org's default <style> and scripts.\n"
"(setq org-html-head-include-default-style nil\n"
"      org-html-head-include-scripts nil)"
msgstr ""

#. type: paragraph in src
#: configuration.org:1205
#, no-wrap
msgid ""
";; Don't abort the whole documentation build over one dangling link. The\n"
";; Japanese document is generated by po4a, so a paragraph that is still\n"
";; untranslated falls back to English while its target heading is already\n"
";; localized, leaving a fuzzy link with no matching anchor. Export it as "
"plain\n"
";; text instead of erroring so translation lag never takes the site down.\n"
"(setq org-export-with-broken-links t)"
msgstr ""

#. type: paragraph in src
#: configuration.org:1212
#, no-wrap
msgid ""
";; Inline the stylesheet and script rather than <link>/<script src>-ing "
"them, so\n"
";; each exported file (index.html and ja/index.html live at different "
"depths) is\n"
";; self-contained and needs no path juggling or extra request. The script "
"only\n"
";; enhances (breadcrumb bar, on-this-page rail, copy buttons); the page is\n"
";; readable without it.\n"
"(defun dotfiles-slurp (path)\n"
"  (with-temp-buffer\n"
"    (insert-file-contents path)\n"
"    (buffer-string)))"
msgstr ""

#. type: paragraph in src
#: configuration.org:1222
#, no-wrap
msgid ""
"(setq org-html-head\n"
"      (concat \"<style>\\n\" (dotfiles-slurp \"assets/org-html.css\") "
"\"</style>\\n\"\n"
"              \"<script>\\n\" (dotfiles-slurp \"assets/org-html.js\") "
"\"</script>\"))"
msgstr ""

#. type: paragraph in src
#: configuration.org:1226
#, no-wrap
msgid ""
";; Fold the table of contents: rewrite Org's #table-of-contents <div> into "
"a\n"
";; native <details> so the long, deeply nested TOC does not push the body "
"down.\n"
";; The block contains only list markup, so the first \"</div></div>\" "
"reliably\n"
";; closes it. The title capture keeps this language-agnostic (en/ja).\n"
"(defun dotfiles-html-collapse-toc (output _backend _info)\n"
"  (replace-regexp-in-string\n"
"   (concat \"<div id=\\\"table-of-contents\\\"[^>]*>\\n\"\n"
"           \"<h2>\\\\([^<]*\\\\)</h2>\\n\"\n"
"           \"<div id=\\\"text-table-of-contents\\\"[^>]*>\\n\"\n"
"           \"\\\\(\\\\(?:.\\\\|\\n\\\\)*?\\\\)\\n\"\n"
"           \"</div>\\n</div>\")\n"
"   (concat \"<details id=\\\"table-of-contents\\\" class=\\\"toc\\\" "
"open>\\n\"\n"
"           \"<summary>\\\\1</summary>\\n\"\n"
"           \"<div id=\\\"text-table-of-contents\\\" "
"role=\\\"doc-toc\\\">\\n\"\n"
"           \"\\\\2\\n</div>\\n</details>\")\n"
"   output t))"
msgstr ""

#. type: paragraph in src
#: configuration.org:1243
#, no-wrap
msgid "(add-to-list 'org-export-filter-final-output-functions"
msgstr ""

#. type: paragraph in src
#: configuration.org:1246
#, no-wrap
msgid ""
";; Head every code block with the file it tangles to, linked to GitHub.\n"
";;\n"
";; The target cannot be read off the block at export time. `#+INCLUDE' "
"splices\n"
";; the child documents into configuration.org and leaves no trace of where "
"each\n"
";; block came from, while `:tangle' paths are relative to the document "
"that\n"
";; declares them (modules/configuration.org writes \"features/nix.nix\" "
"for\n"
";; modules/features/nix.nix). Resolving by \"which candidate path exists\" "
"is\n"
";; ambiguous: overlays/configuration.org tangles to \"default.nix\", and "
"both\n"
";; overlays/default.nix and modules/default.nix are real files. So read "
"each\n"
";; document separately, while its directory is still known, and key on the "
"block\n"
";; body, which #+INCLUDE copies verbatim.\n"
"(defconst dotfiles-source-url "
"\"https://github.com/natsukium/dotfiles/blob/main/\")"
msgstr ""

#. type: paragraph in src
#: configuration.org:1259
#, no-wrap
msgid ""
";; Documents that declare `:tangle' targets, and the prefix their paths "
"are\n"
";; relative to; mirrors the addprefix calls in the Makefile's tangle "
"rules.\n"
";; modules/features/emacs/{early-init,init}.org are left out on purpose: "
"their\n"
";; blocks carry no `:tangle' header, and Nix assembles them into init.el "
"at\n"
";; build time, so no file in the repository corresponds to them.\n"
"(defconst dotfiles-tangle-sources\n"
"  '((\"configuration\" . \"\")\n"
"    (\"modules/configuration\" . \"modules/\")\n"
"    (\"overlays/configuration\" . \"overlays/\")))"
msgstr ""

#. type: paragraph in src
#: configuration.org:1269
#, no-wrap
msgid "(defvar dotfiles-tangle-map nil)"
msgstr ""

#. type: paragraph in src
#: configuration.org:1271
#, no-wrap
msgid ""
"(defun dotfiles-src-block-target (src-block prefix)\n"
"  \"Repo-relative file SRC-BLOCK tangles to, or nil when it tangles "
"nowhere.\"\n"
"  (let ((params (or (org-element-property :parameters src-block) \"\")))\n"
"    ;; `\\s-' rather than a literal space on purpose: the Makefile finds "
"what to\n"
"    ;; tangle by grepping this document for a `:tangle' header followed by "
"a\n"
"    ;; space, so a space here would offer it this regexp as a file to "
"build.\n"
"    (when (string-match \":tangle\\\\s-+\\\\([^ ]+\\\\)\" params)\n"
"      ;; Capture before the next `string-match' overwrites the match data.\n"
"      (let ((target (match-string 1 params)))\n"
"        (unless (or (equal target \"no\")\n"
"                    ;; Never exported, so never rendered. Skipping these "
"also\n"
"                    ;; keeps the boilerplate stubs, which repeat verbatim "
"across\n"
"                    ;; documents, from colliding in the map.\n"
"                    (string-match \":exports\\\\s-+none\" params))\n"
"          (concat prefix target))))))"
msgstr ""

#. type: paragraph in src
#: configuration.org:1287
#, no-wrap
msgid ""
"(defun dotfiles-build-tangle-map (suffix)\n"
"  \"Map each exported block body to the file it tangles to.\n"
"SUFFIX is \\\"\\\" for the English document and \\\".ja\\\" for the "
"translated one. The\n"
"map is rebuilt per language because po4a translates comments inside code, "
"which\n"
"changes the body it is keyed on.\"\n"
"  (let ((map (make-hash-table :test 'equal)))\n"
"    (dolist (source dotfiles-tangle-sources map)\n"
"      (with-current-buffer (find-file-noselect (concat (car source) suffix "
"\".org\"))\n"
"        (org-element-map (org-element-parse-buffer) 'src-block\n"
"          (lambda (src-block)\n"
"            (let ((target (dotfiles-src-block-target src-block (cdr "
"source))))\n"
"              (when target\n"
"                (let* ((body (org-element-property :value src-block))\n"
"                       (previous (gethash body map)))\n"
"                  ;; Keying on the body is only sound while no two "
"exported\n"
"                  ;; blocks share one. Fail loudly rather than link to the "
"wrong\n"
"                  ;; file if that ever stops holding.\n"
"                  (when (and previous (not (equal previous target)))\n"
"                    (error \"Blocks tangling to %s and %s have identical "
"bodies\"\n"
"                           previous target))\n"
"                  (puthash body target map))))))))))"
msgstr ""

#. type: paragraph in src
#: configuration.org:1309
#, no-wrap
msgid ""
";; Turn noweb references into links to the block that defines them, so the\n"
";; expansions a tangled file is assembled from can be followed by reading.\n"
"(defvar dotfiles-noweb-names nil\n"
"  \"Block names that unambiguously identify one block in the current "
"export.\")"
msgstr ""

#. type: paragraph in src
#: configuration.org:1314
#, no-wrap
msgid ""
"(defun dotfiles-collect-noweb-names (tree _backend _info)\n"
"  \"Record every block name defined exactly once in TREE.\n"
"A name used twice cannot be anchored: names are scoped to the document "
"that\n"
"declares them, but #+INCLUDE merges every document into one page, where an "
"id\n"
"has to be unique. nix-config, defined by both configuration.org and\n"
"modules/configuration.org, is the only one here, and stays unlinked.\"\n"
"  (let ((counts (make-hash-table :test 'equal)))\n"
"    (org-element-map tree 'src-block\n"
"      (lambda (src-block)\n"
"        (let ((name (org-element-property :name src-block)))\n"
"          (when name (puthash name (1+ (gethash name counts 0)) "
"counts)))))\n"
"    (setq dotfiles-noweb-names (make-hash-table :test 'equal))\n"
"    (maphash (lambda (name count)\n"
"               (when (= count 1) (puthash name t dotfiles-noweb-names)))\n"
"             counts))\n"
"  tree)"
msgstr ""

#. type: paragraph in src
#: configuration.org:1331 configuration.org:1509
#, no-wrap
msgid "(add-to-list 'org-export-filter-parse-tree-functions"
msgstr ""

#. type: paragraph in src
#: configuration.org:1334
#, no-wrap
msgid ""
"(defconst dotfiles-noweb-token \"nowebref0%s0\"\n"
"  \"Stand-in for a noweb reference while its block is fontified.\")"
msgstr ""

#. type: paragraph in src
#: configuration.org:1337
#, no-wrap
msgid ""
"(defun dotfiles-noweb-anchor (name)\n"
"  \"Element id for the block that defines noweb reference NAME.\n"
"Namespaced because a block is usually named after the section documenting "
"it,\n"
"so its name and that heading's slug are the same string. Headings win the "
"bare\n"
"name: theirs are the URLs worth sharing.\"\n"
"  (concat \"noweb-\" name))"
msgstr ""

#. type: paragraph in src
#: configuration.org:1344
#, no-wrap
msgid ""
"(defun dotfiles-noweb-html (name)\n"
"  \"Rendered reference to NAME, linked when NAME is anchored.\"\n"
"  (if (gethash name dotfiles-noweb-names)\n"
"      (format \"<a class=\\\"noweb-ref\\\" "
"href=\\\"#%s\\\">&lt;&lt;%s&gt;&gt;</a>\"\n"
"              (dotfiles-noweb-anchor name) name)\n"
"    (format \"&lt;&lt;%s&gt;&gt;\" name)))"
msgstr ""

#. type: paragraph in src
#: configuration.org:1351
#, no-wrap
msgid ""
"(defun dotfiles-fontify-noweb (original code lang &rest args)\n"
"  \"Swap noweb references out of CODE, fontify, then restore them as "
"links.\n"
"Rewriting the fontified markup instead is not viable: nix-ts-mode reads a\n"
"reference as a search path and splits it across spans seven different ways\n"
"depending on the surrounding syntax, and three of those straddle span\n"
"boundaries, so replacing them would unbalance the markup. A bare identifier "
"is\n"
"a single token in any grammar, so it survives fontification in one piece "
"and\n"
"can be swapped back without touching a tag.\"\n"
"  (let (names)\n"
"    (setq code\n"
"          (replace-regexp-in-string\n"
"           \"<<\\\\([a-zA-Z0-9_-]+\\\\)>>\"\n"
"           (lambda (match)\n"
"             (let ((name (match-string 1 match)))\n"
"               (push name names)\n"
"               (format dotfiles-noweb-token name)))\n"
"           code t t))\n"
"    (let ((html (apply original code lang args)))\n"
"      (dolist (name (delete-dups names) html)\n"
"        (setq html (replace-regexp-in-string\n"
"                    (regexp-quote (format dotfiles-noweb-token name))\n"
"                    (dotfiles-noweb-html name)\n"
"                    html t t))))))"
msgstr ""

