#. type: heading **
#: modules/configuration.org:3304
#, no-wrap
msgid "Emacs"
msgstr ""

#. type: paragraph
#: modules/configuration.org:3306
msgid ""
"Emacs has been my second-most-used editor since early 2026. The draw is "
"=org-mode= — the workflows built around =org-capture= and =org-agenda= are "
"slowly winning me over, and a widening set of daily inputs (email, RSS "
"feeds, and more) now lives inside emacs, where the ongoing experiment is "
"wiring each of them back into org."
msgstr ""

#. type: paragraph
#: modules/configuration.org:3312
msgid ""
"The feature lives alongside Neovim under =features/emacs/= and pulls the "
"same double duty:"
msgstr ""

#. type: plain list 1.
#: modules/configuration.org:3321
#, no-wrap
msgid ""
"=perSystem.packages.emacs= exposes a wrapped emacs as a flake\n"
"output: a launcher that seeds a writable directory under\n"
"=XDG_CACHE_HOME= with the tangled init files and starts emacs with\n"
"=--init-directory=. =nix run .#emacs= therefore shows this config\n"
"as-is, even on a machine whose owner has their own\n"
"=~/.config/emacs=."
msgstr ""

#. type: plain list 2.
#: modules/configuration.org:3327
#, no-wrap
msgid ""
"=flake.modules.homeManager.emacs= registers the module in the internal\n"
"registry — not the public =homeManagerModules= export, since the =my.*=\n"
"options make it opinionated — and adds =my.programs.emacs.enable= for\n"
"home-manager hosts, wiring up =services.emacs= (daemon), the tangled\n"
"=~/.config/emacs/{init,early-init}.el=, and the encrypted\n"
"=~/.authinfo.age=."
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3330
#, no-wrap
msgid ""
"{ lib, inputs, ... }:\n"
"let\n"
"  withEmacsOverlay = pkgs: pkgs.extend "
"inputs.emacs-overlay.overlays.default;"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3334
#, no-wrap
msgid ""
"emacsUnwrapped =\n"
"  pkgs:\n"
"  let\n"
"    epkgs = withEmacsOverlay pkgs;\n"
"  in\n"
"  if pkgs.stdenv.hostPlatform.isDarwin then epkgs.emacs-plus else "
"epkgs.emacs-pgtk;"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3347
#, no-wrap
msgid ""
"tangle =\n"
"  pkgs:\n"
"  {\n"
"    name,\n"
"    org,\n"
"  }:\n"
"  pkgs.runCommand name { nativeBuildInputs = [ (emacsUnwrapped pkgs) ]; } "
"''\n"
"    cp ${org} tmp.org\n"
"    emacs -Q --batch --eval \\\n"
"      \"(progn\n"
"        (require 'ob-tangle)\n"
"        (org-babel-tangle-file \\\"tmp.org\\\" \\\"emacs-lisp\\\"))\"\n"
"    {\n"
"      echo \";;; -*- lexical-binding: t; -*-\"\n"
"      cat emacs-lisp\n"
"    } > $out\n"
"  '';"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3365
#, no-wrap
msgid ""
"tangleEl =\n"
"  pkgs: org:\n"
"  let\n"
"    stem = name: lib.head (lib.splitString \".\" name);\n"
"  in\n"
"  tangle pkgs {\n"
"    name = \"${stem (baseNameOf (toString org))}.el\";\n"
"    inherit org;\n"
"  };"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3375
#, no-wrap
msgid ""
"mkEmacs =\n"
"  pkgs:\n"
"  (withEmacsOverlay pkgs).callPackage ./package.nix {\n"
"    org-clickup-src = inputs.org-clickup;\n"
"  };"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3388
#, no-wrap
msgid ""
"  mkStandalone =\n"
"    pkgs:\n"
"    let\n"
"      emacs = mkEmacs pkgs;\n"
"      emacsBin =\n"
"        if pkgs.stdenv.hostPlatform.isDarwin then\n"
"          \"${emacs}/Applications/Emacs.app/Contents/MacOS/Emacs\"\n"
"        else\n"
"          \"${emacs}/bin/emacs\";\n"
"    in\n"
"    pkgs.writeShellScriptBin \"emacs\" ''\n"
"      dir=\"''${XDG_CACHE_HOME:-$HOME/.cache}/natsukium-emacs\"\n"
"      mkdir -p \"$dir\"\n"
"      ln -sf ${tangleEl pkgs ./init.org} \"$dir/init.el\"\n"
"      ln -sf ${tangleEl pkgs ./early-init.org} \"$dir/early-init.el\"\n"
"      exec ${emacsBin} --init-directory \"$dir\" \"$@\"\n"
"    '';\n"
"in\n"
"{\n"
"  flake.modules.homeManager.emacs =\n"
"    {\n"
"      config,\n"
"      lib,\n"
"      pkgs,\n"
"      ...\n"
"    }:\n"
"    {\n"
"      options.my.programs.emacs.enable = lib.mkEnableOption \"emacs\";"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3417
#, no-wrap
msgid ""
"config = lib.mkIf config.my.programs.emacs.enable {\n"
"  programs.emacs = {\n"
"    enable = true;\n"
"    package = mkEmacs pkgs;\n"
"  };"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3423
#, no-wrap
msgid ""
"services.emacs = {\n"
"  enable = true;\n"
"  client.enable = true;\n"
"};"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3428
#, no-wrap
msgid "<<emacs-daemon-path>>"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3430
#, no-wrap
msgid ""
"xdg.configFile.\"emacs/init.el\".source = tangleEl pkgs ./init.org;\n"
"xdg.configFile.\"emacs/early-init.el\".source = tangleEl pkgs "
"./early-init.org;\n"
"home.file.\".authinfo.age\".source = ./authinfo.age;"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3434
#, no-wrap
msgid ""
"    home.shellAliases = lib.optionalAttrs pkgs.stdenv.hostPlatform.isDarwin "
"{\n"
"      emacs = "
"\"${config.programs.emacs.package}/Applications/Emacs.app/Contents/MacOS/Emacs\";\n"
"    };\n"
"  };\n"
"};"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3440
#, no-wrap
msgid ""
"  perSystem =\n"
"    { pkgs, ... }:\n"
"    {\n"
"      packages.emacs = mkStandalone pkgs;\n"
"    };\n"
"}"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3449
#, no-wrap
msgid ""
"{\n"
"  stdenv,\n"
"  age,\n"
"  beancount,\n"
"  beancount-language-server,\n"
"  difftastic,\n"
"  emacs-pgtk,\n"
"  emacs-plus,\n"
"  emacsWithPackagesFromUsePackage,\n"
"  gettext,\n"
"  nixd,\n"
"  nixfmt,\n"
"  terraform-ls,\n"
