msgstr ""

#. type: paragraph in src
#: modules/features/editor/emacs/init.org:1297
#, no-wrap
msgid ""
";; Example configuration for Consult\n"
"(use-package consult\n"
"  :ensure t\n"
"  ;; Replace bindings. Lazily loaded by `use-package'.\n"
"  :bind (;; C-c bindings in `mode-specific-map'\n"
"         (\"C-c M-x\" . consult-mode-command)\n"
"         (\"C-c h\" . consult-history)\n"
"         (\"C-c k\" . consult-kmacro)\n"
"         (\"C-c m\" . consult-man)\n"
"         (\"C-c i\" . consult-info)\n"
"         ([remap Info-search] . consult-info)\n"
"         ;; C-x bindings in `ctl-x-map'\n"
"         (\"C-x M-:\" . consult-complex-command)     ;; "
"orig. repeat-complex-command\n"
"         (\"C-x b\" . consult-buffer)                ;; "
"orig. switch-to-buffer\n"
"         (\"C-x 4 b\" . consult-buffer-other-window) ;; "
"orig. switch-to-buffer-other-window\n"
"         (\"C-x 5 b\" . consult-buffer-other-frame)  ;; "
"orig. switch-to-buffer-other-frame\n"
"         (\"C-x t b\" . consult-buffer-other-tab)    ;; "
"orig. switch-to-buffer-other-tab\n"
"         (\"C-x r b\" . consult-bookmark)            ;; "
"orig. bookmark-jump\n"
"         (\"C-x p b\" . consult-project-buffer)      ;; "
"orig. project-switch-to-buffer\n"
"         ;; Custom M-# bindings for fast register access\n"
"         (\"M-#\" . consult-register-load)\n"
"         (\"M-'\" . consult-register-store)          ;; "
"orig. abbrev-prefix-mark (unrelated)\n"
"         (\"C-M-#\" . consult-register)\n"
"         ;; Other custom bindings\n"
"         (\"M-y\" . consult-yank-pop)                ;; orig. yank-pop\n"
"         ;; M-g bindings in `goto-map'\n"
"         (\"M-g e\" . consult-compile-error)\n"
"         (\"M-g f\" . consult-flymake)               ;; Alternative: "
"consult-flycheck\n"
"         (\"M-g g\" . consult-goto-line)             ;; orig. goto-line\n"
"         (\"M-g M-g\" . consult-goto-line)           ;; orig. goto-line\n"
"         (\"M-g o\" . consult-outline)               ;; Alternative: "
"consult-org-heading\n"
"         (\"M-g m\" . consult-mark)\n"
"         (\"M-g k\" . consult-global-mark)\n"
"         (\"M-g i\" . consult-imenu)\n"
"         (\"M-g I\" . consult-imenu-multi)\n"
"         ;; M-s bindings in `search-map'\n"
"         (\"M-s d\" . consult-find)                  ;; Alternative: "
"consult-fd\n"
"         (\"M-s c\" . consult-locate)\n"
"         (\"M-s g\" . consult-grep)\n"
"         (\"M-s G\" . consult-git-grep)\n"
"         (\"M-s r\" . consult-ripgrep)\n"
"         (\"M-s l\" . consult-line)\n"
"         (\"M-s L\" . consult-line-multi)\n"
"         (\"M-s k\" . consult-keep-lines)\n"
"         (\"M-s u\" . consult-focus-lines)\n"
"         ;; Isearch integration\n"
"         (\"M-s e\" . consult-isearch-history)\n"
"         :map isearch-mode-map\n"
"         (\"M-e\" . consult-isearch-history)         ;; "
"orig. isearch-edit-string\n"
"         (\"M-s e\" . consult-isearch-history)       ;; "
"orig. isearch-edit-string\n"
"         (\"M-s l\" . consult-line)                  ;; needed by "
"consult-line to detect isearch\n"
"         (\"M-s L\" . consult-line-multi)            ;; needed by "
"consult-line to detect isearch\n"
"         ;; Minibuffer history\n"
"         :map minibuffer-local-map\n"
"         (\"M-s\" . consult-history)                 ;; "
"orig. next-matching-history-element\n"
"         (\"M-r\" . consult-history))                ;; "
"orig. previous-matching-history-element"
msgstr ""

#. type: paragraph in src
#: modules/features/editor/emacs/init.org:1354
#, no-wrap
msgid ""
";; The :init configuration is always executed (Not lazy)\n"
":init"
msgstr ""

#. type: paragraph in src
#: modules/features/editor/emacs/init.org:1357
#, no-wrap
msgid ""
";; Tweak the register preview for `consult-register-load',\n"
";; `consult-register-store' and the built-in commands.  This improves the\n"
";; register formatting, adds thin separator lines, register sorting and "
"hides\n"
";; the window mode line.\n"
"(advice-add #'register-preview :override #'consult-register-window)\n"
"(setq register-preview-delay 0.5)"
msgstr ""

#. type: paragraph in src
#: modules/features/editor/emacs/init.org:1364
#, no-wrap
msgid ""
";; Use Consult to select xref locations with preview\n"
"(setq xref-show-xrefs-function #'consult-xref\n"
"      xref-show-definitions-function #'consult-xref)"
msgstr ""

#. type: paragraph in src
#: modules/features/editor/emacs/init.org:1368
#, no-wrap
msgid ""
";; Configure other variables and modes in the :config section,\n"
";; after lazily loading the package.\n"
":config"
msgstr ""

#. type: paragraph in src
#: modules/features/editor/emacs/init.org:1372
#, no-wrap
msgid ""
";; Optionally configure preview. The default value\n"
";; is 'any, such that any key triggers the preview.\n"
";; (setq consult-preview-key 'any)\n"
";; (setq consult-preview-key \"M-.\")\n"
";; (setq consult-preview-key '(\"S-<down>\" \"S-<up>\"))\n"
";; For some commands and buffer sources it is useful to configure the\n"
";; :preview-key on a per-command basis using the `consult-customize' "
"macro.\n"
"(consult-customize\n"
" consult-theme :preview-key '(:debounce 0.2 any)\n"
" consult-ripgrep consult-git-grep consult-grep consult-man\n"
" consult-bookmark consult-recent-file consult-xref\n"
" consult-source-bookmark consult-source-file-register\n"
" consult-source-recent-file consult-source-project-recent-file\n"
" ;; :preview-key \"M-.\"\n"
" :preview-key '(:debounce 0.4 any))"
msgstr ""

#. type: paragraph in src
#: modules/features/editor/emacs/init.org:1388
#, no-wrap
msgid ""
";; Optionally configure the narrowing key.\n"
";; Both < and C-+ work reasonably well.\n"
"(setq consult-narrow-key \"<\") ;; \"C-+\""
msgstr ""

#. type: paragraph in src
#: modules/features/editor/emacs/init.org:1392
#, no-wrap
msgid ""
"  ;; Optionally make narrowing help available in the minibuffer.\n"
"  ;; You may want to use `embark-prefix-help-command' or which-key "
"instead.\n"
"  ;; (keymap-set consult-narrow-map (concat consult-narrow-key \" ?\") "
"#'consult-narrow-help)\n"
")"
msgstr ""

#. type: paragraph in src
#: modules/features/editor/emacs/init.org:1399
#, no-wrap
msgid ""
"(use-package embark-consult\n"
"  :ensure t\n"
"  :after (consult embark))"
msgstr ""

#. type: heading **
#: modules/features/editor/emacs/init.org:1404
#, no-wrap
msgid "compilation"
msgstr ""

#. type: paragraph
#: modules/features/editor/emacs/init.org:1406
msgid ""
"The compilation buffer does not inherit from comint-mode, so ANSI escape "
"sequences are displayed as raw text by default.  Adding "
"=ansi-color-compilation-filter= to the compilation filter hook interprets "
"these sequences and renders them as colors."
msgstr ""

#. type: paragraph in src
#: modules/features/editor/emacs/init.org:1412
#, no-wrap
msgid "(add-hook 'compilation-filter-hook 'ansi-color-compilation-filter)"
msgstr ""

#. type: heading **
#: modules/features/editor/emacs/init.org:1415
#, no-wrap
msgid "copy-region-reference"
msgstr ""

#. type: paragraph
#: modules/features/editor/emacs/init.org:1417
msgid ""
"Copy the absolute path and line range of the selected region in "
"=file:start-end= format (e.g. =/path/to/file.el:10-20=).  Pasting the result "
"into a coding agent's prompt gives it an unambiguous file reference to work "
"with."
msgstr ""

#. type: paragraph in src
#: modules/features/editor/emacs/init.org:1423
#, no-wrap
msgid ""
"(defun my/copy-region-reference (start end)\n"
"  \"Copy the file path and line range of the current region to the "
"clipboard.\n"
"The format is \\\"/path/to/file:START-END\\\".\"\n"
"  (interactive \"r\")\n"
"  (let* ((file (buffer-file-name))\n"
"         (line-start (line-number-at-pos start))\n"
"         (line-end (line-number-at-pos (1- end)))\n"
"         (ref (format \"%s:%d-%d\" file line-start line-end)))\n"
"    (kill-new ref)\n"
"    (message \"%s\" ref)))"
msgstr ""

#. type: paragraph in src
#: modules/features/editor/emacs/init.org:1434
#, no-wrap
msgid "(global-set-key (kbd \"C-c r\") #'my/copy-region-reference)"
msgstr ""

#. type: heading **
#: modules/features/editor/emacs/init.org:1437
#, no-wrap
msgid "Others"
msgstr ""

#. type: paragraph in src
#: modules/features/editor/emacs/init.org:1439
#, no-wrap
msgid "(which-key-mode)"
msgstr ""

#. type: paragraph in src
#: modules/features/editor/emacs/init.org:1441
#, no-wrap
msgid "(setq-default indent-tabs-mode nil)"
msgstr ""

#. type: paragraph in src
#: modules/features/editor/emacs/init.org:1443
#, no-wrap
msgid ""
";; org-tempo provides the \"<s TAB\" snippet expansion.  At top level, both "
"this\n"
";; require and org-babel-do-load-languages (autoloaded from org.el) pull "
"all\n"
";; of Org into startup (~1s), so they wait here until something loads Org.\n"
"(with-eval-after-load 'org\n"
"  (require 'org-tempo)\n"
"  (org-babel-do-load-languages\n"
"   'org-babel-load-languages\n"
"   '((shell . t))))"
msgstr ""

#. type: paragraph in src
#: modules/features/editor/emacs/init.org:1452
#, no-wrap
msgid "(setq org-src-preserve-indentation t)"
msgstr ""

#. type: heading ***
#: modules/features/editor/emacs/init.org:1455
#, no-wrap
msgid "project.el"
msgstr ""

#. type: paragraph
#: modules/features/editor/emacs/init.org:1457
msgid ""
"Register all repositories cloned by ghq (https://github.com/x-motemen/ghq) "
"as projects."
msgstr ""

#. type: paragraph
#: modules/features/editor/emacs/init.org:1459
msgid "Specifically, directories under =~/src/$ACCOUNT/$VCS_HOST/$OWNER/$REPO=."
msgstr ""

#. type: paragraph in src
#: modules/features/editor/emacs/init.org:1462
#, no-wrap
msgid ""
"(defun my/sync-project-list ()\n"
"  \"Find all projects under ~/src and synchronize the project-list-file.\"\n"
"  (interactive)\n"
"  (let* (;; 1. Retrieve directory list as a string using find command\n"
"         (command (format \"find %s -mindepth 4 -maxdepth 4 -type d\"\n"
"                          (expand-file-name \"~/src\")))\n"
"         (dir-list-string (shell-command-to-string command))\n"
"         ;; 2. Split string by newlines and exclude empty lines to create a "
"list\n"
"         (dirs (split-string dir-list-string \"\\n\" t)))"
msgstr ""

#. type: paragraph in src
#: modules/features/editor/emacs/init.org:1472
#, no-wrap
msgid ""
";; 3. Build file contents in a temporary buffer\n"
"(with-temp-buffer\n"
"  (insert \";;; -*- lisp-data -*-\\n\")\n"
"  (insert \"(\\n\")\n"
"  (dolist (dir dirs)\n"
"    (insert (format \" (\\\"%s/\\\")\\n\" dir)))\n"
"  (insert \")\\n\")"
msgstr ""

#. type: paragraph in src
#: modules/features/editor/emacs/init.org:1480
#, no-wrap
msgid ""
";; 4. Write the built contents to file\n"
"(write-file project-list-file))))"
msgstr ""

#. type: paragraph in src
#: modules/features/editor/emacs/init.org:1483
#, no-wrap
msgid "(my/sync-project-list)"
msgstr ""

#. type: paragraph
#: modules/features/editor/emacs/init.org:1486
msgid ""
"Sort the project list by modification time, placing recently updated "
"projects first."
msgstr ""

#. type: paragraph
#: modules/features/editor/emacs/init.org:1488
msgid ""
"Using advice instead of sorting in =my/sync-project-list= ensures that "
"projects are sorted by their current mtime at selection time, not at file "
"generation time.  This keeps the order fresh even during long Emacs "
"sessions."
msgstr ""

#. type: paragraph in src
#: modules/features/editor/emacs/init.org:1493
#, no-wrap
msgid ""
"(defun my/sort-projects-by-mtime (projects)\n"
"  \"Sort PROJECTS by modification time, most recent first.\"\n"
"  (sort projects\n"
"        (lambda (a b)\n"
"          (let ((time-a (file-attribute-modification-time\n"
"                         (file-attributes a)))\n"
"                (time-b (file-attribute-modification-time\n"
"                         (file-attributes b))))\n"
"            (time-less-p time-b time-a)))))"
msgstr ""

#. type: paragraph in src
#: modules/features/editor/emacs/init.org:1503
#, no-wrap
msgid "(advice-add 'project-known-project-roots :filter-return"
msgstr ""

#. type: heading **
#: modules/features/editor/emacs/early-init.org:3
#, no-wrap
msgid "disable some bars"
msgstr ""

#. type: paragraph
#: modules/features/editor/emacs/early-init.org:5
msgid ""
"The tool bar duplicates functionality already accessible via keybindings and "
"the menu bar, while the vertical scroll bar wastes horizontal space without "
"providing useful navigation—line numbers and modeline indicators are more "
"precise.  Setting these in ~default-frame-alist~ rather than calling "
"~tool-bar-mode~ / ~scroll-bar-mode~ avoids a brief flash of the bars during "
"startup before the modes disable them."
msgstr ""

#. type: paragraph in src
#: modules/features/editor/emacs/early-init.org:13
#, no-wrap
msgid ""
"(push '(tool-bar-lines . 0) default-frame-alist)\n"
"(push '(vertical-scroll-bars) default-frame-alist)"
msgstr ""

#. type: heading **
#: modules/features/editor/emacs/early-init.org:17
#, no-wrap
msgid "turn off the annoying bell"
msgstr ""

#. type: paragraph
#: modules/features/editor/emacs/early-init.org:19
msgid ""
"The default audible bell is distracting and provides no actionable "
"information.  Replacing it with ~ignore~ silences it entirely; a visual bell "
"(~visible-bell~) was not chosen because the screen flash is equally "
"disruptive."
msgstr ""

#. type: paragraph in src
#: modules/features/editor/emacs/early-init.org:25
#, no-wrap
msgid "(setq ring-bell-function 'ignore)"
msgstr ""

#. type: heading **
#: modules/features/editor/emacs/early-init.org:28
#, no-wrap
msgid "disable backup files"
msgstr ""

#. type: paragraph
#: modules/features/editor/emacs/early-init.org:30
msgid ""
"Emacs already skips backup files for version-controlled files by default "
"(~vc-make-backup-files~ is ~nil~), but files outside of a repository still "
"produce backups.  Since virtually all editing happens in Git-managed trees, "
"the remaining cases are rare enough that the clutter outweighs the safety "
"net.  Auto-save files are likewise redundant when unsaved work can be "
"recovered through Git stashes or reflog."
msgstr ""

#. type: paragraph in src
#: modules/features/editor/emacs/early-init.org:38
#, no-wrap
msgid ""
"(setq make-backup-files nil)\n"
"(setq auto-save-default nil)"
msgstr ""

#. type: heading **
#: modules/features/editor/emacs/early-init.org:42
#, no-wrap
msgid "disable lock files"
msgstr ""

#. type: paragraph
#: modules/features/editor/emacs/early-init.org:44
msgid ""
"Lock files (~.#filename~) prevent concurrent editing across multiple Emacs "
"instances, but in a single-instance workflow they only clutter the working "
"directory and interfere with file watchers and build tools."
msgstr ""

#. type: paragraph in src
#: modules/features/editor/emacs/early-init.org:49
#, no-wrap
msgid "(setq create-lockfiles nil)"
msgstr ""

#. type: keyword OPTIONS
#: overlays/configuration.org:3 modules/configuration.org:3
#, no-wrap
msgid "^:{}"
msgstr ""

#. type: heading *
#: overlays/configuration.org:5 modules/configuration.org:5
#, no-wrap
msgid "Overview"
msgstr ""

#. type: paragraph
#: overlays/configuration.org:7
msgid ""
"This file defines nixpkgs overlays for patching broken packages, pinning "
"specific versions, and adding local workarounds. Each overlay modifies the "
"package set to address issues that would otherwise block the system build or "
"cause runtime problems."
msgstr ""

#. type: paragraph
#: overlays/configuration.org:11
msgid ""
"For details on overlay mechanics (=final: prev:= pattern, composition order, "
"etc.), see [[https://nixos.org/manual/nixpkgs/stable/#chap-overlays][nixpkgs "
"overlay documentation]]."
msgstr ""

#. type: paragraph
#: overlays/configuration.org:14
msgid ""
"Overlays are organized into five categories based on their purpose and "
"expected lifetime:"
msgstr ""

#. type: plain list -
#: overlays/configuration.org:18
#, no-wrap
msgid ""
"*stable*: Packages fetched from nixpkgs-stable when broken in unstable and "
"the fix would\n"
"trigger excessive rebuilds or is too complex to patch locally."
msgstr ""

#. type: plain list -
#: overlays/configuration.org:20
#, no-wrap
msgid ""
"*cuda*: Packages taken from the CUDA channel, the only revision whose CUDA "
"builds are\n"
"cached."
msgstr ""

#. type: plain list -
#: overlays/configuration.org:22
#, no-wrap
msgid ""
"*temporary-fix*: Local overrides (e.g., disabling tests) that don't require "
"a different\n"
"nixpkgs version. Remove once fixed upstream."
msgstr ""

#. type: plain list -
#: overlays/configuration.org:23
#, no-wrap
msgid ""
"*pre-release*: Alpha, beta, or pre-release packages for testing before they "
"land in nixpkgs."
msgstr ""

#. type: plain list -
#: overlays/configuration.org:25
#, no-wrap
msgid ""
"*patches*: Workarounds not suitable for upstream contribution (e.g., "
"locale-specific fixes,\n"
"local tooling shims). Expected to remain indefinitely."
msgstr ""

#. type: paragraph in src
#: overlays/configuration.org:32
#, no-wrap
msgid ""
"{ inputs }:\n"
"{\n"
"  <<stable>>"
msgstr ""

#. type: paragraph in src
#: overlays/configuration.org:36
#, no-wrap
msgid "<<cuda>>"
msgstr ""

#. type: paragraph in src
#: overlays/configuration.org:38
#, no-wrap
msgid "<<temporary-fix>>"
msgstr ""

#. type: paragraph in src
#: overlays/configuration.org:40
#, no-wrap
msgid "<<pre-release>>"
msgstr ""

#. type: paragraph in src
#: overlays/configuration.org:42
#, no-wrap
msgid ""
"  <<patches>>\n"
"}"
msgstr ""

#. type: keyword NAME
#: overlays/configuration.org:46 overlays/configuration.org:52
#, no-wrap
msgid "stable"
msgstr ""

#. type: paragraph
#: overlays/configuration.org:48
msgid ""
"Fetch packages from nixpkgs-stable when broken in unstable. This includes "
"cases where the upstream fix would trigger excessive rebuilds, or where the "
"issue is too complex to patch locally."
msgstr ""

#. type: paragraph in src
#: overlays/configuration.org:54
#, no-wrap
msgid ""
"stable = final: prev: {\n"
"};"
msgstr ""

#. type: keyword NAME
#: overlays/configuration.org:58 overlays/configuration.org:72
#, no-wrap
msgid "cuda"
msgstr ""

#. type: paragraph
#: overlays/configuration.org:60
msgid ""
"[[https://cache.nixos-cuda.org][cache.nixos-cuda.org]] only covers the head "
"of =nixos-unstable-cuda=, so kilimanjaro takes its CUDA packages from "
"=nixpkgs-cuda=. Naming =ollama= and =onnxruntime= is enough: =openvino=, "
"=opencv= and =cudnn-frontend= are only reachable through them."
msgstr ""

#. type: paragraph
#: overlays/configuration.org:64
msgid ""
"The package set is imported plain because the CUDA Hydra builds plain "
"nixpkgs, and a local overlay reaching into that closure would move the store "
"paths off the cache. The guard keeps the pin off hosts that leave "
"=cudaSupport= unset."
msgstr ""

#. type: paragraph
#: overlays/configuration.org:68
msgid ""
"Firefox takes onnxruntime as a build input on Linux since 141, and Calibre "
"does the same for its Python environment. A host-wide =cudaSupport= would "
"drag both applications off cache.nixos.org and rebuild their CUDA-enabled "
"onnxruntime dependencies from source."
msgstr ""

#. type: paragraph in src
#: overlays/configuration.org:74
#, no-wrap
msgid ""
"cuda =\n"
"  final: prev:\n"
"  prev.lib.optionalAttrs (prev.config.cudaSupport or false) (\n"
"    let\n"
"      pkgsWithCuda = import inputs.nixpkgs-cuda {\n"
"        inherit (prev.stdenv.hostPlatform) system;\n"
"        config = {\n"
"          cudaSupport = true;\n"
"          allowUnfree = true;\n"
"        };\n"
"      };\n"
"      pkgs = import inputs.nixpkgs {\n"
"        inherit (prev.stdenv.hostPlatform) system;\n"
"        config.allowUnfree = true;\n"
"      };\n"
"    in\n"
"    {\n"
"      inherit (pkgsWithCuda) onnxruntime ollama;\n"
"      firefox-unwrapped = prev.firefox-unwrapped.override {\n"
"        inherit (pkgs) onnxruntime;\n"
"      };\n"
"      calibre = pkgs.calibre;\n"
"    }\n"
"  );"
msgstr ""

#. type: keyword NAME
#: overlays/configuration.org:100 overlays/configuration.org:107
#, no-wrap
msgid "temporary-fix"
msgstr ""

#. type: paragraph
#: overlays/configuration.org:102
msgid ""
"Local overrides for packages that build but have failing tests or minor "
"issues.  Unlike the =stable= overlay, these don't require fetching packages "
"from a different nixpkgs branch. Overriding an attribute such as =doCheck=, "
"or applying a patch to the existing package, is enough. Remove these "
"overrides once the issues are fixed upstream."
msgstr ""

#. type: paragraph in src
#: overlays/configuration.org:109
#, no-wrap
msgid ""
"temporary-fix = final: prev: {\n"
"};"
msgstr ""

#. type: keyword NAME
#: overlays/configuration.org:113 overlays/configuration.org:119
#, no-wrap
msgid "pre-release"
msgstr ""

#. type: paragraph
#: overlays/configuration.org:115
msgid ""
"Overlay for testing alpha, beta, or pre-release versions of packages before "
"they land in nixpkgs. Useful for evaluating release candidates, nightly "
"builds, or packages pending upstream review. Once a package is available in "
"nixpkgs, remove it from this overlay."
msgstr ""

#. type: paragraph in src
#: overlays/configuration.org:121
#, no-wrap
msgid ""
"pre-release = final: prev: {\n"
"  <<mcp-grafana>>\n"
"};"
msgstr ""

#. type: keyword NAME
#: overlays/configuration.org:126 overlays/configuration.org:142
#, no-wrap
msgid "mcp-grafana"
msgstr ""

#. type: paragraph
#: overlays/configuration.org:128
msgid ""
"manyara serves Grafana over MCP behind caddy and to the hermes guest, so "
"both clients arrive with a =Host= that is not loopback. In 1.2.0 the "
"=--allowed-hosts= flag only reached mcp-grafana's own middleware: the mcp-go "
"server underneath kept its own loopback-only check and answered =invalid "
"Host header=. That check runs after caller authentication, so "
"unauthenticated probes returned 401 and looked healthy, while the one client "
"that actually held a token was the only one to see the 403. Upstream wired "
"the flag through to the inner server in 1.4.0."
msgstr ""

#. type: paragraph
#: overlays/configuration.org:136
msgid ""
"One dashboard test talks to a local test server and fails under the build "
"sandbox with a truncated response, so it is skipped rather than turning off "
"the whole suite."
msgstr ""

#. type: paragraph
#: overlays/configuration.org:140
msgid "Drop this once nixpkgs ships 1.4.0 or newer."
msgstr ""

#. type: paragraph in src
#: overlays/configuration.org:144
#, no-wrap
msgid ""
"mcp-grafana = prev.mcp-grafana.overrideAttrs (\n"
"  finalAttrs: _: {\n"
"    version = \"1.4.2\";\n"
"    src = final.fetchFromGitHub {\n"
"      owner = \"grafana\";\n"
"      repo = \"mcp-grafana\";\n"
"      tag = \"v${finalAttrs.version}\";\n"
"      hash = \"sha256-MUqVsrfjlDLanWzXzMVGYhlXjF23ovGm/ocz7A4vrxw=\";\n"
"    };\n"
"    vendorHash = \"sha256-y/Hk1hDQ00wHqTOcaoKVvz2PgF0ZiwHartbuF7qEkXc=\";\n"
"    checkFlags = [ \"-skip=TestFetchDashboardViaK8s_V2Refetch\" ];\n"
"  }\n"
");"
msgstr ""

#. type: keyword NAME
#: overlays/configuration.org:159 overlays/configuration.org:168
#, no-wrap
msgid "patches"
msgstr ""

#. type: paragraph
#: overlays/configuration.org:161
msgid "Workarounds that are not suitable for upstream contribution."
msgstr ""

#. type: paragraph
#: overlays/configuration.org:163
msgid ""
"These patches address issues that upstream would likely not accept—either "
"because they are specific to this configuration (e.g., locale settings), "
"bypass intended behavior, or solve problems in unconventional ways. Unlike "
"=temporary-fix=, these are expected to remain indefinitely."
msgstr ""

#. type: paragraph in src
#: overlays/configuration.org:170
#, no-wrap
msgid ""
"patches = final: prev: {\n"
"  <<gh-dash>>\n"
"  <<command-line-tools-shim>>\n"
"};"
msgstr ""

#. type: keyword NAME
#: overlays/configuration.org:176 overlays/configuration.org:189
#, no-wrap
msgid "gh-dash"
msgstr ""

#. type: paragraph
#: overlays/configuration.org:178
msgid ""
"The preview pane renders incorrectly when =LANG=ja_JP.UTF-8= is set. The "
"issue stems from gh-dash's terminal width calculation, which miscounts the "
"display width of certain UTF-8 characters (particularly CJK characters and "
"some emoji). This causes text wrapping and alignment to break."
msgstr ""

#. type: paragraph
#: overlays/configuration.org:183
msgid ""
"Setting =LANG=C.UTF-8= forces ASCII-compatible width calculations while "
"preserving UTF-8 encoding support, which fixes the rendering issue. We use "
"=writeShellApplication= to create a wrapper that sets this environment "
"variable before invoking the real binary."
msgstr ""

#. type: paragraph
#: overlays/configuration.org:187
msgid ""
"Reported upstream in "
"[[https://github.com/dlvhdr/gh-dash/issues/316][dlvhdr/gh-dash#316]]."
msgstr ""

#. type: paragraph in src
#: overlays/configuration.org:191
#, no-wrap
msgid ""
"gh-dash =\n"
"  (final.writeShellApplication {\n"
"    name = \"gh-dash\";\n"
"    text = ''\n"
"      LANG=C.UTF-8 ${final.lib.getExe prev.gh-dash} \"$@\"\n"
"    '';\n"
"  }).overrideAttrs\n"
"    { pname = \"gh-dash\"; };"
msgstr ""

#. type: heading **
#: overlays/configuration.org:201
#, no-wrap
msgid "mkShim"
msgstr ""

#. type: paragraph
#: overlays/configuration.org:203
msgid "Shim utility for providing stub implementations of macOS Command Line Tools."
msgstr ""

#. type: paragraph
#: overlays/configuration.org:205
msgid ""
"On darwin systems without Xcode Command Line Tools installed, invoking "
"commands like =cc= or =python3= triggers an annoying system popup prompting "
"installation.  These shims intercept such calls and either delegate to "
"Nix-provided tools or return appropriate exit codes, suppressing the popup "
"and preventing spurious build failures."
msgstr ""

#. type: paragraph
#: overlays/configuration.org:210
msgid ""
"See [[file:../pkgs/mkShim/][pkgs/mkShim]] for the implementation details and "
"list of shimmed commands."
msgstr ""

#. type: keyword NAME
#: overlays/configuration.org:212
#, no-wrap
msgid "command-line-tools-shim"
msgstr ""

#. type: paragraph in src
#: overlays/configuration.org:214
#, no-wrap
msgid "inherit (final.callPackage ../pkgs/mkShim { }) mkShim commandLineToolsShim;"
msgstr ""

#. type: paragraph
#: modules/configuration.org:7
msgid ""
"This file defines custom modules that extend the standard NixOS, nix-darwin, "
"and home-manager module systems. Each module addresses specific use cases or "
"provides opinionated defaults not available upstream."
msgstr ""

#. type: paragraph
#: modules/configuration.org:11
msgid ""
"Modules are organized by functional domain (e.g., Shell, Networking, Version "
"Control) rather than by module system target. When a domain contains both "
"system-level and user-level configuration, subheaders separate them "
"explicitly."
msgstr ""

#. type: paragraph
#: modules/configuration.org:17
msgid ""
"Nix package manager and nixpkgs configuration. These modules are shared "
"across NixOS and nix-darwin, providing consistent Nix behavior on all "
"machines."
msgstr ""

#. type: heading ***
#: modules/configuration.org:20 modules/configuration.org:2017
#, no-wrap
msgid "Core Settings"
msgstr ""

#. type: paragraph
#: modules/configuration.org:22
msgid ""
"Core Nix daemon configuration including flakes, garbage collection, binary "
"caches, and sandbox settings."
msgstr ""

#. type: paragraph
#: modules/configuration.org:30
msgid ""
"Registered under both NixOS and nix-darwin, since Nix daemon behavior is "
"shared across platforms; the =systemModule= binding lets both classes reuse "
"the exact same module rather than duplicating it. The user-level counterpart "
"([[*User-Level Settings][User-Level Settings]]) is a distinct "
"=flake.modules.homeManager.nix= entry in this same file, since XDG base "
"directories and the global gitignore belong to the home-manager scope, not "
"the system scope."
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:38
#, no-wrap
msgid ""
"{ ... }:\n"
"let\n"
"  systemModule =\n"
"    {\n"
"      config,\n"
"      lib,\n"
"      pkgs,\n"
"      ...\n"
"    }:\n"
"    let\n"
"      cfg = config.my.nix;\n"
"    in\n"
"    {\n"
"      <<nix-options>>"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:53
#, no-wrap
msgid ""
"      <<nix-config>>\n"
"    };\n"
"in\n"
"{\n"
"  flake.modules.nixos.nix = systemModule;\n"
"  flake.modules.darwin.nix = systemModule;"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:60
#, no-wrap
msgid ""
"  <<nix-home-manager>>\n"
"}"
msgstr ""

#. type: heading ***
#: modules/configuration.org:64 modules/configuration.org:357
#: modules/configuration.org:770 modules/configuration.org:3161
#: modules/configuration.org:4432 modules/configuration.org:6419
#, no-wrap
msgid "Options"
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:66
#, no-wrap
msgid "nix-options"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:68
#, no-wrap
msgid ""
"options.my.nix = {\n"
"  enable = lib.mkEnableOption \"Nix configuration\";"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:71
#, no-wrap
msgid ""
"  enableFlakes = lib.mkOption {\n"
"    default = true;\n"
"    example = false;\n"
"    description = \"Whether to enable flakes.\";\n"
"    type = lib.types.bool;\n"
"  };\n"
"};"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:84
#, no-wrap
msgid ""
"config = lib.mkIf cfg.enable (\n"
"  lib.mkMerge [\n"
"    <<nix-flakes>>\n"
"    {\n"
"      <<nix-store-optimisation>>"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:90
#, no-wrap
msgid "<<nix-warn-dirty>>"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:92
#, no-wrap
msgid "<<nix-substituters>>"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:94
#, no-wrap
msgid "<<nix-sandbox>>"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:96
#, no-wrap
msgid "<<nix-trusted-users>>"
msgstr ""

#. type: paragraph in src
