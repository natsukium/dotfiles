#. type: heading *****
#: modules/configuration.org:2558
#, no-wrap
msgid "Launchd daemons"
msgstr ""

#. type: paragraph
#: modules/configuration.org:2560
msgid ""
"One launchd job per enabled instance. launchd has no =EnvironmentFile=, so a "
"=tokenFile= instance sources it in-script while an inline =token= rides on "
"=EnvironmentVariables=; either way the script sees =$TOKEN=. I prepend "
"=coreutils= to =PATH= so the script's own =sha256sum=/=cut= resolve even if "
"a host trims =hostPackages=. Two launchd quirks shape each:"
msgstr ""

#. type: plain list -
#: modules/configuration.org:2569
#, no-wrap
msgid ""
"=WorkingDirectory= cannot be the state directory: launchd chdir()s into it\n"
"/before/ exec, so on first boot the spawn aborts with =EX_CONFIG= (78) "
"before\n"
"the script can create it. The script sets its own cwd instead."
msgstr ""

#. type: plain list -
#: modules/configuration.org:2573
#, no-wrap
msgid ""
"The logs live in the user-owned state directory, not =/var/log=: launchd\n"
"opens them as =UserName=, and an unprivileged daemon cannot create a\n"
"root-owned file under =/var/log=, so it would fail to spawn — silently,\n"
"before any log line."
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:2574
#, no-wrap
msgid "forgejo-runner-daemons"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2576
#, no-wrap
msgid ""
"launchd.daemons = lib.mapAttrs' (\n"
"  _: instance:\n"
"  let\n"
"    configFile = settingsFormat.generate \"config.yaml\" "
"instance.settings;\n"
"  in\n"
"  lib.nameValuePair \"forgejo-runner-${instance.name}\" {\n"
"    script = ''\n"
"      set -eu\n"
"      mkdir -p ${lib.escapeShellArg instance.stateDir}\n"
"      cd ${lib.escapeShellArg instance.stateDir}\n"
"      ${lib.optionalString (instance.tokenFile != null) ''\n"
"        set -a\n"
"        . ${lib.escapeShellArg (toString instance.tokenFile)}\n"
"        set +a\n"
"      ''}\n"
"      labels=${lib.escapeShellArg (lib.concatStringsSep \",\" "
"instance.labels)}\n"
"      state=\"$(printf '%s' \"$TOKEN\" | sha256sum | cut -d' ' -f1) "
"$labels\""
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2594
#, no-wrap
msgid ""
"if [ ! -f .runner ] || [ \"$(cat .registration-state 2>/dev/null)\" != "
"\"$state\" ]; then\n"
"  rm -f .runner\n"
"  ${lib.getExe cfg.package} register \\\n"
"    --no-interactive \\\n"
"    --instance ${lib.escapeShellArg instance.url} \\\n"
"    --token \"$TOKEN\" \\\n"
"    --name ${lib.escapeShellArg instance.name} \\\n"
"    --labels \"$labels\" \\\n"
"    --config ${configFile}\n"
"  printf '%s' \"$state\" > .registration-state\n"
"fi"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2606
#, no-wrap
msgid ""
"      exec ${lib.getExe cfg.package} daemon --config ${configFile}\n"
"    '';\n"
"    serviceConfig = {\n"
"      UserName = cfg.user;\n"
"      GroupName = cfg.group;\n"
"      KeepAlive = true;\n"
"      RunAtLoad = true;\n"
"      ProcessType = \"Background\";\n"
"      EnvironmentVariables = {\n"
"        HOME = instance.stateDir;\n"
"        PATH = \"${\n"
"          lib.makeBinPath ([ pkgs.coreutils ] ++ instance.hostPackages)\n"
"        }:/usr/bin:/bin:/usr/sbin:/sbin\";\n"
"      }\n"
"      // lib.optionalAttrs (instance.token != null) { TOKEN = "
"instance.token; };\n"
"      StandardOutPath = \"${instance.stateDir}/forgejo-runner.log\";\n"
"      StandardErrorPath = \"${instance.stateDir}/forgejo-runner.err.log\";\n"
"    };\n"
"  }\n"
") enabledInstances;"
msgstr ""

#. type: heading *****
#: modules/configuration.org:2628
#, no-wrap
msgid "Runner user"
msgstr ""

#. type: paragraph
#: modules/configuration.org:2630
msgid ""
"nix-darwin only manages accounts listed in =users.knownUsers= / "
"=users.knownGroups=, so I add the entries."
msgstr ""

#. type: paragraph
#: modules/configuration.org:2633
msgid ""
"I leave =createHome= off: it runs =createhomedir=, which resolves the =/var= "
"firmlink and records the home as =/private/var/…=, then nix-darwin "
"string-compares that against the configured =home= and aborts activation on "
"the mismatch. The daemon uses its state directory as =HOME= anyway, created "
"and owned below."
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:2639
#, no-wrap
msgid "forgejo-runner-user"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2641
#, no-wrap
msgid ""
"users.users.${cfg.user} = {\n"
"  uid = cfg.uid;\n"
"  gid = cfg.gid;\n"
"  isHidden = true;\n"
"  description = \"Forgejo Actions runner\";\n"
"};\n"
"users.groups.${cfg.group}.gid = cfg.gid;\n"
"users.knownUsers = [ cfg.user ];\n"
"users.knownGroups = [ cfg.group ];"
msgstr ""

#. type: heading *****
#: modules/configuration.org:2652
#, no-wrap
msgid "State ownership"
msgstr ""

#. type: paragraph
#: modules/configuration.org:2654
msgid ""
"Each state directory must exist and belong to the runner user before its "
"daemon starts. With =createHome= off nothing else creates it, so activation "
"makes and chowns it =mkBefore= the launchd step that loads the daemons."
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:2658
#, no-wrap
msgid "forgejo-runner-ownership"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2660
#, no-wrap
msgid ""
"system.activationScripts.launchd.text = lib.mkBefore (\n"
"  lib.concatMapStringsSep \"\\n\" (instance: ''\n"
"    mkdir -p ${lib.escapeShellArg instance.stateDir}\n"
"    chown -R ${lib.escapeShellArg cfg.user}:${lib.escapeShellArg cfg.group} "
"${lib.escapeShellArg instance.stateDir}\n"
"  '') (lib.attrValues enabledInstances)\n"
");"
msgstr ""

#. type: heading ***
#: modules/configuration.org:2668
#, no-wrap
msgid "Opinionated wrappers"
msgstr ""

#. type: paragraph
#: modules/configuration.org:2670
msgid ""
"The two platforms drive different options — =services.forgejo-runner= on "
"Darwin, =services.gitea-actions-runner= on NixOS — but since the nix-darwin "
"module mirrors the NixOS instance schema, the wrappers share one option "
"surface and one =mkInstance= builder. My =my.services.forgejo-runner= "
"options give =enable=, =url= (defaulting to my Forgejo instance), =labels=, "
"and a =tokenFile= path; the host owns the secret and hands only its "
"path. Each wrapper holds only the per-platform deltas: the =labels= default, "
"=hostPackages=, and — on NixOS — the package and Docker for container "
"jobs. Both push to my binary cache, so each =hostPackages= adds =nix= and "
"the niks3 client."
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:2680
#, no-wrap
msgid "forgejo-runner-wrapper-shared"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2682
#, no-wrap
msgid ""
"wrapperOptions =\n"
"  { lib, ... }:\n"
"  {\n"
"    options.my.services.forgejo-runner = {\n"
"      enable = lib.mkEnableOption \"Forgejo Actions runner\";"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2688
#, no-wrap
msgid ""
"url = lib.mkOption {\n"
"  type = lib.types.str;\n"
"  default = \"https://git.natsukium.com\";\n"
"  description = \"Forgejo instance the runner registers with.\";\n"
"};"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2694
#, no-wrap
msgid ""
"tokenFile = lib.mkOption {\n"
"  type = lib.types.path;\n"
"  description = ''\n"
"    Path to an environment file holding the registration token as\n"
"    `TOKEN=...`. The host supplies this — typically a secret-manager path "
"—\n"
"    so the feature stays free of any secret-store assumption.\n"
"  '';\n"
"};"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2703
#, no-wrap
msgid ""
"    labels = lib.mkOption {\n"
"      type = lib.types.listOf lib.types.str;\n"
"      description = \"Labels the runner advertises; each platform sets a "
"default.\";\n"
"    };\n"
"  };\n"
"};"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2710
#, no-wrap
msgid ""
"mkInstance = config: hostPackages: {\n"
"  enable = true;\n"
"  name = config.networking.hostName;\n"
"  url = config.my.services.forgejo-runner.url;\n"
"  tokenFile = config.my.services.forgejo-runner.tokenFile;\n"
"  labels = config.my.services.forgejo-runner.labels;\n"
"  inherit hostPackages;\n"
"};"
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:2720
#, no-wrap
msgid "forgejo-runner-wrappers"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2722
#, no-wrap
msgid ""
"darwinWrapper =\n"
"  {\n"
"    config,\n"
"    lib,\n"
"    pkgs,\n"
"    inputs,\n"
"    ...\n"
"  }:\n"
"  {\n"
"    imports = [\n"
"      ./darwin-module.nix\n"
"      wrapperOptions\n"
"    ];"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2736
#, no-wrap
msgid ""
"config = lib.mkIf config.my.services.forgejo-runner.enable {\n"
"  my.services.forgejo-runner.labels = lib.mkDefault [\n"
"    \"macos:host\"\n"
"    \"macos-aarch64:host\"\n"
"  ];"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2742
#, no-wrap
msgid ""
"    services.forgejo-runner.instances.default = mkInstance config (\n"
"      with pkgs;\n"
"      [\n"
"        bash\n"
"        curl\n"
"        git\n"
"        nix\n"
"        nodejs\n"
"        toybox\n"
"        inputs.niks3.packages.${pkgs.stdenv.hostPlatform.system}.niks3\n"
"      ]\n"
"    );\n"
"  };\n"
"};"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2757
#, no-wrap
msgid ""
"nixosWrapper =\n"
"  {\n"
"    config,\n"
"    lib,\n"
"    pkgs,\n"
"    inputs,\n"
"    ...\n"
"  }:\n"
"  {\n"
"    imports = [ wrapperOptions ];"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2768
#, no-wrap
msgid ""
"config = lib.mkIf config.my.services.forgejo-runner.enable {\n"
"  my.services.forgejo-runner.labels = lib.mkDefault [\n"
"    \"ubuntu-latest:docker://node:22-bookworm\"\n"
"    \"nix:host\"\n"
"  ];"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2774
#, no-wrap
msgid ""
"services.gitea-actions-runner = {\n"
"  package = pkgs.forgejo-runner;\n"
"  instances.default = mkInstance config (\n"
"    with pkgs;\n"
"    [\n"
"      bash\n"
"      busybox\n"
"      curl\n"
"      git\n"
"      nix\n"
"      nodejs\n"
"      inputs.niks3.packages.${pkgs.stdenv.hostPlatform.system}.niks3\n"
"    ]\n"
"  );\n"
"};"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2790
#, no-wrap
msgid ""
"    virtualisation.docker.enable = true;\n"
"  };\n"
"};"
msgstr ""

#. type: heading *
#: modules/configuration.org:2795
#, no-wrap
msgid "Devices"
msgstr ""

#. type: paragraph
#: modules/configuration.org:2797
msgid ""
"Peripherals that move between machines belong here, not in "
"=hardware-configuration=, which describes a host's fixed internals. Each "
"device is a switch under =my.devices.*=, exposed through the "
"=flake.modules.nixos.devices= registry; a host enables only the ones it has "
"plugged in."
msgstr ""

#. type: heading **
#: modules/configuration.org:2803
#, no-wrap
msgid "Audio"
msgstr ""

#. type: heading ***
#: modules/configuration.org:2805
#, no-wrap
msgid "AT2040 microphone"
msgstr ""

#. type: paragraph
#: modules/configuration.org:2807
msgid ""
"The AT2040 is a USB microphone that also exposes a headphone "
"output. WirePlumber gives that output a higher default priority (1109) than "
"the HDMI sink (1000), so plugging the mic in silently hijacks the default "
"output. I demote the AT2040 sink to the lowest priority so the host's "
"existing output stays selected; the =media.class= guard holds back the sink "
"alone, leaving the mic input at its own high priority to still become the "
"default source."
msgstr ""

#. type: paragraph
#: modules/configuration.org:2814
msgid ""
"The rule matches on =alsa.card_name= rather than the serial-bearing "
"=node.name=, so it survives re-plugging and would apply to a replacement "
"unit."
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2823
#, no-wrap
msgid ""
"{ ... }:\n"
"{\n"
"  flake.modules.nixos.devices =\n"
"    {\n"
"      config,\n"
"      lib,\n"
"      ...\n"
"    }:\n"
"    let\n"
"      cfg = config.my.devices;\n"
"    in\n"
"    {\n"
"      options.my.devices.audio.at2040.enable =\n"
"        lib.mkEnableOption \"AT2040 USB mic sink demotion so it does not "
"steal the default output\";"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2839
#, no-wrap
msgid ""
"      config = lib.mkIf cfg.audio.at2040.enable {\n"
"        services.pipewire.wireplumber.extraConfig.\"51-at2040-demote-sink\" "
"= {\n"
"          \"monitor.alsa.rules\" = [\n"
"            {\n"
"              matches = [\n"
"                {\n"
"                  \"media.class\" = \"Audio/Sink\";\n"
"                  \"alsa.card_name\" = \"AT2040USB\";\n"
"                }\n"
"              ];\n"
"              actions.update-props = {\n"
"                \"priority.driver\" = 0;\n"
"                \"priority.session\" = 0;\n"
"              };\n"
"            }\n"
"          ];\n"
"        };\n"
"      };\n"
"    };\n"
"}"
msgstr ""

#. type: heading *
#: modules/configuration.org:2861
#, no-wrap
msgid "Authentication"
msgstr ""

#. type: heading **
#: modules/configuration.org:2863
#, no-wrap
msgid "Ente Auth"
msgstr ""

#. type: paragraph
#: modules/configuration.org:2865
msgid ""
"[[https://ente.io/auth/][Ente Auth]] holds my TOTP secrets and syncs them "
"with end-to-end encryption between Android and every machine here, so a lost "
"phone is an inconvenience rather than a lockout. Client and server are both "
"open source, so I can read what happens to the secrets and self-host the "
"backend later without re-enrolling anything."
msgstr ""

#. type: paragraph
#: modules/configuration.org:2871
msgid ""
"Before this I used Google Authenticator and then Microsoft Authenticator, "
"out of inertia more than choice. Neither could hand its secrets to a new "
"device at the time, so replacing a phone meant re-enrolling every account by "
"hand."
msgstr ""

#. type: paragraph
#: modules/configuration.org:2875
msgid ""
"A password manager would solve the sync problem too (Bitwarden sells TOTP on "
"a paid plan, and a self-hosted Vaultwarden gives it away), but I keep the "
"two apart deliberately. Storing the codes in the vault means anyone who gets "
"into the vault has already cleared the second factor, which leaves me with "
"one factor wearing two hats."
msgstr ""

#. type: paragraph
#: modules/configuration.org:2881
msgid ""
"nixpkgs builds =ente-auth= for Linux only. The app is written in Flutter, "
"and the Flutter tooling in nixpkgs can only produce Linux desktop bundles; a "
"macOS bundle requires Xcode, which a sandboxed Nix build cannot use. So "
"darwin installs the upstream cask through brew-nix instead."
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2892
#, no-wrap
msgid ""
"{ ... }:\n"
"{\n"
"  flake.modules.homeManager.ente-auth =\n"
"    {\n"
"      config,\n"
"      lib,\n"
"      pkgs,\n"
"      ...\n"
"    }:\n"
"    let\n"
"      cfg = config.my.programs.ente-auth;\n"
"    in\n"
"    {\n"
"      options.my.programs.ente-auth = {\n"
"        enable = lib.mkEnableOption \"Ente Auth\";\n"
"        package = lib.mkOption {\n"
"          type = lib.types.package;\n"
"          default = if pkgs.stdenv.hostPlatform.isDarwin then "
"pkgs.brewCasks.ente-auth else pkgs.ente-auth;\n"
"          defaultText = lib.literalExpression \"pkgs.ente-auth\";\n"
"          description = \"The Ente Auth package to install.\";\n"
"        };\n"
"      };"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2917
#, no-wrap
msgid ""
"      config = lib.mkIf cfg.enable {\n"
"        home.packages = [ cfg.package ];\n"
"      };\n"
"    };\n"
"}"
msgstr ""

#. type: heading *
#: modules/configuration.org:2924
#, no-wrap
msgid "Browser"
msgstr ""

#. type: paragraph
#: modules/configuration.org:2926
msgid ""
"Compared with Chromium, Firefox lets me declare far more of its "
"configuration (search engines and extensions, to name two), and that plays "
"straight into home-manager: every machine gets the same browser from the "
"same expression, with no sync service involved. That is why I stay on the "
"Firefox side of the fence. I also simply want to run Gecko rather than yet "
"another Blink browser."
msgstr ""

#. type: paragraph
#: modules/configuration.org:2932
msgid ""
"For about a year and a half that Firefox was [[https://zen-browser.app/][Zen "
"Browser]], a fork with better UI/UX, though I always had some reservations "
"about it. While I was using it, stock Firefox kept shipping, and eventually "
"almost everything I wanted landed upstream:"
msgstr ""

#. type: plain list 1.
#: modules/configuration.org:2939
#, no-wrap
msgid ""
"Vertical tabs "
"([[https://www.firefox.com/en-US/firefox/136.0/releasenotes/][Firefox "
"136]]). I keep a hundred tabs open at all times, so a\n"
"horizontal tab strip is out of the question."
msgstr ""

#. type: plain list 2.
#: modules/configuration.org:2941
#, no-wrap
msgid ""
"Configurable keyboard shortcuts "
"([[https://www.firefox.com/en-US/firefox/147.0/releasenotes/][Firefox "
"147]]). Firefox finally lets me rebind\n"
"them."
msgstr ""

#. type: plain list 3.
#: modules/configuration.org:2943
#, no-wrap
msgid ""
"Split view "
"([[https://www.firefox.com/en-US/firefox/149.0/releasenotes/][Firefox "
"149]]). Not an everyday feature, but comparing two pages\n"
"side by side comes up more often than I expected."
msgstr ""

#. type: paragraph
#: modules/configuration.org:2944
msgid "What I liked about Zen beyond that turned out to need nothing more than CSS:"
msgstr ""

#. type: plain list 1.
#: modules/configuration.org:2948
#, no-wrap
msgid ""
"[[https://docs.zen-browser.app/user-manual/compact-mode][Compact mode]]. A "
"browser, like almost every program, has no need for bars;\n"
"Zen hides the toolbar and sidebar by default."
msgstr ""

#. type: plain list 2.
#: modules/configuration.org:2953
#, no-wrap
msgid ""
"[[https://docs.zen-browser.app/user-manual/urlbar][Floating URL bar]]. Zen's "
"URL bar searches like any other, but the input\n"
"floats in the middle of the window. URL bars are normally pinned to the top "
"or\n"
"bottom edge, so one of the most heavily used components demands the longest "
"eye\n"
"movement. And as compact mode shows, I don't want a bar there in the first\n"
"place."
msgstr ""

#. type: paragraph
#: modules/configuration.org:2954
msgid ""
"Neither needs a fork; a =userChrome.css= theme is enough. With "
"[[https://github.com/reizumii/parfait][parfait]] I get everything I wanted "
"from Zen on stock Firefox, and it is far from the only such theme; "
"[[https://github.com/greeeen-dev/natsumi-browser][natsumi-browser]] was the "
"first one I came across."
msgstr ""

#. type: paragraph
#: modules/configuration.org:2958
msgid ""
"With the UI gap closed, what remains are my reservations: Zen's stability, "
"its prospects as a project, and how well it is maintained in nixpkgs. So I "
"switched to Firefox and removed Zen from the configuration entirely."
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2968
#, no-wrap
msgid ""
"{ ... }:\n"
"let\n"
"  sharedSearch = import ./search.nix;\n"
"  sharedExtensions = import ./extensions.nix;\n"
"in\n"
"{\n"
"  <<firefox-module>>\n"
"}"
msgstr ""

#. type: heading **
#: modules/configuration.org:2978
#, no-wrap
msgid "Firefox"
msgstr ""

#. type: paragraph
#: modules/configuration.org:2980
msgid ""
"Stock Firefox is dressed in parfait, a chrome theme written entirely in "
"=userChrome.css= (no extension, no =userChrome.js= loader), so it lives "
"inside the profile home-manager already writes."
msgstr ""

#. type: paragraph
#: modules/configuration.org:2985
msgid ""
"On Linux, home-manager still defaults the profile directory to "
"=~/.mozilla/firefox= for =home.stateVersion= below 26.05 and warns on every "
"evaluation until the choice is made explicit."
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:2989
#, no-wrap
msgid "firefox-module"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2991
#, no-wrap
msgid ""
"flake.modules.homeManager.firefox =\n"
"  {\n"
"    config,\n"
"    lib,\n"
"    pkgs,\n"
"    ...\n"
"  }:\n"
"  let\n"
"    cfg = config.my.programs.firefox;\n"
"    parfait = pkgs.callPackage ./parfait.nix { };\n"
"  in\n"
"  {\n"
"    options.my.programs.firefox = {\n"
"      enable = lib.mkEnableOption \"Firefox\";\n"
"    };"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3007
#, no-wrap
msgid ""
"config = lib.mkIf cfg.enable {\n"
"  programs.firefox = {\n"
"    enable = true;\n"
"    configPath = lib.mkIf pkgs.stdenv.hostPlatform.isLinux "
"\"${config.xdg.configHome}/mozilla/firefox\";\n"
"    profiles.natsukium = {\n"
"      search = sharedSearch { inherit pkgs; };\n"
"      extensions = sharedExtensions { inherit pkgs; };"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3015
#, no-wrap
msgid ""
"    <<firefox-settings>>\n"
"  };\n"
"};"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3019
#, no-wrap
msgid ""
"    <<firefox-parfait-tree>>\n"
"  };\n"
"};"
msgstr ""

#. type: heading ***
#: modules/configuration.org:3024
#, no-wrap
msgid "Settings"
msgstr ""

#. type: paragraph
#: modules/configuration.org:3026
msgid ""
"=extensions.autoDisableScopes= is 0 in both profiles: by default Firefox "
"asks for confirmation of each extension the profile installs, so the first "
"launch after a rebuild would mean approving every one by hand."
msgstr ""

#. type: paragraph
#: modules/configuration.org:3030
msgid "I keep my passwords in Bitwarden, so I turn off =signon.rememberSignons=."
msgstr ""

#. type: paragraph
#: modules/configuration.org:3032
msgid ""
"parfait ships its defaults in a =user.js= that its install instructions tell "
"you to copy into the profile. home-manager generates =user.js= itself from "
"=settings=, so those defaults are transcribed here: an unset preference does "
"not match any =-moz-pref()= query, and dropping the list would leave the "
"theme running on whatever the stylesheets fall back to rather than on what "
"its author intended."
msgstr ""

#. type: paragraph
#: modules/configuration.org:3038
msgid ""
"Four values depart from that baseline. =sidebar.verticalTabs= and "
"=sidebar.visibility= are Firefox's own preferences, and the =hide-sidebar= "
"value is what puts parfait into its floating layout: the navigation bar "
"slides off screen and the sidebar hovers over the page, which is the compact "
"mode I came here for. =parfait.blur.enabled= adds the backdrop filter behind "
"the floating address bar. =parfait.urlbar.search-mode.glow= is off: I do not "
"want an animation firing every time the search mode changes."
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:3045
#, no-wrap
msgid "firefox-settings"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3047
#, no-wrap
msgid ""
"settings = {\n"
"  \"extensions.autoDisableScopes\" = 0;"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3052
#, no-wrap
msgid ""
"\"toolkit.legacyUserProfileCustomizations.stylesheets\" = true;\n"
"\"svg.context-properties.content.enabled\" = true;"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3055
#, no-wrap
msgid ""
"\"sidebar.verticalTabs\" = true;\n"
"\"sidebar.visibility\" = \"hide-sidebar\";"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3058
#, no-wrap
msgid ""
"\"browser.translations.automaticallyPopup\" = false;\n"
"\"layout.spellcheckDefault\" = 0;\n"
"\"signon.rememberSignons\" = false;"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:3062
#, no-wrap
msgid ""
"  \"parfait.animations.enabled\" = true;\n"
"  \"parfait.blur.enabled\" = true;\n"
"  \"parfait.theme.roundness.preset\" = 0;\n"
"  \"parfait.window.borderless\" = false;\n"
"  \"parfait.bg.accent-color\" = false;\n"
"  \"parfait.bg.contrast\" = 2;\n"
"  \"parfait.bg.gradient\" = false;\n"
"  \"parfait.bg.opacity\" = 4;\n"
"  \"parfait.bg.transparent\" = false;\n"
"  \"parfait.tabs.groups.color\" = false;\n"
"  \"parfait.sidebar.width.preset\" = 2;\n"
"  \"parfait.toolbar.sidebar-gutter\" = true;\n"
"  \"parfait.toolbar.unified-sidebar\" = true;\n"
"  \"parfait.traffic-lights.enabled\" = false;\n"
"  \"parfait.traffic-lights.mono\" = false;\n"
"  \"parfait.urlbar.url.center\" = false;\n"
"  \"parfait.urlbar.results.compact\" = false;\n"
"  \"parfait.urlbar.search-mode.glow\" = false;\n"
"  \"parfait.new-tab.logo\" = 1;\n"
"  \"parfait.new-tab.bg.pattern\" = false;\n"
"};"
msgstr ""

#. type: heading ***
#: modules/configuration.org:3085
#, no-wrap
msgid "Theme files"
msgstr ""

#. type: paragraph
#: modules/configuration.org:3087
msgid ""
"parfait's repository is already shaped like a profile's =chrome/= directory, "
