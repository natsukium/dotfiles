#. type: heading ***
#: modules/configuration.org:5167
#, no-wrap
msgid "Containers"
msgstr ""

#. type: paragraph
#: modules/configuration.org:5169
msgid ""
"Declaring the container pins its ID so routing rules can address it by "
"=firefox-container-1=. =containersForce= allows home-manager to write "
"=containers.json=, which Firefox overwrites on launch."
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:5173
#, no-wrap
msgid "firefox-containers"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:5175
#, no-wrap
msgid ""
"containers.work = {\n"
"  id = workContainerId;\n"
"  color = \"red\";\n"
"  icon = \"briefcase\";\n"
"};\n"
"containersForce = true;"
msgstr ""

#. type: paragraph
#: modules/configuration.org:5183
msgid ""
"Mozilla's Multi-Account Containers only matches on "
"domain. [[https://github.com/kintesh/containerise][containerise]] matches "
"paths, routing only =attmcojp= URLs into the work container."
msgstr ""

#. type: paragraph
#: modules/configuration.org:5186
msgid ""
"Rules only route inbound: routing non-work paths back out breaks sign-in, as "
"container switches reopen tabs and drop POST bodies (such as SAML assertions "
"and two-factor forms)."
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:5190
#, no-wrap
msgid "firefox-containerise-rules"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:5192
#, no-wrap
msgid ""
"settings.\"containerise@kinte.sh\" = {\n"
"  force = true;\n"
"  settings =\n"
"    let\n"
"      work = host: {\n"
"        inherit host;\n"
"        cookieStoreId = \"firefox-container-${toString workContainerId}\";\n"
"        containerName = \"work\";\n"
"        enabled = true;\n"
"      };\n"
"    in\n"
"    {\n"
"      \"map=github.com/orgs/attmcojp\" = work "
"\"github.com/orgs/attmcojp\";\n"
"      \"map=github.com/attmcojp\" = work \"github.com/attmcojp\";\n"
"    };\n"
"};"
msgstr ""

