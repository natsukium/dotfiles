#. type: paragraph in src
#: modules/configuration.org:6264
#, no-wrap
msgid ""
"felis-grep = pkgs.writeShellApplication {\n"
"  name = \"felis-grep\";\n"
"  runtimeInputs = [\n"
"    package\n"
"    pkgs.fzf\n"
"    pkgs.gawk\n"
"    pkgs.jq\n"
"  ];\n"
"  text = ''\n"
"    ${roster}\n"
"    matches=$(\n"
"      roster \\\n"
"            felis sessions capture \"$id\" --source scrollback 2>/dev/null "
"\\\n"
"          done\n"
"    )\n"
"    if [ -z \"$matches\" ]; then\n"
"      echo \"no scrollback\" >&2\n"
"      exit 0\n"
"    fi"
msgstr ""

#. type: cell column 0
#: modules/configuration.org:6289
#, no-wrap
msgid "fzf --delimiter='\\t' --with-nth=2.. --prompt='grep scrollback> '"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:6287
#, no-wrap
msgid ""
"selection=$(\n"
"  printf '%s\\n' \"$matches\" \\\n"
") || exit 0"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:6292
#, no-wrap
msgid ""
"    id=$(printf '%s' \"$selection\" | awk -F'\\t' '{print $1; exit}')\n"
"    [ -n \"$id\" ] && felis sessions switch \"$id\"\n"
"  '';\n"
"};"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:6302
#, no-wrap
msgid ""
"felis-scrollback = pkgs.writeShellApplication {\n"
"  name = \"felis-scrollback\";\n"
"  runtimeInputs = [ neovim ];\n"
"  text = ''\n"
"    exec nvim -R \\\n"
"      -c 'setlocal noswapfile' \\\n"
"      -c 'normal! G' \\\n"
"      \"''${1:?no region file}\"\n"
"  '';\n"
"};"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:6326
#, no-wrap
msgid ""
"felis-hints = pkgs.writeShellApplication {\n"
"  name = \"felis-hints\";\n"
"  runtimeInputs = [\n"
"    spoor\n"
"  ]\n"
"  ++ lib.optional pkgs.stdenv.hostPlatform.isLinux pkgs.xdg-utils;\n"
"  text = ''\n"
"    picked=$(spoor \\\n"
"      --preset url \\\n"
"      --regex '[\\w.~/@+-]+\\.(?i:html?|pdf)\\b' \\\n"
"      \"''${1:?no region file}\") || exit 0\n"
"    [ -n \"$picked\" ] || exit 0\n"
"    case $picked in\n"
"      \"~/\"*) picked=$HOME/''${picked#\"~/\"} ;;\n"
"    esac\n"
"    exec ${opener} \"$picked\"\n"
"  '';\n"
"};"
msgstr ""

#. type: cell column 0
#: modules/configuration.org:6365
#, no-wrap
msgid "sed 's/^nix log //' \\"
msgstr ""

#. type: cell column 0
#: modules/configuration.org:6366
#, no-wrap
msgid "awk '!seen[$0]++'"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:6353
#, no-wrap
msgid ""
"  felis-nix-log = pkgs.writeShellApplication {\n"
"    name = \"felis-nix-log\";\n"
"    runtimeInputs = [\n"
"      pkgs.nix\n"
"      pkgs.fzf\n"
"      pkgs.gnused\n"
"      pkgs.gawk\n"
"      pkgs.less\n"
"    ];\n"
"    text = ''\n"
"      mapfile -t drvs < <(\n"
"        grep -oE 'nix log /nix/store/[a-z0-9]{32}-[^ ]+\\.drv' \"''${1:?no "
"region file}\" \\\n"
"      )\n"
"      case ''${#drvs[@]} in\n"
"        0) echo \"no 'nix log <drv>' on screen\" >&2; exit 0 ;;\n"
"        1) drv=''${drvs[0]} ;;\n"
"        *) drv=$(printf '%s\\n' \"''${drvs[@]}\" | fzf --prompt='nix log> ') "
"|| exit 0 ;;\n"
"      esac\n"
"      [ -n \"$drv\" ] && nix log \"$drv\" | less -R\n"
"    '';\n"
"  };\n"
"in\n"
"{\n"
"  inherit\n"
"    felis-switch\n"
"    felis-kill\n"
"    felis-grep\n"
"    felis-scrollback\n"
"    felis-hints\n"
"    felis-nix-log\n"
"    ;\n"
"}"
msgstr ""

#. type: heading **
#: modules/configuration.org:6391
#, no-wrap
msgid "Spotlight"
msgstr ""

#. type: paragraph
#: modules/configuration.org:6393
msgid ""
"I don't use Spotlight search, yet its indexer (=mdworker=) keeps consuming "
"CPU, disk I/O, and disk space in the background, so I turn indexing off by "
"default. Hosts that want it back can set =enableIndex = true=. nix-darwin "
"has no option for this, so the module drives =mdutil= from an activation "
"script."
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:6404
#, no-wrap
msgid ""
"{ ... }:\n"
"{\n"
"  flake.modules.darwin.spotlight =\n"
"    { config, lib, ... }:\n"
"    let\n"
"      cfg = config.my.services.spotlight;\n"
"    in\n"
"    {\n"
"      <<spotlight-options>>"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:6414
#, no-wrap
msgid ""
"      <<spotlight-config>>\n"
"    };\n"
"}"
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:6421
#, no-wrap
msgid "spotlight-options"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:6423
#, no-wrap
msgid ""
"options.my.services.spotlight = {\n"
"  enableIndex = lib.mkOption {\n"
"    type = lib.types.bool;\n"
"    default = false;\n"
"    description = \"Whether Spotlight indexes the volumes on this "
"machine.\";\n"
"  };\n"
"};"
msgstr ""

#. type: paragraph
#: modules/configuration.org:6434
msgid ""
"=mdutil= targets all volumes with =-a= rather than just =/=: modern macOS "
"splits the boot disk into a read-only System volume (=/=) and a writable "
"Data volume, so =mdutil -i off /= silently leaves the Data volume "
"indexing. When disabling, =mdutil -E= also erases the orphaned index stores "
"to reclaim disk space."
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:6439
#, no-wrap
msgid "spotlight-config"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:6441
#, no-wrap
msgid ""
"config = {\n"
"  system.activationScripts.extraActivation.text =\n"
"    if cfg.enableIndex then\n"
"      ''\n"
"        echo \"enabling spotlight indexing...\"\n"
"        mdutil -i on -a > /dev/null || true\n"
"      ''\n"
"    else\n"
"      ''\n"
"        echo \"disabling spotlight indexing...\"\n"
"        mdutil -i off -d -a > /dev/null || true\n"
"        mdutil -E -a > /dev/null || true\n"
"      '';\n"
"};"
msgstr ""
