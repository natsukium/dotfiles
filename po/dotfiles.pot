#: configuration.org:85
#, no-wrap
msgid ""
"{\n"
"  description = \"dotfiles\";"
msgstr ""

#. type: paragraph in src
#: configuration.org:88
#, no-wrap
msgid ""
"inputs = {\n"
"  <<nixpkgs>>\n"
"  <<nixpkgs-stable>>\n"
"  <<nixpkgs-cuda>>\n"
"  <<flake-parts>>\n"
"  <<flake-utils>>\n"
"  <<darwin>>\n"
"  <<home-manager>>\n"
"  <<nix-mac-app-identity>>\n"
"  <<nixos-wsl>>\n"
"  <<nix-on-droid>>\n"
"  <<disko>>\n"
"  <<impermanence>>\n"
"  <<lanzaboote>>\n"
"  <<nixos-facter-modules>>\n"
"  <<comin>>\n"
"  <<hydra>>\n"
"  <<microvm>>\n"
"  <<niks3>>\n"
"  <<nixvirt>>\n"
"  <<sops-nix>>\n"
"  <<git-hooks>>\n"
"  <<treefmt-nix>>\n"
"  <<nix-colors>>\n"
"  <<nix-wallpaper>>\n"
"  <<brew-nix>>\n"
"  <<edgepkgs>>\n"
"  <<emacs-overlay>>\n"
"  <<felis>>\n"
"  <<firefox-addons>>\n"
"  <<hermes-agent>>\n"
"  <<mcp-servers>>\n"
"  <<org-clickup>>\n"
"  <<nur-packages>>\n"
"  <<paneru>>\n"
"  <<simple-wol-manager>>\n"
