#, no-wrap
msgid ""
"(advice-add 'org-export-get-reference :around "
"#'dotfiles-export-get-reference)"
msgstr ""

#. type: paragraph in src
#: configuration.org:1550
#, no-wrap
msgid ""
";; A heading is only linkable if the reader can get at its URL, so each one "
"ends\n"
";; with a link to itself. It is styled to appear on hover or keyboard "
"focus.\n"
"(defun dotfiles-html-headline-anchor (original headline contents info)\n"
"  \"Append a self link to HEADLINE's heading tag.\n"
"The heading tag is found by search rather than at the start of the string,\n"
"because Org wraps it in an outline-container div.\"\n"
"  (let ((html (funcall original headline contents info)))\n"
"    (if (not (string-match \"<h\\\\([1-6]\\\\) "
"id=\\\"\\\\([^\\\"]+\\\\)\\\">\" html))\n"
"        html\n"
"      (let* ((level (match-string 1 html))\n"
"             (id (match-string 2 html))\n"
"             (closing (concat \"</h\" level \">\"))\n"
"             (position (string-search closing html)))\n"
"        (if (not position)\n"
"            html\n"
"          (concat (substring html 0 position)\n"
"                  \"<a class=\\\"heading-anchor\\\" href=\\\"#\" id "
"\"\\\"\"\n"
"                  \" aria-label=\\\"Link to this section\\\">#</a>\"\n"
"                  (substring html position)))))))"
msgstr ""

#. type: paragraph in src
#: configuration.org:1570
#, no-wrap
msgid "(advice-add 'org-html-headline :around #'dotfiles-html-headline-anchor)"
msgstr ""

#. type: paragraph in src
#: configuration.org:1572
#, no-wrap
msgid ""
"(defun dotfiles-export-html (lang)\n"
"  \"Export the LANG edition of the configuration document.\"\n"
"  ;; po4a names the translations configuration.<lang>.org; English is the\n"
"  ;; untranslated original and carries no infix.\n"
"  (let ((suffix (if (equal lang \"en\") \"\" (concat \".\" lang))))\n"
"    (setq dotfiles-translating (not (equal lang \"en\")))\n"
"    (when (and dotfiles-translating (null dotfiles-english-headings))\n"
"      (error \"Export English before %s: its anchors come from the "
"original\" lang))\n"
"    (setq dotfiles-tangle-map (dotfiles-build-tangle-map suffix))\n"
"    (find-file (concat \"configuration\" suffix \".org\"))\n"
"    (org-html-export-to-html)))"
