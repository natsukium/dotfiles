#. type: paragraph in src
#: modules/configuration.org:6241
#, no-wrap
msgid ""
"selection=$(\n"
"  printf '%s\\n' \"$list\" \\\n"
"          --multi \\\n"
"          --delimiter='\\t' \\\n"
"          --with-nth=2.. \\\n"
