#. type: paragraph in src
#: configuration.org:1445
#, no-wrap
msgid ""
";; Anchor headings by a slug of their title instead of the generated "
"org<hash>.\n"
";; Those hashes are derived from buffer positions, so every edit above a "
"heading\n"
";; renames it and any URL anyone saved stops working. A slug also says where "
"it\n"
";; lands. Org routes heading ids, the table of contents and internal "
"[[*Heading]]\n"
";; links through `org-export-get-reference', so overriding it moves all "
"three\n"
";; together and nothing is left pointing at the old id.\n"
"(defvar dotfiles-slug-by-heading nil)\n"
"(defvar dotfiles-slug-taken nil)"
msgstr ""

#. type: paragraph in src
#: configuration.org:1454
#, no-wrap
msgid ""
"(defun dotfiles-slugify (text)\n"
"  \"Lowercase TEXT with runs of non-alphanumerics turned into single "
"hyphens.\n"
"Japanese headings survive this: `[:alnum:]' matches CJK, so the translated\n"
"document gets readable anchors of its own rather than empty ones.\"\n"
"  (let ((slug (downcase text)))\n"
"    (setq slug (replace-regexp-in-string \"[^[:alnum:]]+\" \"-\" slug))\n"
"    (replace-regexp-in-string \"^-+\\\\|-+$\" \"\" slug)))"
msgstr ""

#. type: paragraph in src
#: configuration.org:1462
#, no-wrap
msgid ""
"(defun dotfiles-title-slug (headline)\n"
"  \"Slug of HEADLINE's own title, ignoring where it sits in the outline.\"\n"
"  (let ((slug (dotfiles-slugify\n"
"               (substring-no-properties\n"
"                (org-element-interpret-data\n"
"                 (org-element-property :title headline))))))\n"
"    (if (string-empty-p slug) \"section\" slug)))"
msgstr ""

#. type: paragraph in src
#: configuration.org:1470
#, no-wrap
msgid ""
"(defun dotfiles-heading-slug (headline)\n"
"  \"Slug for HEADLINE, qualified by its parent.\n"
"Every heading is named parent-then-self rather than only the ones that "
"would\n"
"otherwise clash. Sixteen titles repeat in this document, and naming a "
"heading\n"
"after itself alone means whether it keeps that name depends on what else "
"exists:\n"
"adding a second \\\"Configuration\\\" earlier renames the one already "
"published.\n"
"Including the parent makes a heading's URL a function of its own title and "
"its\n"
"parent's, so an edit elsewhere in the document cannot rename it. It also "
"empties\n"
"the collision set outright, leaving the numeric suffix below unreachable "
"in\n"
"practice — it stays for the case of two same-named siblings.\"\n"
"  (let* ((self (dotfiles-title-slug headline))\n"
"         (parent (org-element-parent headline))\n"
"         (base (if (and parent (eq (org-element-type parent) 'headline))\n"
"                   (concat (dotfiles-title-slug parent) \"-\" self)\n"
"                 self))\n"
"         (slug base)\n"
"         (suffix 2))\n"
"    (while (gethash slug dotfiles-slug-taken)\n"
"      (setq slug (format \"%s-%d\" base suffix))\n"
"      (setq suffix (1+ suffix)))\n"
"    (puthash slug t dotfiles-slug-taken)\n"
"    slug))"
msgstr ""

#. type: paragraph in src
#: configuration.org:1493
#, no-wrap
msgid ""
";; Slugs are assigned here, in one pass over the finished tree, rather than "
"when\n"
";; Org first asks for a reference. Org resolves references lazily, so a "
"link\n"
";; transcoded early can claim a name ahead of the heading that reads best "
"with\n"
";; it: left to that order a sixth-level \"Configuration\" took the bare\n"
";; `configuration' and the top-level chapter became "
"`configuration-2'. Walking\n"
";; the tree in document order makes the result depend on the document "
"alone.\n"
"(defvar dotfiles-english-headings nil\n"
"  \"The English document's headings as (SLUG . LEVEL), in document order.\")"
msgstr ""

#. type: paragraph in src
#: configuration.org:1502
#, no-wrap
msgid ""
"(defvar dotfiles-translating nil\n"
"  \"Non-nil while exporting an edition that should reuse the English "
"anchors.\")"
msgstr ""

#. type: paragraph in src
#: configuration.org:1505
#, no-wrap
msgid ""
"(defun dotfiles-assign-heading-slugs (tree _backend _info)\n"
"  \"Give every heading in TREE its slug, outermost and earliest first.\n"
"A translation is anchored by the English slugs rather than its own, so the "
"same\n"
"fragment addresses the same section in both editions and switching language "
"is a\n"
"matter of inserting the language into the path. po4a translates the document "
"in\n"
"place and cannot add or drop a heading, which is what makes matching them up "
"by\n"
"position sound — and is checked below, because a shifted match would "
"silently\n"
"point every anchor at the wrong section.\"\n"
"  (setq dotfiles-slug-by-heading (make-hash-table :test 'eq))\n"
"  (setq dotfiles-slug-taken (make-hash-table :test 'equal))\n"
"  (let ((headings (org-element-map tree 'headline #'identity)))\n"
"    (if (not dotfiles-translating)\n"
"        (progn\n"
"          (dolist (headline headings)\n"
"            (let ((slug (or\n"
"                         ;; An explicit :CUSTOM_ID: is the author pinning a "
"URL.\n"
"                         (org-element-property :CUSTOM_ID headline)\n"
"                         (dotfiles-heading-slug headline))))\n"
"              (puthash headline slug dotfiles-slug-by-heading)))\n"
"          (setq dotfiles-english-headings\n"
"                (mapcar (lambda (headline)\n"
"                          (cons (gethash headline "
"dotfiles-slug-by-heading)\n"
"                                (org-element-property :level headline)))\n"
"                        headings)))\n"
"      (unless (= (length headings) (length dotfiles-english-headings))\n"
"        (error \"Translation has %d headings, English has %d\"\n"
"               (length headings) (length dotfiles-english-headings)))\n"
"      (cl-loop for headline in headings\n"
"               for (slug . level) in dotfiles-english-headings\n"
"               do (unless (= (org-element-property :level headline) level)\n"
"                    (error \"Translated outline diverges at %s\" slug))\n"
"               do (puthash headline slug dotfiles-slug-by-heading))))\n"
"  tree)"
msgstr ""

#. type: paragraph in src
#: configuration.org:1542
#, no-wrap
msgid ""
"(defun dotfiles-export-get-reference (original datum info)\n"
"  \"Give headings a slug reference, leaving every other element to "
"ORIGINAL.\"\n"
"  (or (and (eq (org-element-type datum) 'headline)\n"
"           (gethash datum dotfiles-slug-by-heading))\n"
"      (funcall original datum info)))"
msgstr ""

#. type: paragraph in src
