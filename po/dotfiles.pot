#. type: keyword NAME
#: modules/configuration.org:4672
#, no-wrap
msgid "forgejo-windows-images"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:4674
#, no-wrap
msgid ""
"systemd.services.windows-ci-images = {\n"
"  description = \"Provision disk images for the Windows CI guest\";\n"
"  wantedBy = [ \"multi-user.target\" ];\n"
"  before = [\n"
"    \"libvirtd.service\"\n"
"    \"nixvirt.service\"\n"
"  ];\n"
"  after = [ \"windows-vm-images.service\" ];\n"
