msgstr ""

#. type: heading ****
#: modules/configuration.org:1847
#, no-wrap
msgid "Private Notes"
msgstr ""

#. type: paragraph
#: modules/configuration.org:1849
msgid ""
"=.private/= is a directory for personal notes, LLM context files, and other "
"local-only documentation that should never be shared."
msgstr ""

