"  ((\"C-.\" . embark-act)         ;; pick some comfortable binding\n"
"   (\"C-;\" . embark-dwim)        ;; good alternative: M-.\n"
"   (\"C-h B\" . embark-bindings)) ;; alternative for `describe-bindings'"
msgstr ""

#. type: paragraph in src
#: modules/features/emacs/init.org:257
#, no-wrap
