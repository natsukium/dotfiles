#. type: paragraph in src
#: modules/configuration.org:6186
#, no-wrap
msgid ""
"felis-switch = pkgs.writeShellApplication {\n"
"  name = \"felis-switch\";\n"
"  runtimeInputs = [\n"
"    package\n"
"    pkgs.fzf\n"
"    pkgs.jq\n"
"  ];\n"
"  text = ''\n"
"    ${roster}\n"
"    list=$(roster | grep -v -e \"''${FELIS_ORIGIN_SESSION_ID:-none}\" -e "
"\"''${FELIS_SESSION_ID:-none}\" || true)\n"
"    if [ -z \"$list\" ]; then\n"
"      echo \"no sessions\" >&2\n"
"      exit 0\n"
"    fi"
msgstr ""

#. type: cell column 0
#: modules/configuration.org:6207 modules/configuration.org:6243
#, no-wrap
msgid "fzf --ansi \\"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:6205
#, no-wrap
msgid ""
"selection=$(\n"
"  printf '%s\\n' \"$list\" \\\n"
"          --delimiter='\\t' \\\n"
"          --with-nth=2.. \\\n"
"          --prompt='felis session> ' \\\n"
"          --preview='felis sessions capture {1} --ansi' \\\n"
"          --preview-window='right,50%,<80(up,50%)'\n"
") || exit 0"
