"          \"${emacs}/bin/emacs\";\n"
"    in\n"
"    pkgs.writeShellScriptBin \"emacs\" ''\n"
"      dir=\"''${XDG_CACHE_HOME:-$HOME/.cache}/natsukium-emacs\"\n"
