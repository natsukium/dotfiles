#. type: heading ***
#: modules/configuration.org:2203
#, no-wrap
msgid "Scalar"
msgstr ""

#. type: paragraph
#: modules/configuration.org:2205
msgid ""
"[[https://git-scm.com/docs/scalar][Scalar]] optimizes git performance for "
"large repositories. Enabled specifically for the nixpkgs repository, which "
"contains over 600,000 commits and benefits significantly from Scalar's "
"background maintenance (prefetch, commit-graph, loose-objects) and "
"filesystem monitor integration."
msgstr ""

#. type: paragraph
#: modules/configuration.org:2210
msgid ""
"=programs.git.scalar= is a custom option this module extends git with, "
"configuring git's built-in performance optimizations (multipack index, "
"preload index, untracked cache, fsmonitor) whenever a repository is "
"registered. It is a second toggle rather than folded into the base git "
"config unconditionally, since these settings only pay off on the handful of "
"very large repositories that need them."
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:2216
#, no-wrap
msgid "git-scalar-option"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2218
#, no-wrap
msgid ""
"options.programs.git.scalar = {\n"
"  enable = lib.mkEnableOption \"scalar\";"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2221
#, no-wrap
msgid ""
"  repo = lib.mkOption {\n"
"    type = lib.types.listOf lib.types.str;\n"
"    default = [ ];\n"
"    example = [ \"${config.home.homeDirectory}/NixOS/nixpkgs\" ];\n"
"  };\n"
"};"
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:2229
#, no-wrap
msgid "git-scalar"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2231
#, no-wrap
msgid ""
"scalar = {\n"
"  enable = true;\n"
"  repo = [ "
"\"${config.programs.git.settings.ghq.root}/github.com/natsukium/nixpkgs\" "
"];\n"
"};"
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:2237
#, no-wrap
msgid "git-scalar-config"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2239
#, no-wrap
msgid ""
"(lib.mkIf scalarCfg.enable {\n"
"  programs.git = {\n"
"    settings = {\n"
"      scalar.repo = scalarCfg.repo;\n"
"      maintenance.repo = scalarCfg.repo;\n"
"    };\n"
"    includes = map (repo: {\n"
"      condition = \"gitdir:${repo}/\";\n"
"      contents = {\n"
"        core = {\n"
"          multipackindex = true;\n"
"          preloadindex = true;\n"
"          untrackedcache = true;\n"
"          autocrlf = false;\n"
"          safecrlf = false;\n"
"          fsmonitor = true;\n"
"        };\n"
"        am.keepcr = true;\n"
"        credential = {\n"
"          \"https://dev.azure.com\".usehttppath = true;\n"
"          validate = false;\n"
"        };\n"
"        gc.auto = 0;\n"
"        gui.gcwarning = false;\n"
"        index = {\n"
"          threads = true;\n"
"          version = 4;\n"
"        };\n"
"        merge = {\n"
"          stat = false;\n"
"          renames = true;\n"
"        };\n"
"        pack = {\n"
"          usebitmaps = false;\n"
"          usesparse = true;\n"
"        };\n"
"        receive.autogc = false;\n"
"        feature = {\n"
"          manyfiles = false;\n"
"          experimental = false;\n"
"        };\n"
"        fetch = {\n"
"          unpacklimit = 1;\n"
"          writecommitgraph = false;\n"
"          showforcedupdates = false;\n"
"        };\n"
"        status.aheadbehind = false;\n"
"        commitgraph.generationversion = 1;\n"
"        log.excludedecoration = \"refs/prefetch/*\";\n"
"        maintenance = {\n"
"          auto = false;\n"
"          strategy = \"incremental\";\n"
"        };\n"
"      };\n"
"    }) scalarCfg.repo;\n"
"  };\n"
"})"
msgstr ""

#. type: heading ***
#: modules/configuration.org:2298
#, no-wrap
msgid "GitHub CLI"
msgstr ""

#. type: paragraph
#: modules/configuration.org:2300
msgid ""
"[[https://cli.github.com/][gh]] (GitHub CLI) is enabled alongside git "
"because it provides a credential helper "
"([[https://nix-community.github.io/home-manager/options.xhtml#opt-programs.gh.gitCredentialHelper.enable][=programs.gh.gitCredentialHelper.enable=]], "
"on by default) that handles HTTPS authentication for GitHub repositories, "
"for fetch and push alike. So git talks to GitHub over HTTPS only, and an SSH "
"key is never needed to move commits — signing is the one thing SSH is still "
"used for."
msgstr ""

#. type: paragraph
#: modules/configuration.org:2306
msgid ""
"I used to rewrite push URLs to SSH with "
"=url.\"git@github.com:\".pushInsteadOf=, on the theory that it was a "
"harmless fallback for machines without =gh=. It was not harmless: URL "
"rewriting happens before the credential helper is ever consulted, so pushes "
"really did go over SSH, and the fallback could never fire anyway because the "
"rewrite is tangled from the same module that installs =gh=. Since the work "
"account needs pushes to authenticate as the right GitHub user, one auth path "
"is easier to reason about than two, and I dropped the rewrite. The work host "
"narrows the same helper to a second =gh= config directory for repositories "
"under its own root."
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:2315
#, no-wrap
msgid "git-gh"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2317
#, no-wrap
msgid "programs.gh.enable = true;"
msgstr ""

#. type: heading ***
#: modules/configuration.org:2320
#, no-wrap
msgid "Delta"
msgstr ""

#. type: paragraph
#: modules/configuration.org:2322
msgid ""
"[[https://github.com/dandavison/delta][delta]] provides syntax-highlighted "
"diffs in the terminal with line numbers and side-by-side view "
"support. Chosen for its clean visual presentation."
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:2325
#, no-wrap
msgid "git-delta"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2327
#, no-wrap
msgid ""
"programs.delta = {\n"
"  enable = true;\n"
"  enableGitIntegration = true;\n"
"};"
msgstr ""

#. type: heading ***
#: modules/configuration.org:2333
#, no-wrap
msgid "Difftastic"
msgstr ""

#. type: paragraph
#: modules/configuration.org:2335
msgid ""
"[[https://github.com/Wilfred/difftastic][Difftastic]] is a structural diff "
"tool that operates at the AST level rather than comparing lines. It "
"understands that moving a function or renaming a variable is a single "
"semantic change, not a block of deletions and insertions. This is "
"particularly valuable for JSX refactoring, indentation shifts, and nested "
"tag restructuring, where line-based diffs produce noisy, hard-to-read "
"output."
msgstr ""

#. type: paragraph
#: modules/configuration.org:2341
msgid ""
"Both difftastic and [[*Delta][delta]] are kept because they serve "
"complementary roles: delta enhances git's built-in line diffs with syntax "
"highlighting for everyday operations (=git diff=, =git log=), while "
"difftastic is reached for via [[*Lazygit][lazygit]] when structural "
"understanding matters."
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:2346
#, no-wrap
msgid "git-difftastic"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2348
#, no-wrap
msgid ""
"programs.difftastic = {\n"
"  enable = true;\n"
"};"
msgstr ""

#. type: heading ***
#: modules/configuration.org:2353
#, no-wrap
msgid "Lazygit"
msgstr ""

#. type: paragraph
#: modules/configuration.org:2355
msgid ""
"[[https://github.com/jesseduffield/lazygit][Lazygit]] is a terminal UI for "
"git. A TUI was chosen over raw git commands for interactive operations like "
"staging individual hunks, interactive rebase, and conflict resolution, where "
"the visual feedback loop significantly reduces errors. Previously used "
"gitui, but switched to lazygit for its broader feature set. gitui's "
"performance advantage did not materialize in practice, and it lacked several "
"workflow-critical operations."
msgstr ""

#. type: paragraph
#: modules/configuration.org:2361
msgid ""
"Performance degrades noticeably on large repositories like nixpkgs, but the "
"ergonomics and active development make it a trusted part of the workflow "
"despite this tradeoff."
msgstr ""

#. type: paragraph
#: modules/configuration.org:2364
msgid ""
"Lazygit is a front end for the [[*Git][git]] configuration above and has no "
"meaning without it, so it rides =my.programs.git.enable= rather than "
"carrying a toggle of its own."
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2373
#, no-wrap
msgid ""
"{ self, ... }:\n"
"{\n"
"  flake.modules.homeManager.lazygit =\n"
"    { config, lib, ... }:\n"
"    {\n"
"      config = lib.mkIf config.my.programs.git.enable {\n"
"        programs.lazygit = {\n"
"          enable = true;\n"
"          settings = {\n"
"            <<lazygit-gui>>"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2384
#, no-wrap
msgid ""
"        <<lazygit-git>>\n"
"      };\n"
"    };\n"
"  };\n"
"};"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2390
#, no-wrap
msgid ""
"  <<lazygit-check>>\n"
"}"
msgstr ""

#. type: heading ****
#: modules/configuration.org:2394
#, no-wrap
msgid "GUI"
msgstr ""

#. type: paragraph
#: modules/configuration.org:2396
msgid "Enable Nerd Font icons in the lazygit interface for visual clarity."
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:2398
#, no-wrap
msgid "lazygit-gui"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2400
#, no-wrap
msgid ""
"gui = {\n"
"  showIcons = true;\n"
"};"
msgstr ""

#. type: heading ****
#: modules/configuration.org:2405
#, no-wrap
msgid "Git Integration"
msgstr ""

#. type: paragraph
#: modules/configuration.org:2407
msgid ""
"=overrideGpg = true= tells lazygit to run git commands inline instead of "
"spawning a subprocess for GPG/SSH signing. By default, lazygit defers to a "
"subprocess so the user can type a passphrase interactively. However, this "
"subprocess mode prevents lazygit from orchestrating interactive rebase "
"internally. Rewording, reordering, or editing any commit other than HEAD is "
"[[https://github.com/jesseduffield/lazygit/issues/1146][disabled entirely]] "
"because the rebase would trigger multiple signing prompts that lazygit "
"cannot handle mid-rebase. With =overrideGpg = true=, lazygit assumes the "
"signing agent (ssh-agent, macOS Keychain) caches the passphrase, so no "
"interactive prompt is needed and all rebase operations work normally."
msgstr ""

#. type: paragraph
#: modules/configuration.org:2416
msgid ""
"=diffRenderers= registers both [[*Delta][delta]] and "
"[[*Difftastic][difftastic]] as diff views, cycled with =|=.  Delta "
"post-processes git's own line diff (=--paging=never= because lazygit pages "
"the output itself), while difftastic replaces diff generation entirely, so "
"it is an =extDiff= entry rather than a filter."
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:2421
#, no-wrap
msgid "lazygit-git"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2423
#, no-wrap
msgid ""
"git = {\n"
"  overrideGpg = true;\n"
"  diffRenderers = [\n"
"    { command = \"delta --dark --paging=never\"; }\n"
"    {\n"
"      type = \"extDiff\";\n"
"      command = \"difft --color=always\";\n"
"    }\n"
"  ];\n"
"};"
msgstr ""

#. type: heading ****
#: modules/configuration.org:2435
#, no-wrap
msgid "Schema Check"
msgstr ""

#. type: paragraph
#: modules/configuration.org:2437
msgid ""
"=settings= is free-form YAML, so a key lazygit no longer accepts passes "
"evaluation untouched. Lazygit then refuses to start, because it migrates "
"renamed keys by rewriting the config file and the store copy is read-only."
msgstr ""

#. type: paragraph
#: modules/configuration.org:2441
msgid ""
"The schema ships in lazygit's own source, so the check reads it from the "
"package the host installs. A version bump that renames a key fails the build "
"rather than the next launch."
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:2445
#, no-wrap
msgid "lazygit-check"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2447
#, no-wrap
msgid ""
"perSystem =\n"
"  { pkgs, ... }:\n"
"  let\n"
"    inherit (pkgs) lib;"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2452
#, no-wrap
msgid ""
"onThisSystem = lib.filterAttrs (\n"
"  _: host: host.pkgs.stdenv.hostPlatform.system == "
"pkgs.stdenv.hostPlatform.system\n"
") (self.nixosConfigurations // self.darwinConfigurations);"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2458
#, no-wrap
msgid ""
"configsOf =\n"
"  user:\n"
"  lib.mapAttrsToList (_: file: {\n"
"    inherit (file) source;\n"
"    schema = \"${user.programs.lazygit.package.src}/schema/config.json\";\n"
"  }) (lib.filterAttrs (name: _: lib.hasSuffix \"lazygit/config.yml\" name) "
"user.home.file);"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2465
#, no-wrap
msgid ""
"  configs = lib.unique (\n"
"    lib.concatMap (host: lib.concatMap configsOf (lib.attrValues "
"host.config.home-manager.users)) (\n"
"      lib.attrValues onThisSystem\n"
"    )\n"
"  );\n"
"in\n"
"{\n"
"  checks = lib.optionalAttrs (configs != [ ]) {\n"
"    lazygit-config =\n"
"      pkgs.runCommand \"lazygit-config-check\" { nativeBuildInputs = [ "
"pkgs.check-jsonschema ]; }\n"
"        ''\n"
"          ${lib.concatMapStringsSep \"\\n\" (\n"
"            config: \"check-jsonschema --force-filetype yaml --schemafile "
"${config.schema} ${config.source}\"\n"
"          ) configs}\n"
"          touch $out\n"
"        '';\n"
"  };\n"
"};"
msgstr ""

#. type: heading ***
#: modules/configuration.org:2486
#, no-wrap
msgid "Fish Abbreviations"
msgstr ""

#. type: paragraph
#: modules/configuration.org:2488
msgid ""
"Shell abbreviations for frequent git operations. Abbreviations (not aliases) "
"are used because fish expands them inline before execution, making the "
"actual command visible in history and allowing modification before running."
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:2492
#, no-wrap
msgid "git-fish-abbreviations"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2494
#, no-wrap
msgid ""
"programs.fish.shellAbbrs = {\n"
"  <<git-abbr-push>>\n"
"  <<git-abbr-pull>>\n"
"  <<git-abbr-commit>>\n"
"  <<git-abbr-status>>\n"
"  <<git-abbr-stash>>\n"
"  <<git-abbr-switch>>\n"
"  <<git-abbr-ghq>>\n"
"};"
msgstr ""

#. type: heading ****
#: modules/configuration.org:2505
#, no-wrap
msgid "Push"
msgstr ""

#. type: paragraph
#: modules/configuration.org:2507
msgid ""
"Force push with lease — safer than =--force= as it prevents overwriting "
"remote changes not yet fetched."
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:2510
#, no-wrap
msgid "git-abbr-push"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2512
#, no-wrap
msgid "gpf = \"git push --force-with-lease\";"
msgstr ""

#. type: heading ****
#: modules/configuration.org:2515
#, no-wrap
msgid "Pull"
msgstr ""

#. type: paragraph
#: modules/configuration.org:2517
msgid ""
"=gpm= pulls from the remote's default branch, dynamically detected via =git "
"remote show= rather than hardcoding =main= or =master=. This handles "
"repositories that still use =master= or other branch naming conventions."
msgstr ""

#. type: paragraph
#: modules/configuration.org:2521
msgid ""
"=gpu= pulls from upstream — used in fork workflows to sync with the original "
"repository."
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:2523
#, no-wrap
msgid "git-abbr-pull"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2525
#, no-wrap
msgid ""
"gpm = \"git pull (git remote show origin | sed -n '/HEAD branch/s/.*: "
"//p')\";\n"
"gpu = \"git pull upstream\";"
msgstr ""

#. type: heading ****
#: modules/configuration.org:2529
#, no-wrap
msgid "Commit"
msgstr ""

#. type: paragraph
#: modules/configuration.org:2531
msgid ""
"=gci= creates a commit. The trailing space allows directly appending =-m "
"\"message\"=."
msgstr ""

#. type: paragraph
#: modules/configuration.org:2533
msgid ""
"=gca= amends the last commit, frequently used during interactive rebase "
"workflows."
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:2535
#, no-wrap
msgid "git-abbr-commit"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2537
#, no-wrap
msgid ""
"gci = \"git commit \";\n"
"gca = \"git commit --amend\";"
msgstr ""

#. type: heading ****
#: modules/configuration.org:2541
#, no-wrap
msgid "Status"
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:2543
#, no-wrap
msgid "git-abbr-status"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2545
#, no-wrap
msgid "gs = \"git status\";"
msgstr ""

#. type: heading ****
#: modules/configuration.org:2548
#, no-wrap
msgid "Stash"
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:2550
#, no-wrap
msgid "git-abbr-stash"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2552
#, no-wrap
msgid ""
"gst = \"git stash\";\n"
"gstp = \"git stash pop\";"
msgstr ""

#. type: heading ****
#: modules/configuration.org:2556
#, no-wrap
msgid "Switch"
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:2558
#, no-wrap
msgid "git-abbr-switch"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2560
#, no-wrap
msgid ""
"gsw = \"git switch\";\n"
"gswc = \"git switch -c\";"
msgstr ""

#. type: heading ****
#: modules/configuration.org:2564
#, no-wrap
msgid "ghq"
msgstr ""

#. type: paragraph
#: modules/configuration.org:2566
msgid ""
"A fresh =ghq get= clone is invisible to =z= until I cd into it once. Piping "
"the path that =ghq get= prints on stdout since 1.10.0 into =zoxide add= "
"registers it right away."
msgstr ""

#. type: paragraph
#: modules/configuration.org:2569
msgid ""
"I use an abbreviation rather than a function wrapping =ghq= so the pipe "
"stays visible and I can delete it when I need =ghq get --look=, whose nested "
"shell the pipe would swallow."
msgstr ""

#. type: paragraph
#: modules/configuration.org:2573
msgid ""
"=xargs -I{}= keeps a path with spaces whole and runs nothing when a failed "
"clone leaves stdout empty."
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:2576
#, no-wrap
msgid "git-abbr-ghq"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2578
#, no-wrap
msgid ""
"ghq-get = {\n"
"  command = \"ghq\";\n"
"  regex = \"get\";\n"
"  setCursor = true;\n"
"  expansion = \"get % | xargs -I{} zoxide add {}\";\n"
"};"
msgstr ""

#. type: heading **
#: modules/configuration.org:2586
#, no-wrap
msgid "Jujutsu"
msgstr ""

#. type: paragraph
#: modules/configuration.org:2588
msgid ""
"I am moving my data analysis work to "
"[[https://jj-vcs.github.io/jj/][Jujutsu]], where the history has a shape git "
"does not expect. Analysis is a long run of small experiments and most of "
"them are abandoned, so git records only the states I remembered to "
"commit. jj snapshots the working copy on every command, which means the "
"state I had twenty minutes ago is still in the operation log whether or not "
"I judged it worth keeping at the time. Rearranging the survivors into a "
"sequence someone can read is then =jj squash= and =jj rebase=, instead of an "
"interactive rebase I would have had to plan for while still exploring."
msgstr ""

#. type: paragraph
#: modules/configuration.org:2597
msgid ""
"jj keeps its commits in a git repository and colocates with =.git= by "
"default, so the git tooling in the [[*Git][Git]] section keeps working "
"inside a jj repo. The two are registered as separate features because jj is "
"not a replacement here: git remains what I use everywhere else."
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2608
#, no-wrap
msgid ""
"{ ... }:\n"
"{\n"
"  flake.modules.homeManager.jujutsu =\n"
"    {\n"
"      config,\n"
"      lib,\n"
"      pkgs,\n"
"      ...\n"
"    }:\n"
"    let\n"
"      cfg = config.my.programs.jujutsu;\n"
"      gitCfg = config.programs.git;\n"
"    in\n"
"    {\n"
"      options.my.programs.jujutsu.enable = lib.mkEnableOption \"jujutsu\";"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2624
#, no-wrap
msgid ""
"config = lib.mkIf cfg.enable {\n"
"  <<jj-git-assertion>>"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2627
#, no-wrap
msgid ""
"programs.jujutsu = {\n"
"  enable = true;"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2630
#, no-wrap
msgid ""
"settings = {\n"
"  <<jj-user-identity>>"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2633
#, no-wrap
msgid "<<jj-signing>>"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2635
#, no-wrap
msgid "<<jj-ui>>"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2637
#, no-wrap
msgid ""
"            <<jj-snapshot>>\n"
"          };\n"
"        };\n"
"      };\n"
"    };\n"
"}"
msgstr ""

#. type: heading ***
#: modules/configuration.org:2645
#, no-wrap
msgid "Shared Settings With Git"
msgstr ""

#. type: paragraph
#: modules/configuration.org:2647
msgid ""
"jj reads none of git's configuration, so identity, signing, and editor would "
"have to be written twice. Everything that is literally the same value is "
"read back out of the [[*Git][Git]] feature instead, which means a key "
"rotation or a change of address is one edit rather than two that can fall "
"out of step."
msgstr ""

#. type: paragraph
#: modules/configuration.org:2652
msgid ""
"That makes jujutsu depend on git being enabled. Without the assertion the "
"failure would be a missing-attribute error pointing into the module system, "
"which says nothing about the actual cause."
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:2656
#, no-wrap
msgid "jj-git-assertion"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2658
#, no-wrap
msgid ""
"assertions = [\n"
"  {\n"
"    assertion = config.my.programs.git.enable;\n"
"    message = \"my.programs.jujutsu reuses git's identity, signing key and "
"editor; enable my.programs.git too.\";\n"
"  }\n"
"];"
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:2668
#, no-wrap
msgid "jj-user-identity"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2670
#, no-wrap
msgid ""
"user = {\n"
"  inherit (gitCfg.settings.user) name email;\n"
"};"
msgstr ""

#. type: paragraph
#: modules/configuration.org:2677
msgid ""
"The key is git's, and so is the decision to sign at all: =signByDefault= "
"becomes jj's =own=, which signs the commits I author. Mapping git's =format= "
"onto jj's =backend= covers the case where I move off ssh keys, since the two "
"spell the same three backends differently."
msgstr ""

#. type: paragraph
#: modules/configuration.org:2682
msgid ""
"jj rewrites the working-copy commit on every snapshot, which calls the "
"signing program far more often than git's per-commit signing does. I "
"measured the difference at a few milliseconds per command, below the cost of "
"the snapshot itself, so the frequency is not a reason to weaken this to "
"=keep=."
msgstr ""

#. type: paragraph
#: modules/configuration.org:2687
msgid ""
"Signature status shows as unknown in =jj log= because I keep no "
"allowed-signers file. That only affects local verification; GitHub and "
"Forgejo check the signature against the key registered on my account."
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:2691
#, no-wrap
msgid "jj-signing"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2693
#, no-wrap
msgid ""
"signing = {\n"
"  backend =\n"
"    {\n"
"      openpgp = \"gpg\";\n"
"      ssh = \"ssh\";\n"
"      x509 = \"gpgsm\";\n"
"    }\n"
"    .${gitCfg.signing.format};\n"
"  behavior = if gitCfg.signing.signByDefault then \"own\" else \"keep\";\n"
"  key = gitCfg.signing.key;\n"
"};"
msgstr ""

#. type: paragraph
#: modules/configuration.org:2708
msgid ""
"A bare =jj= already falls back to =jj log=, but prints a hint naming this "
"setting on every run until it is set. Setting it buys nothing except "
"silence, which is reason enough."
msgstr ""

#. type: paragraph
#: modules/configuration.org:2712
msgid ""
"The editor is git's, set there because [[*Editor][some contexts do not "
"inherit the session environment]]; jj falls back the same way and deserves "
"the same answer."
msgstr ""

#. type: paragraph
#: modules/configuration.org:2715
msgid ""
"difftastic replaces the built-in colour-words diff. jj invokes a diff "
"formatter on the two file versions directly, which is the interface "
"difftastic wants, so no wrapper is needed. delta stays git-only because it "
"reads a unified diff rather than a pair of files."
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:2720
#, no-wrap
msgid "jj-ui"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2722
#, no-wrap
msgid ""
"ui = {\n"
"  default-command = [ \"log\" ];\n"
"  editor = gitCfg.settings.core.editor;\n"
"  diff-formatter = [\n"
"    (lib.getExe pkgs.difftastic)\n"
"    \"--color=always\"\n"
"    \"$left\"\n"
"    \"$right\"\n"
"  ];\n"
"};"
msgstr ""

#. type: heading ***
#: modules/configuration.org:2734
#, no-wrap
msgid "Snapshot Size Limit"
msgstr ""

#. type: paragraph
#: modules/configuration.org:2736
msgid ""
"Automatic snapshotting is what makes jj worth using for analysis, and it is "
"also the thing that would put a parquet file into the store the moment I "
"dropped one next to the notebook. jj has no equivalent of git-lfs, so the "
"store would simply grow. =max-new-file-size= is the guard: a new file larger "
"than the limit is not tracked at all."
msgstr ""

#. type: paragraph
#: modules/configuration.org:2742
msgid ""
"The value below is jj's own default, written out because it carries the rule "
"that data lives outside the repository. Without that rule the automatic "
"snapshot turns from the reason I chose jj into the reason I would have to "
"abandon it."
msgstr ""

#. type: paragraph
#: modules/configuration.org:2746
msgid ""
"One catch is worth knowing before it bites. jj 0.44 skips an oversized file "
"in silence: nothing is printed, and =jj status= does not list the file as "
"untracked, so a file I assumed was committed can turn out not to be. When "
"that happens the fix is to move the data out of the tree, not to raise the "
"limit."
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:2751
#, no-wrap
msgid "jj-snapshot"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2753
#, no-wrap
msgid "snapshot.max-new-file-size = \"1MiB\";"
msgstr ""

#. type: heading **
#: modules/configuration.org:2756
#, no-wrap
msgid "Forgejo"
msgstr ""

#. type: paragraph
#: modules/configuration.org:2758
msgid ""
"I self-host [[https://forgejo.org/][Forgejo]] on manyara as my personal "
"forge at =git.natsukium.com=. This feature carries the NixOS module that "
"runs the instance and the home-manager module that routes git's ssh traffic "
"to it."
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2768
#, no-wrap
msgid ""
"{ ... }:\n"
"{\n"
"  <<forgejo-instance>>"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2772
#, no-wrap
msgid ""
"  <<forgejo-client>>\n"
"}"
msgstr ""

#. type: heading ***
#: modules/configuration.org:2776
#, no-wrap
msgid "Instance"
msgstr ""

#. type: paragraph
#: modules/configuration.org:2778
msgid ""
"Registration is closed since I am the only human user. Forgejo has no "
"declarative way to define users, so my admin account and the renovate bot's "
"are created at service start instead. Stars and forks are off for the same "
"reason: both are social features, and with no second account they leave "
"nothing but a button and a counter that never move."
msgstr ""

#. type: paragraph
#: modules/configuration.org:2784
msgid ""
"New repositories start out with the two settings I would otherwise pick by "
"hand: squash merges, and rebase when a pull request branch needs "
"updating. Deleting the branch after a merge is the third habit, but Forgejo "
"has no instance-level default for it, so I still tick that box per "
"repository."
msgstr ""

#. type: keyword NAME
#: modules/configuration.org:2789
#, no-wrap
msgid "forgejo-instance"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2791
#, no-wrap
msgid ""
"flake.modules.nixos.forgejo =\n"
"  {\n"
"    config,\n"
"    lib,\n"
"    pkgs,\n"
"    ...\n"
"  }:\n"
"  let\n"
"    cfg = config.my.services.forgejo;\n"
"  in\n"
"  {\n"
"    options.my.services.forgejo.enable = lib.mkEnableOption \"my forgejo "
"instance\";"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2804
#, no-wrap
msgid ""
"config = lib.mkIf cfg.enable {\n"
"  services.forgejo = {\n"
"    enable = true;\n"
"    package = pkgs.forgejo;\n"
"    database.type = \"postgres\";\n"
"    settings = {\n"
"      service.DISABLE_REGISTRATION = true;\n"
"      repository = {\n"
"        DISABLE_STARS = true;\n"
"        DISABLE_FORKS = true;\n"
"      };\n"
"      \"repository.pull-request\" = {\n"
"        DEFAULT_MERGE_STYLE = \"squash\";\n"
"        DEFAULT_UPDATE_STYLE = \"rebase\";\n"
"      };\n"
"      server = {\n"
"        HTTP_PORT = 3010;\n"
"        DOMAIN = \"git.natsukium.com\";\n"
"        ROOT_URL = \"https://git.natsukium.com/\";\n"
"      };\n"
"      actions = {\n"
"        ENABLED = true;\n"
"        DEFAULT_ACTIONS_URL = \"github\";\n"
"      };\n"
"    };\n"
"  };"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2831
#, no-wrap
msgid ""
"systemd.services.forgejo.preStart = ''\n"
"  ${lib.getExe config.services.forgejo.package} admin user create \\\n"
"    --username natsukium \\\n"
"    --email \"tomoya.otabi@gmail.com\" \\\n"
"    --password \"$(tr -d '\\n' < "
"${config.sops.secrets.forgejo-admin-password.path})\" \\\n"
"    --admin || true"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2838
#, no-wrap
msgid ""
"  ${lib.getExe config.services.forgejo.package} admin user create \\\n"
"    --username renovate \\\n"
"    --email \"renovate@natsukium.com\" \\\n"
"    --password \"$(tr -d '\\n' < "
"${config.sops.secrets.forgejo-renovate-password.path})\" \\\n"
"    --must-change-password=false || true\n"
"'';"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2845
#, no-wrap
msgid ""
"sops.secrets.forgejo-admin-password = {\n"
"  sopsFile = ./secrets.yaml;\n"
"  owner = \"forgejo\";\n"
"};"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2850
#, no-wrap
msgid ""
"sops.secrets.forgejo-renovate-password = {\n"
"  sopsFile = ./secrets.yaml;\n"
"  owner = \"forgejo\";\n"
"};"
msgstr ""

#. type: paragraph in src
#: modules/configuration.org:2855
#, no-wrap
msgid ""
"my.services.cloudflared-tunnel.ingress.${config.services.forgejo.settings.server.DOMAIN} "
"=\n"
"  let\n"
"    inherit (config.services.forgejo.settings.server) HTTP_ADDR HTTP_PORT;\n"
